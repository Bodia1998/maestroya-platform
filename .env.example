# Copy this file to .env.local for local development.
# All variables are validated at startup — see src/core/infrastructure/config/env.ts
# The app will fail fast with a clear error if a required variable is missing or malformed.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maestroya?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Add OAuth provider credentials here once providers are chosen, e.g.:
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Stripe Connect ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Client ID for Stripe Connect OAuth onboarding of providers
STRIPE_CONNECT_CLIENT_ID=""

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
