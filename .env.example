# Copy this file to .env.local for local development.
# All variables are validated at startup — see src/core/infrastructure/config/env.ts
# The app will fail fast with a clear error if a required variable is missing or malformed.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Observability ---
# debug | info | warn | error. Defaults to "info".
LOG_LEVEL="info"

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maestroya?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
# Must be at least 32 characters in production (enforced at startup).
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Required when self-hosting behind a reverse proxy (Docker, any non-Vercel
# host). Defaults to "true". See docs/MODULE_25_PRODUCTION_INFRASTRUCTURE.md.
AUTH_TRUST_HOST="true"

# --- OAuth providers (Google, Apple, Facebook) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# --- Stripe Connect ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Client ID for Stripe Connect OAuth onboarding of providers
STRIPE_CONNECT_CLIENT_ID=""

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Distributed rate limiting (optional) ---
# Not required today — the only wired-up RateLimitRepository is in-memory
# (single-instance deployment). Reserved for a future Redis-backed
# implementation; see docs/MODULE_25_PRODUCTION_INFRASTRUCTURE.md.
REDIS_URL=""
