# Copy this file to .env.local for local development.
# All variables are validated at startup — see src/core/infrastructure/config/env.ts
# The app will fail fast with a clear error if a required variable is missing or malformed.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Observability ---
# debug | info | warn | error. Defaults to "info".
LOG_LEVEL="info"

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maestroya?schema=public"

# --- Email (Resend) ---
# Used to send real verification/password-reset emails (RegisterUserUseCase,
# RequestPasswordResetUseCase). Get an API key at https://resend.com.
RESEND_API_KEY=""
EMAIL_FROM="MaestroYa <noreply@maestroya.es>"

# --- Auth.js ---
# Generate with: npx auth secret
# Must be at least 32 characters in production (enforced at startup).
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Required when self-hosting behind a reverse proxy (Docker, any non-Vercel
# host). Defaults to "true". See docs/MODULE_25_PRODUCTION_INFRASTRUCTURE.md.
AUTH_TRUST_HOST="true"

# --- OAuth providers (Google, Apple, Facebook) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# --- Stripe Connect ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Client ID for Stripe Connect OAuth onboarding of providers
STRIPE_CONNECT_CLIENT_ID=""

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Redis (optional — Module 44: Redis Infrastructure) ---
# Not required — every Redis-backed service (cache, rate limiting,
# distributed locking) falls back to a correct in-memory implementation
# when this is unset. Set to enable a shared, multi-instance-safe backend.
# Accepts redis:// and rediss:// (TLS). See
# docs/MODULE_44_REDIS_INFRASTRUCTURE.md.
REDIS_URL=""

# --- Caching layer (Module 46 — Caching Layer) ---
# Root prefix every cache key is built with (CacheKeyBuilder). Optional;
# defaults to "cache" when unset. Useful for sharing one Redis
# instance/DB safely across multiple environments/apps.
CACHE_KEY_PREFIX=""
# Debugging/testing switch: "true" makes every cache read a forced miss
# (results are still written, keeping the cache warm). Defaults to
# "false" everywhere, including production. See
# docs/MODULE_46_CACHING_LAYER.md.
CACHE_BYPASS_ENABLED=""

# --- Geocoding provider (Spain Location Services) ---
# Selects the GeocodingProvider createGeocodingProvider() constructs.
# One of: STATIC | MAPBOX | GOOGLE | HERE | OSM. Defaults to STATIC (the
# network-free StaticCityGeocodingProvider) when unset, empty, or set to
# anything else invalid — this is a hard safety guarantee, not just a
# convenience default: no outbound geocoding HTTP request can ever happen
# by accident. Selecting MAPBOX/GOOGLE/HERE without the matching API key
# below still starts the app safely — it logs a warning and falls back to
# STATIC. OSM (OpenStreetMap/Nominatim) needs no key at all.
GEOCODING_PROVIDER="STATIC"
MAPBOX_API_KEY=""
GOOGLE_GEOCODING_API_KEY=""
HERE_API_KEY=""

# --- Workflow expiration cron (Module 28 — Workflow Completion) ---
# Shared-secret bearer token required on the
# /api/cron/expire-workflows Authorization header. Generate with e.g.
# `openssl rand -base64 32`. Must also be set in Vercel's project
# environment variables — Vercel Cron automatically sends it as
# `Authorization: Bearer $CRON_SECRET` for the schedule configured in
# vercel.json. Leave unset in local dev; the route responds 503 without it
# rather than skipping the check.
CRON_SECRET=""

# --- Error reporting / Sentry (Module 39 — Sentry + CI/CD Hardening) ---
# Server-side DSN. Required in production — env.ts fails startup fast if
# NODE_ENV=production and this is unset. Optional everywhere else: leave
# unset in local development and Sentry stays fully inactive (every
# ErrorReporter/FailureReporter call falls back to the structured
# console logger — see docs/MODULE_39_SENTRY_CI_CD_HARDENING.md).
SENTRY_DSN=""
# Browser-side DSN, read by src/app/error.tsx. Must be a NEXT_PUBLIC_*
# variable (inlined into the client bundle at build time) — never reuse
# SENTRY_DSN here. Optional; a missing value just means browser-side
# exceptions aren't reported while server-side reporting is unaffected.
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry's own "environment" tag. Defaults to NODE_ENV when unset — set
# this explicitly if a deployment's NODE_ENV and its real environment
# name should differ (e.g. a staging deploy that must run with
# NODE_ENV=production).
SENTRY_ENVIRONMENT=""
# Fraction (0-1) of transactions sampled for Sentry performance tracing.
# Defaults to 0 (errors only, no tracing) when unset.
SENTRY_TRACES_SAMPLE_RATE=""

# --- SMS (Module 49 — SMS Notifications) ---
# Selects the SmsSender createSmsSender() constructs. One of: mock | twilio.
# Defaults to "mock" when unset, empty, or set to anything else invalid —
# the same hard safety guarantee GEOCODING_PROVIDER documents: no outbound
# SMS can ever be sent by accident. MockSmsSender stores messages in memory
# only. Set to "twilio" plus the three credentials below to send real SMS
# via Twilio's REST API. Required (enforced at startup) when
# SMS_PROVIDER=twilio in production.
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Real-Time System (Module 48) ---
# How often (ms) the SSE transport sends a heartbeat keep-alive to each
# connected stream. Defaults to 25000 (25s) when unset/invalid.
REALTIME_HEARTBEAT_INTERVAL_MS=""
# How long (ms) a connection may go without a heartbeat before it is
# evicted. Defaults to 90000 (90s) when unset/invalid.
REALTIME_CONNECTION_TTL_MS=""
# Reports whether the separate WebSocket gateway process
# (`npm run realtime:gateway`) is expected to be running in this
# deployment — visibility only, in /api/health/ready. Defaults to "false".
REALTIME_WS_ENABLED=""
# Port the standalone WebSocket gateway listens on. Defaults to 3001.
REALTIME_WS_PORT=""
# Max concurrent realtime connections (devices/tabs) per user. Defaults to 10.
REALTIME_MAX_CONNECTIONS_PER_USER=""

# --- Distributed Tracing (Module 51) ---
# Master switch — **opt-in**, unlike SEARCH_INDEXING_ENABLED/
# ANALYTICS_REFRESH_ENABLED, which are opt-out. Set to "true" to enable
# OpenTelemetry tracing. Left unset/"false" (the default), the OpenTelemetry
# SDK is never even imported, every instrumentation point returns the
# undecorated object it wraps, and there is effectively zero runtime
# overhead — see docs/MODULE_51_DISTRIBUTED_TRACING.md §7.
TRACING_ENABLED=""
# Where finished spans go. One of: console | otlp | none.
#   console — stdout via ConsoleSpanExporter; the local-development
#             default, needs no collector or account.
#   otlp    — OTLP/HTTP to OTEL_EXPORTER_OTLP_ENDPOINT (Tempo, Jaeger,
#             Honeycomb, Datadog, Sentry — all speak it).
#   none    — spans are created and propagated (logs still correlate,
#             downstream services still join the trace) but never exported.
# Defaults to "console" when unset, empty, or invalid — a typo in a
# swappable-backend selector must degrade to the safe local option, never
# fail startup, exactly as SEARCH_PROVIDER/SMS_PROVIDER/GEOCODING_PROVIDER do.
# Only consulted at all when TRACING_ENABLED="true".
TRACING_EXPORTER=""
# `service.name` on every exported span — how this application appears in
# the collector's service map. Defaults to "maestroya-platform".
OTEL_SERVICE_NAME=""
# OTLP/HTTP traces endpoint, e.g. "http://localhost:4318/v1/traces".
# Optional in every environment — but required (enforced at startup) when
# NODE_ENV=production *and* TRACING_ENABLED=true *and* TRACING_EXPORTER=otlp,
# so a production deployment that deliberately selected OTLP can never
# silently export nothing. Outside production, selecting otlp without it
# degrades to the "none" exporter rather than constructing an exporter that
# would fail every flush.
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Comma-separated key=value pairs sent as headers on every OTLP request —
# the collector's auth token, a tenant id, etc. The OpenTelemetry
# specification's own OTEL_EXPORTER_OTLP_HEADERS grammar, e.g.
# "x-api-key=abc,x-tenant=maestroya". Parsed leniently: a malformed pair is
# skipped, never fatal.
OTEL_EXPORTER_HEADERS=""

# --- Feature Flags module ---
# Process-wide emergency kill switch. "false" forces every feature flag to
# evaluate as disabled, regardless of its own configuration — the single
# "turn everything off" lever for an incident. Defaults to "true" (normal
# operation) when unset, empty, or invalid.
FEATURE_FLAGS_ENABLED=""
# Optional JSON array of flag definitions, merged (by key) on top of the
# code-defined defaults in
# src/core/infrastructure/feature-flags/feature-flag-definitions.ts. e.g.:
#   [{"key":"new-dashboard-ui","enabled":true,"rollout":{"percentage":25}}]
# Invalid JSON is logged and ignored (falls back to the code defaults),
# never a startup failure. See docs/MODULE_52_FEATURE_FLAGS.md.
FEATURE_FLAGS_CONFIG=""

# --- Module 54 — Backup & Disaster Recovery ---
# Opt-in, like TRACING_ENABLED. "false" (default) runs the app with zero
# backup/recovery machinery — correct when a managed Postgres provider
# already runs its own snapshots. Set "true" for a self-hosted deployment
# (see docker-compose.prod.yml).
BACKUP_ENABLED="false"
# Filesystem directory backup artifacts are written to. Must be a durable,
# writable path outside the container's ephemeral layer (a mounted volume)
# in a real deployment.
BACKUP_STORAGE_DIR="/var/backups/maestroya"
# How many days a backup remains a valid restore candidate before
# retention enforcement expires it.
BACKUP_RETENTION_DAYS="30"
# Floor on how many successful backups per target are always kept
# regardless of age.
BACKUP_MIN_RETAINED_BACKUPS="3"
# How often a FULL backup is required before an INCREMENTAL is allowed.
BACKUP_FULL_INTERVAL_DAYS="7"
# Scheduled backup cadence, a standard 5-field cron expression (UTC).
BACKUP_SCHEDULE_CRON="0 2 * * *"

# --- Module 55 — Read Replicas ---
# Opt-in, like TRACING_ENABLED/BACKUP_ENABLED. "false" (default) reads and
# writes through DATABASE_URL alone — every existing environment's behavior
# is unchanged. Set "true" only once DATABASE_REPLICA_URLS is populated.
READ_REPLICAS_ENABLED="false"
# Comma-separated Postgres connection strings, one per read replica, e.g.
# "postgresql://user:pass@replica-1:5432/db,postgresql://user:pass@replica-2:5432/db".
# Required in production when READ_REPLICAS_ENABLED="true".
DATABASE_REPLICA_URLS=""
# Which ReplicaSelector picks the replica for an eligible read:
# ROUND_ROBIN (default, fair rotation), RANDOM, or LEAST_LAG (routes to the
# replica with the lowest known replication lag).
READ_REPLICA_SELECTION_STRATEGY="ROUND_ROBIN"
# The default read-consistency level for a read that does not explicitly
# request otherwise (see infrastructure/database/read-consistency-context.ts):
# STRONG (always the primary), EVENTUAL (default — any healthy replica,
# regardless of lag), or BOUNDED_STALENESS (a replica only if its lag is
# within READ_REPLICA_MAX_STALENESS_MS).
READ_REPLICA_DEFAULT_CONSISTENCY="EVENTUAL"
# Only meaningful with READ_REPLICA_DEFAULT_CONSISTENCY=BOUNDED_STALENESS —
# the maximum replication lag, in milliseconds, a replica may report and
# still be an acceptable read source.
READ_REPLICA_MAX_STALENESS_MS="5000"
# A replica whose most recent replication lag exceeds this (milliseconds)
# is marked UNHEALTHY and excluded from routing regardless of consistency
# level — the hard ceiling beneath the softer, opt-in staleness bound above.
READ_REPLICA_MAX_LAG_MS="30000"
# Consecutive ping/query failures before a replica is marked UNHEALTHY and
# stops receiving reads.
READ_REPLICA_FAILURE_THRESHOLD="3"
# Consecutive successes an UNHEALTHY/DEGRADED replica needs before it is
# trusted with reads again.
READ_REPLICA_RECOVERY_THRESHOLD="2"
# A replica's last recorded health signal older than this (milliseconds) is
# treated as stale and therefore ineligible for routing.
READ_REPLICA_HEALTH_STALE_MS="60000"
