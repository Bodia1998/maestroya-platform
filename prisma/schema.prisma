// ============================================================================
// MaestroYa — Marketplace Domain Model
// ============================================================================
//
// Scope note (Phase 1): this file defines the complete data model only.
// No API, UI, pages, or business logic live here or were added elsewhere.
// See docs/DOMAIN_MODEL.md for a full explanation of every model and the
// reasoning behind each cascading/indexing decision.
//
// Two reference tables — Language and Role — were added beyond the
// requested 26 models. They aren't marketplace entities in their own
// right, but the task explicitly asks to seed "Languages" and "Roles",
// and seeding requires a table to seed into. Flagged here for visibility.
//
// Four more reference tables — Country, Province, City, PlatformSetting —
// were added in a later pass for the same reason: a task explicitly asked
// to seed Spain/Valencia/Gandia and platform settings, and Address stores
// geography as free-text with nothing to seed a lookup table into. See
// docs/DOMAIN_MODEL.md for details on why these stay independent of
// Address rather than replacing its free-text fields.
//
// A handful of CHECK constraints (e.g. "exactly one of professionalProfileId
// / companyProfileId must be set") can't be expressed in Prisma's schema
// language and are instead added via raw SQL in the migration — see
// prisma/migrations/20260717000000_init_domain_model/migration.sql.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth.js (next-auth) required models
// https://authjs.dev/getting-started/adapters/prisma
//
// Field names/shapes are fixed by the adapter and must not change. The one
// modification made here is switching User/Account/Session ids from cuid()
// to uuid() so every primary key in the schema is a UUID, per Phase 1's
// requirements — Auth.js does not care which id-generation strategy is used.
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // --- Marketplace fields (added in Phase 1) ---
  phone            String?    @unique
  phoneVerifiedAt  DateTime?
  status           UserStatus @default(PENDING_VERIFICATION)
  preferredLanguageId String? @db.Uuid
  timezone         String?
  notificationPreferences Json? @db.JsonB
  lastLoginAt      DateTime?
  deletedAt        DateTime? // soft delete — see docs/DOMAIN_MODEL.md "Why soft-delete users"

  // --- Authentication fields (added in Authentication module) ---
  // Nullable: users who only ever sign in via OAuth (Google/Apple/Facebook)
  // never get one. Never store or return this field outside the auth
  // module's own password-verification code path.
  passwordHash String?

  accounts Account[]
  sessions Session[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]

  preferredLanguage Language? @relation(fields: [preferredLanguageId], references: [id], onDelete: SetNull)
  roles             UserRole[]
  customerProfile     CustomerProfile?
  professionalProfile ProfessionalProfile?
  companyMemberships  CompanyMember[]
  addresses           Address[]

  ownedCompanies         CompanyProfile[]      @relation("CompanyOwner")
  submittedQuotes        Quote[]               @relation("QuoteSubmittedBy")
  conversationMembers    ConversationMember[]
  sentMessages           Message[]             @relation("MessageSender")
  writtenReviews         Review[]              @relation("ReviewAuthor")
  payments               Payment[]             @relation("PaymentPayer")
  requestedRefunds       Refund[]              @relation("RefundRequestedBy")
  notifications          Notification[]
  reviewedDocuments      VerificationDocument[] @relation("DocumentReviewer")
  raisedDisputes         Dispute[]              @relation("DisputeRaisedBy")
  resolvedDisputes       Dispute[]              @relation("DisputeResolvedBy")
  submittedDisputeEvidence DisputeEvidence[]    @relation("EvidenceSubmittedBy")
  auditLogEntries        AuditLog[]
  proposedAppointments   Appointment[]          @relation("AppointmentProposedBy")
  cancelledAppointments  Appointment[]          @relation("AppointmentCancelledBy")
  /// Order / Job Lifecycle module (Module 11).
  startedJobs            Job[]                  @relation("JobStartedBy")
  completedJobs          Job[]                  @relation("JobCompletedBy")
  cancelledJobs          Job[]                  @relation("JobCancelledBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([preferredLanguageId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Authentication module — Credentials auth support
//
// VerificationToken above is Auth.js-managed (reserved for its own
// Email/magic-link provider if one is ever added). The three models below
// are deliberately separate and owned entirely by this module's own code,
// to avoid two different systems writing to the same table for different
// purposes.
// ============================================================================

/// Single-use token proving control of an email address at registration
/// time (Credentials/email-password signup, distinct from Auth.js's own
/// magic-link VerificationToken). Consumed (deleted) on successful
/// verification; expired rows are safe to garbage-collect periodically.
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique /// SHA-256 of the token — the raw token is never stored
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Single-use token for the forgot-password → reset-password flow. Same
/// hash-at-rest treatment as EmailVerificationToken.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Long-lived, revocable refresh token backing the "Remember me" /
/// refresh-token requirement. Auth.js's own session JWT (short-lived,
/// stateless) stays the primary web-session mechanism — this table exists
/// so that mechanism can be *revoked* server-side (sign out everywhere,
/// ban a user mid-session) despite JWTs otherwise being stateless, and so
/// non-browser clients (a future mobile app) have a real refresh flow.
/// Rotated on every use (old row deleted, new row issued) so a stolen,
/// already-used refresh token is detectably invalid.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// Reference / lookup data (seeded — not marketplace entities per se)
// ============================================================================

/// Spoken/interface languages. Seeded at deploy time; referenced by User
/// (preferred language) and ProfessionalProfile (languages spoken, for
/// customer-professional matching).
model Language {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique /// ISO 639-1, e.g. "es", "en", "ca"
  name       String  /// English name, e.g. "Spanish"
  nativeName String  /// Native name, e.g. "Español"
  isActive   Boolean @default(true)

  users                User[]
  professionalProfiles ProfessionalProfile[] @relation("ProfessionalLanguages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

/// Platform roles for RBAC. Kept as seeded data (not a hardcoded enum) so
/// new roles (e.g. "SUPPORT") can be added without a schema migration.
/// A user can hold multiple roles at once — e.g. someone can be both a
/// CUSTOMER and a PROFESSIONAL on the same account.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique /// e.g. "CUSTOMER", "PROFESSIONAL", "ADMIN"
  name        String
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Join table: which roles a user holds.
model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Normalized geographic reference data (country → province → city), used
/// for structured location pickers/filtering. Deliberately independent of
/// Address, which keeps storing free-text city/province/country — linking
/// Address to this hierarchy (e.g. replacing Address.city with a FK) is a
/// bigger structural change than "add a seed script" and is left for a
/// deliberate future decision rather than made silently here.
model Country {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique /// ISO 3166-1 alpha-2, e.g. "ES"
  name String

  provinces Province[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model Province {
  id        String @id @default(uuid()) @db.Uuid
  countryId String @db.Uuid
  name      String

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([countryId])
  @@map("provinces")
}

model City {
  id         String @id @default(uuid()) @db.Uuid
  provinceId String @db.Uuid
  name       String

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

/// Platform-wide configuration as key/value rows (commission rate,
/// support email, feature flags, etc.) rather than hardcoded constants —
/// lets ops change these without a deploy. `value` is Json so a single
/// table can hold settings of any shape (a number, a string, an object).
model PlatformSetting {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  value       Json    @db.JsonB
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ============================================================================
// Enums
// ============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum AddressType {
  HOME
  WORK
  BILLING
  SERVICE_LOCATION
  OTHER
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Professional Module: lifecycle status of an individual professional's
/// profile, distinct from `verificationStatus` (trust/identity checks).
enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Professional Module: identity/trust verification state. Admin-only
/// future workflow moves a profile through PENDING -> VERIFIED/REJECTED;
/// professionals themselves can never set this field.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

/// Order / Job Lifecycle module (Module 11) note: IN_PROGRESS/COMPLETED
/// remain reserved-but-unused here by deliberate decision — Module 11
/// introduces Job.status as the authoritative execution-lifecycle field
/// instead (see JobStatus and domain/services/job-state.ts). This module
/// never writes ServiceRequest to IN_PROGRESS or COMPLETED as a side effect
/// of any Job/Appointment transition.
enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum QuoteStatus {
  PENDING
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum AppointmentStatus {
  /// Booking/Appointments module (MVP): the Appointment row created the
  /// moment a Quote is accepted, before any actual scheduling has happened.
  /// Added because the original enum had no state representing "exists but
  /// unscheduled" — see prisma/migrations/20260723000000_add_appointment_pending_schedule
  /// for why this was unavoidable. A future scheduling module transitions
  /// this to SCHEDULED once `scheduledStart` is actually set.
  PENDING_SCHEDULE
  /// Deprecated/unused: superseded by the PROPOSED/CONFIRMED distinction
  /// added by the Booking & Scheduling module (Module 10) — see
  /// domain/services/appointment-state.ts. Kept on the enum only for
  /// backward compatibility with the value already shipped in the initial
  /// migration; no code writes it.
  SCHEDULED
  /// Booking & Scheduling module (Module 10): one party (customer or
  /// professional) has put forward a `[proposedStart, proposedEnd)` window
  /// that the other party has not yet confirmed. See
  /// domain/services/appointment-state.ts for the full transition rules.
  PROPOSED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

/// Booking & Scheduling module (Module 10): typed reason recorded when an
/// Appointment is cancelled — kept as a closed enum (rather than free text)
/// so a future Payment/Stripe Connect module can automate refund-eligibility
/// decisions from it without parsing prose. `cancellationNote` on
/// Appointment still carries optional free-text detail alongside this.
enum AppointmentCancellationReason {
  CUSTOMER_REQUEST
  PROFESSIONAL_UNAVAILABLE
  SCHEDULING_CONFLICT
  OTHER
}

/// Order / Job Lifecycle module (Module 11): the execution-lifecycle status
/// of a Job. Deliberately smaller than the full hypothetical lifecycle
/// (no separate SCHEDULED — that remains Appointment's job, see Module 10)
/// and deliberately does not reuse ServiceRequestStatus.IN_PROGRESS/
/// COMPLETED (see ServiceRequestStatus's own doc note) — Job.status is the
/// single authoritative execution-lifecycle field. COMPLETED and CANCELLED
/// are terminal; see domain/services/job-state.ts for the full transition
/// rules.
enum JobStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Order / Job Lifecycle module (Module 11): typed reason recorded when a
/// Job is cancelled — same "closed enum, not free text" pattern as
/// AppointmentCancellationReason, so a future Payment/Stripe Connect module
/// can automate refund-eligibility decisions from it without parsing
/// prose. `cancellationNote` on Job still carries optional free-text detail
/// alongside this.
enum JobCancellationReason {
  CUSTOMER_REQUEST
  PROFESSIONAL_UNABLE_TO_COMPLETE
  SERVICE_REQUEST_ISSUE
  OTHER
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

/// Booking & Scheduling module (Module 10): distinguishes a normal
/// user-authored chat message from an automated, informational one the
/// Booking module posts into an existing Conversation (appointment
/// proposed/confirmed/cancelled/rescheduled — see
/// application/ports/appointment-notifier.ts and
/// ChatAppointmentNotifier). SYSTEM messages are still attributed to the
/// user whose action triggered them (`Message.senderId`) — there is no
/// separate platform/system User account — `type` is what lets the UI
/// render them differently (e.g. centered, non-bubble) and lets other code
/// distinguish them without parsing message bodies. Booking never mutates
/// Conversation/Message state directly beyond calling
/// MessageRepository.create with this type — Chat owns its own schema and
/// persistence.
enum MessageType {
  USER
  SYSTEM
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  FLAGGED
  REMOVED
}

enum PaymentMethodType {
  CARD
  SEPA_DEBIT
  BANK_TRANSFER
  WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  CHARGE
  REFUND
  PAYOUT
  COMMISSION
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum CommissionStatus {
  PENDING
  INVOICED
  SETTLED
  WAIVED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELLED
}

enum RefundReason {
  DUPLICATE
  FRAUDULENT
  REQUESTED_BY_CUSTOMER
  SERVICE_NOT_RENDERED
  QUALITY_ISSUE
  OTHER
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

/// Notifications module (Module 15): one value per real, currently
/// implemented trigger point — see docs/MODULE_15_NOTIFICATIONS.md
/// "Notification Types" for exactly which use case creates each one.
/// This replaces the Phase-1 placeholder enum (SERVICE_REQUEST_UPDATE,
/// QUOTE_RECEIVED, APPOINTMENT_REMINDER, MESSAGE_RECEIVED,
/// PAYMENT_RECEIVED, PAYOUT_PROCESSED, DISPUTE_UPDATE, SYSTEM, MARKETING),
/// none of which had a real trigger anywhere in the codebase yet — see the
/// module doc's "Deferred Functionality" section for why each was dropped
/// rather than kept unused (no professional-matching mechanism for a new
/// ServiceRequest, Payments/Disputes/Admin are out of Module 15's scope
/// per the module boundary, and there is no sender for MARKETING).
enum NotificationType {
  NEW_QUOTE
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  NEW_MESSAGE
  APPOINTMENT_PROPOSED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  JOB_STARTED
  JOB_COMPLETED
  JOB_CANCELLED
  REVIEW_RECEIVED
}

enum VerificationDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  INSURANCE_CERTIFICATE
  PROFESSIONAL_CERTIFICATION
  PROOF_OF_ADDRESS
  OTHER
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DisputeReason {
  SERVICE_NOT_COMPLETED
  QUALITY_ISSUE
  BILLING_ISSUE
  DAMAGE_CLAIM
  BEHAVIOR_ISSUE
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_RESPONSE
  RESOLVED
  ESCALATED
  CLOSED
}

enum DisputeResolution {
  REFUND_CUSTOMER
  PAY_PROFESSIONAL
  PARTIAL_REFUND
  NO_ACTION
  ESCALATED_EXTERNALLY
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT
  PAYOUT
  VERIFICATION
  OTHER
}

// ============================================================================
// Identity & Profiles
// ============================================================================

/// A saved address, owned by a user. Reused as billing addresses, service
/// locations, etc. Soft-deleted (not hard-deleted) because ServiceRequest
/// and Appointment keep a Restrict-protected FK to specific addresses for
/// historical accuracy — removing an address from an active address book
/// should not corrupt past job records.
model Address {
  id      String      @id @default(uuid()) @db.Uuid
  userId  String      @db.Uuid
  type    AddressType
  label   String?
  line1   String
  line2   String?
  city    String
  province String?
  postalCode String
  country String  @default("ES")
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerProfilesDefaultingHere CustomerProfile[]
  serviceRequests                ServiceRequest[]
  appointments                   Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

/// Customer-specific extension of User. Deliberately thin — most identity
/// data lives on User itself; this only holds fields meaningful to the
/// "requests services" side of the marketplace.
model CustomerProfile {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @unique @db.Uuid
  defaultAddressId String? @db.Uuid
  marketingOptIn   Boolean @default(false)
  notes            String? @db.Text
  deletedAt        DateTime?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress Address? @relation(fields: [defaultAddressId], references: [id], onDelete: SetNull)

  serviceRequests ServiceRequest[]
  /// Order / Job Lifecycle module (Module 11).
  jobs            Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultAddressId])
  @@index([deletedAt])
  @@map("customer_profiles")
}

/// An individual freelance professional (not affiliated with a company).
/// Holds everything specific to "offers services solo": rate, radius,
/// verification/trust signals, and the Stripe Connect account payouts go to.
///
/// Verification note (Professional Module): `verificationStatus` is the
/// single source of truth for trust/verification state — there is
/// deliberately no separate `isVerified` boolean, to avoid two fields that
/// could disagree. `verifiedAt` is only ever set when `verificationStatus`
/// transitions to VERIFIED. Verification itself remains an admin-only
/// future workflow; the Professional Module never sets this to VERIFIED
/// on its own.
model ProfessionalProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  bio                  String?  @db.Text
  headline             String?
  yearsExperience      Int?
  hourlyRate           Decimal? @db.Decimal(10, 2)
  serviceRadiusKm      Int?
  verifiedAt           DateTime?
  stripeConnectAccountId String? @unique
  averageRating        Decimal? @db.Decimal(3, 2)
  reviewCount          Int      @default(0)
  isAcceptingRequests  Boolean  @default(true)
  deletedAt            DateTime?

  // --- Professional Module fields (added in Professional Module) ---
  businessName       String?
  contactEmail       String?
  contactPhone       String?
  websiteUrl         String?
  taxId              String?              @unique
  status             ProfessionalStatus   @default(ACTIVE)
  verificationStatus VerificationStatus   @default(UNVERIFIED)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories ServiceCategory[] @relation("ProfessionalCategories")
  languages  Language[]        @relation("ProfessionalLanguages")

  quotes                Quote[]
  appointments            Appointment[]
  /// Order / Job Lifecycle module (Module 11).
  jobs                    Job[]
  reviewsReceived        Review[]                @relation("ReviewOfProfessional")
  payouts                Payout[]                @relation("PayoutToProfessional")
  commissions             Commission[]            @relation("CommissionOnProfessional")
  verificationDocuments   VerificationDocument[]  @relation("DocumentOfProfessional")
  respondentInDisputes    Dispute[]               @relation("DisputeRespondentProfessional")
  /// Portfolio module (Module 14).
  portfolioItems          PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([status])
  @@index([isAcceptingRequests])
  @@index([deletedAt])
  @@map("professional_profiles")
}

/// A company/business account. Companies act on requests through their
/// CompanyMember employees, but the business entity itself (legal name,
/// tax id, verification, Stripe Connect account) lives here.
model CompanyProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  ownerUserId            String   @db.Uuid
  legalName              String
  tradeName              String?
  taxId                  String   @unique /// CIF/NIF
  description            String?  @db.Text
  logoUrl                String?
  websiteUrl             String?
  stripeConnectAccountId String?  @unique
  isVerified             Boolean  @default(false)
  verifiedAt             DateTime?
  averageRating          Decimal? @db.Decimal(3, 2)
  reviewCount            Int      @default(0)
  isAcceptingRequests    Boolean  @default(true)
  deletedAt              DateTime?

  owner   User             @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members CompanyMember[]

  categories ServiceCategory[] @relation("CompanyCategories")

  quotes                 Quote[]
  appointments             Appointment[]
  /// Order / Job Lifecycle module (Module 11).
  jobs                     Job[]
  reviewsReceived         Review[]                @relation("ReviewOfCompany")
  payouts                 Payout[]                @relation("PayoutToCompany")
  commissions              Commission[]            @relation("CommissionOnCompany")
  verificationDocuments    VerificationDocument[]  @relation("DocumentOfCompany")
  respondentInDisputes     Dispute[]               @relation("DisputeRespondentCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([isVerified])
  @@index([deletedAt])
  @@map("company_profiles")
}

/// Join table: which users work for which company, and in what capacity.
/// `removedAt` is a purpose-named soft-delete — it marks when someone's
/// membership ended without deleting the row, preserving "who worked here
/// and when" for dispute/audit purposes.
model CompanyMember {
  id               String            @id @default(uuid()) @db.Uuid
  companyProfileId String            @db.Uuid
  userId           String            @db.Uuid
  role             CompanyMemberRole @default(MEMBER)
  invitedAt        DateTime          @default(now())
  joinedAt         DateTime?
  removedAt        DateTime?

  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, userId])
  @@index([userId])
  @@index([companyProfileId, removedAt])
  @@map("company_members")
}

// ============================================================================
// Service Catalog
// ============================================================================

/// Hierarchical service categories (e.g. "Fontanería" → "Reparación de
/// fugas"). Self-referencing for subcategories. Soft-deleted rather than
/// hard-deleted so historical ServiceRequests keep a valid category
/// reference even after a category is deprecated.
model ServiceCategory {
  id          String                 @id @default(uuid()) @db.Uuid
  parentId    String?                @db.Uuid
  name        String
  slug        String                 @unique
  description String?
  iconUrl     String?
  status      ServiceCategoryStatus  @default(ACTIVE)
  sortOrder   Int                    @default(0)
  deletedAt   DateTime?

  parent   ServiceCategory?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("CategoryToSubcategory")

  professionals ProfessionalProfile[] @relation("ProfessionalCategories")
  companies     CompanyProfile[]      @relation("CompanyCategories")
  serviceRequests ServiceRequest[]
  /// Portfolio module (Module 14). Optional — a portfolio item may tag
  /// itself with the category of work it showcases.
  portfolioItems PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([status])
  @@index([deletedAt])
  @@map("service_categories")
}

// ============================================================================
// Portfolio (Module 14)
// ============================================================================

/// Portfolio module (Module 14): a showcase item ("previous work") a
/// professional attaches to their own profile. Always anchored to exactly
/// one ProfessionalProfile — never to a CompanyProfile (this codebase only
/// supports solo professionals end-to-end today, same scope note as
/// Review.revieweeProfessionalProfileId; see review-repository.ts) and
/// never editable/deletable by anyone but its owner.
///
/// `mediaUrl` is a plain URL string, not a stored file — Module 14 does not
/// introduce a new media/storage abstraction (an upload UI/flow is
/// explicitly deferred; see docs/MODULE_14_PORTFOLIO.md). When an upload
/// flow is eventually built, it can reuse the existing Cloudinary adapter
/// (see src/core/infrastructure/storage/cloudinary) and hand this field the
/// resulting `secure_url`, exactly like Address/ServiceRequest photos do
/// today — no schema change required.
///
/// `serviceCategoryId` is optional and `onDelete: SetNull` — unlike
/// ServiceRequest.categoryId (Restrict, since a request's category is
/// load-bearing for matching/history), a portfolio item's category tag is
/// purely descriptive, so a deprecated category should never block a
/// professional from managing their own portfolio.
///
/// Soft-deleted via `deletedAt` (never a hard delete) — same convention as
/// Address/Message/ProfessionalProfile elsewhere in this schema.
model PortfolioItem {
  id                    String    @id @default(uuid()) @db.Uuid
  professionalProfileId String    @db.Uuid
  serviceCategoryId     String?   @db.Uuid
  title                 String
  description           String?   @db.Text
  mediaUrl              String
  deletedAt             DateTime?

  /// Admin Panel (Module 16): admin content moderation, deliberately
  /// separate from `deletedAt` (owner-driven soft delete, Module 14).
  /// Non-null = an admin has hidden this item from public/professional
  /// listings; null = visible (default, unmoderated). Never set by the
  /// professional themselves — only ModeratePortfolioItemUseCase/
  /// RestorePortfolioItemUseCase (Admin Panel) write this field. Who
  /// moderated it and why is recorded on the append-only AuditLog, not
  /// denormalized here — same "narrow field, audit trail carries the
  /// detail" choice made for Review moderation (Review.status already
  /// existed pre-Module-16 and needed no schema change at all).
  moderatedAt DateTime?

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  serviceCategory     ServiceCategory?    @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId, deletedAt, createdAt])
  @@index([serviceCategoryId])
  @@index([moderatedAt])
  @@map("portfolio_items")
}

// ============================================================================
// Requests, Quotes & Scheduling
// ============================================================================

/// A customer's request for a service — the core "job posting" of the
/// marketplace. FKs to CustomerProfile/ServiceCategory/Address are Restrict
/// (not Cascade): a request is a historical/financial record and must not
/// silently disappear if, say, an address is later removed from a user's
/// address book — removal there is itself soft-deleted for this reason.
model ServiceRequest {
  id               String                @id @default(uuid()) @db.Uuid
  customerId       String                @db.Uuid
  categoryId       String                @db.Uuid
  addressId        String                @db.Uuid
  title            String
  description      String                @db.Text
  status           ServiceRequestStatus  @default(DRAFT)
  urgency          RequestUrgency        @default(MEDIUM)
  budgetMin        Decimal?              @db.Decimal(10, 2)
  budgetMax        Decimal?              @db.Decimal(10, 2)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  expiresAt        DateTime?
  deletedAt        DateTime?

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  address  Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)

  photos        RequestPhoto[]
  quotes        Quote[]
  appointments  Appointment[]
  /// Order / Job Lifecycle module (Module 11). In practice at most one Job
  /// per ServiceRequest exists (a request has at most one accepted Quote —
  /// see AcceptQuoteUseCase's "one active job per request" guard), but this
  /// stays a list (like `quotes`/`appointments`) rather than an optional
  /// 1:1 back-relation for consistency with those siblings.
  jobs          Job[]
  conversations Conversation[]
  reviews       Review[]
  payments      Payment[]
  disputes      Dispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([categoryId])
  @@index([addressId])
  @@index([status, categoryId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("service_requests")
}

/// Photos the customer attaches to a request (e.g. a photo of the leak).
/// Cascades with its parent request — a photo has no meaning on its own.
model RequestPhoto {
  id               String   @id @default(uuid()) @db.Uuid
  serviceRequestId String   @db.Uuid
  url              String
  caption          String?
  sortOrder        Int      @default(0)

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@map("request_photos")
}

/// A professional's or company's bid on a ServiceRequest. Exactly one of
/// professionalProfileId / companyProfileId is set — enforced by a CHECK
/// constraint added in the migration (Prisma's schema language can't
/// express multi-column CHECK constraints natively). `submittedByUserId`
/// records which specific person submitted it (the solo pro themself, or
/// a specific CompanyMember acting on the company's behalf).
model Quote {
  id                    String      @id @default(uuid()) @db.Uuid
  serviceRequestId      String      @db.Uuid
  professionalProfileId String?     @db.Uuid
  companyProfileId      String?     @db.Uuid
  submittedByUserId     String      @db.Uuid
  status                QuoteStatus @default(PENDING)
  totalAmount           Decimal     @db.Decimal(10, 2)
  currency              String      @default("EUR")
  validUntil            DateTime?
  notes                 String?     @db.Text
  respondedAt           DateTime?

  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  submittedBy         User                 @relation("QuoteSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  items        QuoteItem[]
  appointments Appointment[]
  payments     Payment[]
  /// Order / Job Lifecycle module (Module 11): 1:1 with the Job created
  /// when this Quote is accepted (see Job.quoteId's `@unique`) — null for
  /// every Quote that was never accepted.
  job          Job?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId, status])
  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([submittedByUserId])
  @@map("quotes")
}

/// Line items making up a Quote's total (labor, materials, call-out fee,
/// etc.). `amount` is stored (not computed) so historical quotes remain
/// accurate even if pricing logic changes later.
model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("quote_items")
}

/// Order / Job Lifecycle module (Module 11): the execution-lifecycle
/// entity — created automatically (never by a customer/professional
/// directly) the moment a Quote is accepted, inside the same transaction
/// that already creates the initial Appointment (see
/// PrismaQuoteAcceptanceRepository.acceptQuote). 1:1 with the accepted
/// Quote (`quoteId` is unique); a Job can own multiple Appointments (e.g.
/// a multi-day renovation is one Job with several visit-level
/// Appointments — see Appointment's own doc comment).
///
/// Deliberately separate from ServiceRequest: ServiceRequest remains the
/// customer-facing marketplace posting/request lifecycle (DRAFT ->
/// PUBLISHED -> ACCEPTED, see ServiceRequestStatus), while Job.status is
/// the authoritative record of whether the *accepted work itself* has
/// started/finished — see JobStatus and domain/services/job-state.ts. No
/// Module 11 code ever writes ServiceRequest to IN_PROGRESS or COMPLETED
/// as a side effect of a Job/Appointment transition.
///
/// `customerId`/`professionalProfileId`/`companyProfileId` are
/// denormalized at creation time from the ServiceRequest/accepted Quote —
/// same "denormalize the frequently-joined FK" pattern Appointment already
/// uses for its own professionalProfileId/companyProfileId — so "find my
/// active jobs" never requires a join through ServiceRequest/Quote.
/// Exactly one of professionalProfileId/companyProfileId is set, enforced
/// by a CHECK constraint (same pattern as Quote/Appointment).
model Job {
  id                    String                  @id @default(uuid()) @db.Uuid
  serviceRequestId      String                  @db.Uuid
  quoteId               String                  @unique @db.Uuid
  customerId            String                  @db.Uuid
  professionalProfileId String?                 @db.Uuid
  companyProfileId      String?                 @db.Uuid
  status                JobStatus               @default(CREATED)
  startedAt             DateTime?
  startedByUserId       String?                 @db.Uuid
  completedAt           DateTime?
  completedByUserId     String?                 @db.Uuid
  cancelledAt           DateTime?
  cancelledByUserId     String?                 @db.Uuid
  cancellationReason    JobCancellationReason?
  cancellationNote      String?                 @db.Text

  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customer            CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  startedBy           User?                @relation("JobStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  completedBy         User?                @relation("JobCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  cancelledBy          User?               @relation("JobCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  appointments Appointment[]

  /// Reviews & Ratings module (Module 13): at most one customer review per
  /// Job — see Review.jobId's `@unique`. Optional because most Jobs will
  /// never be reviewed.
  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([customerId])
  @@index([professionalProfileId, status])
  @@index([companyProfileId, status])
  @@index([status])
  @@map("jobs")
}

/// A scheduled (or completed) visit stemming from an accepted Quote. One
/// Quote can produce multiple Appointments (e.g. a multi-day renovation
/// job), which is why this isn't just a field on Quote.
///
/// Order / Job Lifecycle module (Module 11): every Appointment now also
/// belongs to exactly one Job (`jobId`, non-nullable) — the Job created
/// alongside it at quote-acceptance time, or, for a rescheduled
/// appointment, the same Job its superseded row belonged to (see
/// RescheduleAppointmentUseCase / PrismaAppointmentRepository.reschedule).
/// This is additive: quoteId/serviceRequestId are unchanged and continue
/// to be set exactly as before.
model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @db.Uuid
  quoteId          String            @db.Uuid
  serviceRequestId String            @db.Uuid
  addressId        String            @db.Uuid

  /// Booking & Scheduling module (Module 10): denormalized from the
  /// accepted Quote at creation time (see PrismaQuoteAcceptanceRepository).
  /// Exactly one of professionalProfileId / companyProfileId is set —
  /// enforced by a CHECK constraint (same "exactly one" pattern as
  /// Quote.professionalProfileId/companyProfileId), added in
  /// prisma/migrations/*_add_appointment_scheduling_lifecycle. This is what
  /// makes "does this professional have a conflicting appointment"
  /// queryable directly on Appointment instead of requiring a join through
  /// Quote — see the composite indexes below and
  /// ConfirmAppointmentUseCase's conflict check.
  professionalProfileId String? @db.Uuid
  companyProfileId      String? @db.Uuid

  /// Booking/Appointments module (MVP): nullable because an Appointment is
  /// now created immediately on Quote acceptance, before any actual
  /// scheduling — see the PENDING_SCHEDULE status above and
  /// prisma/migrations/20260723000000_add_appointment_pending_schedule.
  /// Booking & Scheduling module (Module 10): filled in by
  /// ConfirmAppointmentUseCase once the other party confirms a proposed
  /// time — this is always the authoritative, conflict-checked schedule,
  /// never a placeholder.
  ///
  /// Timezone decision (Module 10): unlike the rest of this schema (which
  /// uses Prisma's default `TIMESTAMP(3)`, i.e. timezone-naive, per the
  /// audit report's "Database gaps" finding), every DateTime field on this
  /// model is explicitly `@db.Timestamptz(3)` — stored as a true UTC
  /// instant. Scheduling is exactly the place a naive timestamp becomes
  /// ambiguous once the platform has customers/professionals in different
  /// IANA zones (EU expansion) or across a DST boundary (Spain observes
  /// DST). A platform-wide migration of every DateTime column is explicitly
  /// out of scope for this module (see the audit's "CAN BE DEFERRED"
  /// section) — this is a narrow, self-contained exception scoped to the
  /// one model where the ambiguity is actually user-visible today. The
  /// application layer always converts a proposed local time to its UTC
  /// instant at the DTO boundary using the proposer's own `User.timezone`
  /// (see booking.dto.ts) before it ever reaches this column.
  scheduledStart   DateTime? @db.Timestamptz(3)
  scheduledEnd     DateTime? @db.Timestamptz(3)

  /// Booking & Scheduling module (Module 10): an unconfirmed time put
  /// forward by either party (see AppointmentStatus.PROPOSED and
  /// domain/services/appointment-state.ts). Left in place after
  /// confirmation as a record of what was last proposed; superseded values
  /// from earlier counter-proposals are not separately retained (only the
  /// most recent proposal matters operationally — full history lives at
  /// the Appointment-row level via rescheduling, not per-proposal).
  proposedStart    DateTime? @db.Timestamptz(3)
  proposedEnd      DateTime? @db.Timestamptz(3)
  proposedByUserId String?   @db.Uuid

  actualStart      DateTime? @db.Timestamptz(3)
  actualEnd        DateTime? @db.Timestamptz(3)
  status           AppointmentStatus @default(PENDING_SCHEDULE)
  notes            String?           @db.Text

  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelledByUserId  String?                         @db.Uuid
  cancellationReason AppointmentCancellationReason?
  /// Booking & Scheduling module (Module 10): optional free-text detail
  /// alongside the typed `cancellationReason` — kept separate so a future
  /// Payment/Stripe Connect refund-eligibility workflow can key off the
  /// typed enum without parsing prose.
  cancellationNote   String?                         @db.Text

  /// Booking & Scheduling module (Module 10): non-destructive rescheduling.
  /// Set only on the *new* Appointment row created by
  /// RescheduleAppointmentUseCase, pointing back at the row it supersedes.
  /// The old row is transitioned to RESCHEDULED and never mutated further —
  /// its proposal/confirmation/cancellation history is preserved forever
  /// instead of being overwritten in place. `@unique` because a superseded
  /// appointment can be rescheduled into at most one successor.
  rescheduledFromId String? @unique @db.Uuid

  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  address             Address              @relation(fields: [addressId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  proposedBy          User?                @relation("AppointmentProposedBy", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  cancelledBy         User?                @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  rescheduledFrom     Appointment?         @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo       Appointment?         @relation("AppointmentReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([quoteId])
  @@index([serviceRequestId])
  @@index([addressId])
  @@index([scheduledStart])
  @@index([status])
  @@index([professionalProfileId, status, scheduledStart, scheduledEnd])
  @@index([companyProfileId, status, scheduledStart, scheduledEnd])
  @@map("appointments")
}

// ============================================================================
// Messaging
// ============================================================================

/// A chat thread. Usually tied to a ServiceRequest (customer ↔
/// professional/company discussing a job); `serviceRequestId` is nullable
/// to also allow platform/support conversations not tied to a request.
model Conversation {
  id               String              @id @default(uuid()) @db.Uuid
  serviceRequestId String?             @db.Uuid
  status           ConversationStatus  @default(ACTIVE)
  lastMessageAt    DateTime?

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([lastMessageAt])
  @@map("conversations")
}

/// Join table: who's in a conversation. `leftAt` lets someone leave
/// without losing the historical fact they were part of it; `lastReadAt`
/// backs unread-message counts.
model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// A single chat message. `senderId` is Restrict (not Cascade) so message
/// history survives even if the app is ever configured to hard-delete a
/// user — in practice, User uses soft delete (`deletedAt`) for exactly
/// this reason, so this constraint should rarely if ever actually block
/// anything. `deletedAt` supports a user "unsending" their own message.
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderId       String        @db.Uuid
  body           String        @db.Text
  status         MessageStatus @default(SENT)
  /// Booking & Scheduling module (Module 10) addition — see MessageType's
  /// doc comment.
  type           MessageType   @default(USER)
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  attachments MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/// Files attached to a message (photos, PDFs, etc.). Cascades with its
/// parent message.
model MessageAttachment {
  id            String  @id @default(uuid()) @db.Uuid
  messageId     String  @db.Uuid
  url           String
  fileName      String
  fileType      String
  fileSizeBytes Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId])
  @@map("message_attachments")
}

// ============================================================================
// Reviews
// ============================================================================

/// A customer's review of a completed Job (Reviews & Ratings module,
/// Module 13). Originally anchored to ServiceRequest only; Module 13
/// re-anchors it to `Job` (`jobId`, unique — one review per Job) because
/// Job, not ServiceRequest, is the authoritative record of "was the work
/// actually completed" (see job-state.ts and the Module 11 audit report,
/// "Finding 1"). `serviceRequestId` is kept as an additional denormalized
/// FK for convenient querying — same "keep the frequently-joined FK
/// alongside the newer authoritative one" pattern Appointment already uses
/// for quoteId/serviceRequestId next to jobId — but Job is always the
/// source of truth for eligibility/authorization, never ServiceRequest or
/// Quote directly.
///
/// Exactly one of revieweeProfessionalProfileId / revieweeCompanyProfileId
/// is set (CHECK constraint added in migration), matching the same
/// solo-pro-vs-company duality used on Quote/Payout/etc — this keeps the
/// model ready for a future company-side review without redesign. `response`
/// lets the professional/company reply publicly, a standard marketplace
/// pattern; unused by Module 13 (no reply use case yet) but left in place
/// for a future module to fill in.
///
/// `status` defaults to PUBLISHED, not PENDING: Module 13 does not
/// implement a moderation/approval workflow (that's Module 16 — Admin
/// Panel's job), so a review is visible as soon as it's created. The enum
/// itself (PENDING/PUBLISHED/FLAGGED/REMOVED) is left untouched so Module
/// 16 can later flag/remove a review, or reintroduce a pending-approval
/// step, without a schema change.
model Review {
  id                             String       @id @default(uuid()) @db.Uuid
  jobId                          String       @unique @db.Uuid
  serviceRequestId               String       @db.Uuid
  reviewerId                     String       @db.Uuid
  revieweeProfessionalProfileId  String?      @db.Uuid
  revieweeCompanyProfileId       String?      @db.Uuid
  rating                         Int /// 1–5, enforced by CHECK constraint in migration
  comment                        String?      @db.Text
  response                       String?      @db.Text
  respondedAt                    DateTime?
  status                         ReviewStatus @default(PUBLISHED)
  deletedAt                      DateTime?

  job                  Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  serviceRequest       ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  reviewer             User                 @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeProfessional ProfessionalProfile? @relation("ReviewOfProfessional", fields: [revieweeProfessionalProfileId], references: [id], onDelete: Restrict)
  revieweeCompany      CompanyProfile?      @relation("ReviewOfCompany", fields: [revieweeCompanyProfileId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([reviewerId])
  @@index([revieweeProfessionalProfileId])
  @@index([revieweeCompanyProfileId])
  @@index([status])
  @@map("reviews")
}

// ============================================================================
// Payments & Finance
// ============================================================================

/// A customer's payment for a ServiceRequest/Quote. All money fields use
/// Decimal(10,2) — never Float — to avoid floating-point rounding errors
/// in financial data.
model Payment {
  id                    String            @id @default(uuid()) @db.Uuid
  serviceRequestId      String            @db.Uuid
  quoteId               String?           @db.Uuid
  payerId               String            @db.Uuid
  amount                Decimal           @db.Decimal(10, 2)
  currency              String            @default("EUR")
  method                PaymentMethodType
  status                PaymentStatus     @default(PENDING)
  stripePaymentIntentId String?           @unique
  capturedAt            DateTime?
  failureReason         String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote          Quote?         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  payer          User           @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)

  refunds      Refund[]
  commission   Commission?
  transactions Transaction[] @relation("TransactionPayment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([quoteId])
  @@index([payerId])
  @@index([status])
  @@map("payments")
}

/// The platform's fee taken from a Payment. One-to-one with Payment —
/// every captured payment produces exactly one commission record, even if
/// its rate is later found to be 0 (waived). `rateBps` (basis points,
/// e.g. 1000 = 10.00%) avoids the float-precision issues a percentage
/// stored as a fraction would introduce.
///
/// Unlike Quote/Review/Payout/VerificationDocument/Dispute, the
/// professionalProfileId/companyProfileId pair here is constrained to
/// "at most one" (not "exactly one") in the migration — a manual platform
/// adjustment with neither set is a legitimate edge case for this model.
model Commission {
  id                    String           @id @default(uuid()) @db.Uuid
  paymentId             String           @unique @db.Uuid
  professionalProfileId String?          @db.Uuid
  companyProfileId      String?          @db.Uuid
  rateBps               Int
  amount                Decimal          @db.Decimal(10, 2)
  status                CommissionStatus @default(PENDING)
  settledAt             DateTime?

  payment             Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation("CommissionOnProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("CommissionOnCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionCommission")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([status])
  @@map("commissions")
}

/// A payout of earnings to a professional or company via Stripe Connect.
/// Same solo-pro-vs-company duality pattern as Quote/Review (CHECK
/// constraint in migration).
model Payout {
  id                     String       @id @default(uuid()) @db.Uuid
  professionalProfileId  String?      @db.Uuid
  companyProfileId       String?      @db.Uuid
  amount                 Decimal      @db.Decimal(10, 2)
  currency               String       @default("EUR")
  status                 PayoutStatus @default(PENDING)
  stripeTransferId       String?      @unique
  periodStart            DateTime?
  periodEnd              DateTime?
  processedAt            DateTime?
  failureReason          String?

  professionalProfile ProfessionalProfile? @relation("PayoutToProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("PayoutToCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionPayout")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([status])
  @@map("payouts")
}

/// A refund against a Payment. `requestedByUserId` may be the customer or
/// an admin acting on a dispute resolution.
model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  requestedByUserId String       @db.Uuid
  amount            Decimal      @db.Decimal(10, 2)
  reason            RefundReason
  status            RefundStatus @default(REQUESTED)
  stripeRefundId    String?      @unique
  processedAt       DateTime?
  notes             String?      @db.Text

  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedByUser User    @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionRefund")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("refunds")
}

/// Append-only general ledger. Every money movement (charge, refund,
/// payout, commission, manual adjustment) gets one Transaction row, giving
/// a single queryable audit trail independent of which specific table
/// (Payment/Refund/Payout/Commission) generated it. At most one of the
/// four source FKs is set, matching which `type` the row is.
model Transaction {
  id            String             @id @default(uuid()) @db.Uuid
  paymentId     String?            @db.Uuid
  payoutId      String?            @db.Uuid
  refundId      String?            @db.Uuid
  commissionId  String?            @db.Uuid
  type          TransactionType
  status        TransactionStatus  @default(PENDING)
  amount        Decimal            @db.Decimal(10, 2) /// signed: positive = inflow to the platform, negative = outflow
  currency      String             @default("EUR")
  description   String?

  payment    Payment?    @relation("TransactionPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  payout     Payout?     @relation("TransactionPayout", fields: [payoutId], references: [id], onDelete: Restrict)
  refund     Refund?     @relation("TransactionRefund", fields: [refundId], references: [id], onDelete: Restrict)
  commission Commission? @relation("TransactionCommission", fields: [commissionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([payoutId])
  @@index([refundId])
  @@index([commissionId])
  @@index([type, status])
  @@index([createdAt])
  @@map("transactions")
}

// ============================================================================
// Notifications
// ============================================================================

/// A single notification instance for a user across any channel. Unlike
/// most tables here, this Cascades with User — notifications are
/// disposable, not part of the financial/legal record, so there's no
/// reason to block a (hypothetical, rare) hard user deletion on their
/// notification history.
/// Notifications module (Module 15): a single in-app notification instance
/// for a user. Reshaped from the Phase-1 placeholder version (see git
/// history) — that shape anticipated multi-channel (email/SMS/push)
/// delivery (`channel`/`status`/`sentAt`) that no module has implemented;
/// Module 15 is in-app only, so those fields were replaced with the
/// concrete shape it actually needs: `resourceType`/`resourceId` +
/// `actionUrl` for deep-linking back to the resource the notification is
/// about, `metadata` for small structured extras, and `dismissedAt` as the
/// soft-delete marker (distinct from `readAt` — see the module doc's
/// "Read/Unread vs. Dismissal" section). Multi-channel delivery remains a
/// valid future extension that would reintroduce a channel/status pair
/// without disturbing this shape.
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  type         NotificationType
  title        String
  message      String           @db.Text
  /// e.g. "SERVICE_REQUEST" | "QUOTE" | "CONVERSATION" | "APPOINTMENT" |
  /// "JOB" | "REVIEW" — free-text tag, not a DB enum, since new resource
  /// kinds may be added by future modules without a migration here.
  resourceType String?
  resourceId   String?
  /// Safe, internal-only path (see notification-rules.ts's isSafeActionUrl)
  /// — never an absolute/external URL, never javascript:/data:/vbscript:.
  actionUrl    String?
  metadata     Json?            @db.JsonB
  /// null = unread. Distinct from dismissedAt — a read notification still
  /// appears in the list until dismissed.
  readAt       DateTime?
  /// null = active. Non-null = soft-deleted; excluded from listings, unread
  /// counts, and mark-all-as-read. Never hard-deleted.
  dismissedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dismissedAt, createdAt])
  @@index([userId, readAt, dismissedAt])
  @@map("notifications")
}

// ============================================================================
// Trust & Safety
// ============================================================================

/// A KYC/verification document uploaded by a professional or company.
/// Same solo-pro-vs-company duality pattern (CHECK constraint in
/// migration). `reviewedByUserId` uses SetNull (not Restrict) — losing
/// the "who reviewed this" pointer if that admin account is later removed
/// is an acceptable trade-off; the document and its outcome remain intact.
model VerificationDocument {
  id                     String                      @id @default(uuid()) @db.Uuid
  professionalProfileId  String?                     @db.Uuid
  companyProfileId       String?                     @db.Uuid
  type                   VerificationDocumentType
  status                 VerificationDocumentStatus  @default(PENDING)
  fileUrl                String
  expiresAt              DateTime?
  reviewedByUserId       String?                     @db.Uuid
  reviewedAt             DateTime?
  rejectionReason        String?
  deletedAt              DateTime?

  professionalProfile ProfessionalProfile? @relation("DocumentOfProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("DocumentOfCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)
  reviewedBy          User?                @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([reviewedByUserId])
  @@index([status])
  @@map("verification_documents")
}

/// A dispute raised over a ServiceRequest (e.g. by the customer, over
/// quality or billing). Same solo-pro-vs-company duality on the
/// respondent side (CHECK constraint in migration). `resolvedByUserId`
/// uses SetNull for the same reason as VerificationDocument.reviewedBy.
model Dispute {
  id                                String             @id @default(uuid()) @db.Uuid
  serviceRequestId                 String             @db.Uuid
  raisedByUserId                   String             @db.Uuid
  respondentProfessionalProfileId  String?            @db.Uuid
  respondentCompanyProfileId       String?            @db.Uuid
  reason                            DisputeReason
  status                            DisputeStatus      @default(OPEN)
  resolution                        DisputeResolution?
  description                       String             @db.Text
  resolvedAt                        DateTime?
  resolvedByUserId                  String?            @db.Uuid

  serviceRequest         ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  raisedBy                User                 @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  respondentProfessional  ProfessionalProfile? @relation("DisputeRespondentProfessional", fields: [respondentProfessionalProfileId], references: [id], onDelete: Restrict)
  respondentCompany       CompanyProfile?      @relation("DisputeRespondentCompany", fields: [respondentCompanyProfileId], references: [id], onDelete: Restrict)
  resolvedBy               User?               @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  evidence DisputeEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([raisedByUserId])
  @@index([resolvedByUserId])
  @@index([status])
  @@index([respondentProfessionalProfileId])
  @@index([respondentCompanyProfileId])
  @@map("disputes")
}

/// Supporting evidence (photos, documents) submitted for a Dispute by
/// either party. Cascades with its parent dispute.
model DisputeEvidence {
  id                 String  @id @default(uuid()) @db.Uuid
  disputeId          String  @db.Uuid
  submittedByUserId  String  @db.Uuid
  fileUrl            String
  description        String?

  dispute         Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedByUser User    @relation("EvidenceSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disputeId])
  @@index([submittedByUserId])
  @@map("dispute_evidence")
}

// ============================================================================
// Platform / Audit
// ============================================================================

/// Append-only audit trail of significant actions across the platform.
/// Deliberately has NO `updatedAt` and NO soft delete — an audit log
/// entry that could be edited or hidden after the fact would defeat its
/// entire purpose. `actorUserId` is nullable + SetNull for
/// system-initiated actions (e.g. an expired-request cron job) that have
/// no human actor. `entityType`/`entityId` form a lightweight polymorphic
/// reference (e.g. entityType="ServiceRequest") rather than one FK column
/// per possible entity, since virtually every table in this schema could
/// need to be audited.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorUserId String?       @db.Uuid
  action     AuditLogAction
  entityType String
  entityId   String?        @db.Uuid
  metadata   Json?          @db.JsonB
  ipAddress  String?
  userAgent  String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
