// ============================================================================
// MaestroYa — Marketplace Domain Model
// ============================================================================
//
// Scope note (Phase 1): this file defines the complete data model only.
// No API, UI, pages, or business logic live here or were added elsewhere.
// See docs/DOMAIN_MODEL.md for a full explanation of every model and the
// reasoning behind each cascading/indexing decision.
//
// Two reference tables — Language and Role — were added beyond the
// requested 26 models. They aren't marketplace entities in their own
// right, but the task explicitly asks to seed "Languages" and "Roles",
// and seeding requires a table to seed into. Flagged here for visibility.
//
// Four more reference tables — Country, Province, City, PlatformSetting —
// were added in a later pass for the same reason: a task explicitly asked
// to seed Spain/Valencia/Gandia and platform settings, and Address stores
// geography as free-text with nothing to seed a lookup table into. See
// docs/DOMAIN_MODEL.md for details on why these stay independent of
// Address rather than replacing its free-text fields.
//
// A handful of CHECK constraints (e.g. "exactly one of professionalProfileId
// / companyProfileId must be set") can't be expressed in Prisma's schema
// language and are instead added via raw SQL in the migration — see
// prisma/migrations/20260717000000_init_domain_model/migration.sql.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth.js (next-auth) required models
// https://authjs.dev/getting-started/adapters/prisma
//
// Field names/shapes are fixed by the adapter and must not change. The one
// modification made here is switching User/Account/Session ids from cuid()
// to uuid() so every primary key in the schema is a UUID, per Phase 1's
// requirements — Auth.js does not care which id-generation strategy is used.
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // --- Marketplace fields (added in Phase 1) ---
  phone            String?    @unique
  phoneVerifiedAt  DateTime?
  status           UserStatus @default(PENDING_VERIFICATION)
  /// Professional Onboarding: see SignupIntent's own doc comment. Null for
  /// every user who never went through the "Soy profesional" CTA (i.e.
  /// every user before this feature existed, and every ordinary customer
  /// signup) — absence carries no meaning beyond "not currently mid-way
  /// through professional onboarding."
  signupIntent     SignupIntent?
  preferredLanguageId String? @db.Uuid
  /// Module 29 — Internationalization: the user's chosen **interface**
  /// language, stored as a plain ISO 639-1 locale code ("es", "en", "uk",
  /// "cs", "de", "fr", "it", "pt", "ro", "pl").
  ///
  /// Deliberately a new code column rather than a reuse of the
  /// `preferredLanguageId` FK above. Those are two different concepts that
  /// happen to share a word:
  ///  - `preferredLanguageId` -> `Language` reference table: a *seeded
  ///    marketplace lookup* ("which languages does this person speak/prefer
  ///    to be contacted in"), rows of which are administrator-managed data
  ///    and may include languages the UI has no translations for at all
  ///    (e.g. "ca").
  ///  - `preferredLocale`: a *product/UI capability* — it may only ever
  ///    hold a code that the app actually ships translation files for (see
  ///    `SUPPORTED_LOCALES` in src/shared/i18n/locales.ts). Adding a new
  ///    interface language must be a "drop in translation files" change,
  ///    never "insert a row and hope the UI has messages for it".
  /// Coupling the two would make every new interface language depend on a
  /// data migration and would let an admin break the UI by deactivating a
  /// `Language` row. See docs/MODULE_29_INTERNATIONALIZATION.md §4.
  ///
  /// Null means "never chosen explicitly" — resolution then falls through
  /// to the cookie/`Accept-Language`/Spanish chain, it does NOT mean
  /// Spanish. Validation of the value lives at the application edge
  /// (`languagePreferenceSchema`), not in a Postgres enum, precisely so
  /// adding a locale stays code-only with no migration.
  preferredLocale  String?    @db.VarChar(10)
  timezone         String?
  notificationPreferences Json? @db.JsonB
  lastLoginAt      DateTime?
  deletedAt        DateTime? // soft delete — see docs/DOMAIN_MODEL.md "Why soft-delete users"

  // --- Authentication fields (added in Authentication module) ---
  // Nullable: users who only ever sign in via OAuth (Google/Apple/Facebook)
  // never get one. Never store or return this field outside the auth
  // module's own password-verification code path.
  passwordHash String?

  accounts Account[]
  sessions Session[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]

  preferredLanguage Language? @relation(fields: [preferredLanguageId], references: [id], onDelete: SetNull)
  roles             UserRole[]
  customerProfile     CustomerProfile?
  professionalProfile ProfessionalProfile?
  companyMemberships  CompanyMember[]
  addresses           Address[]

  ownedCompanies         CompanyProfile[]      @relation("CompanyOwner")
  /// Module 18 — Company Professional.
  reviewedCompanyVerifications CompanyVerification[] @relation("CompanyVerificationReviewer")
  companyInvitationsReceived   CompanyInvitation[]   @relation("CompanyInvitationInvitedUser")
  companyInvitationsSent       CompanyInvitation[]   @relation("CompanyInvitationInvitedBy")
  submittedQuotes        Quote[]               @relation("QuoteSubmittedBy")
  conversationMembers    ConversationMember[]
  sentMessages           Message[]             @relation("MessageSender")
  writtenReviews         Review[]              @relation("ReviewAuthor")
  payments               Payment[]             @relation("PaymentPayer")
  requestedRefunds       Refund[]              @relation("RefundRequestedBy")
  notifications          Notification[]
  reviewedDocuments      VerificationDocument[] @relation("DocumentReviewer")
  /// Professional Verification module (Module 17): verification cases this
  /// admin has reviewed. SetNull on delete — losing the reviewer pointer is
  /// acceptable; the case and its outcome remain intact.
  reviewedVerifications  ProfessionalVerification[] @relation("VerificationReviewer")
  raisedDisputes         Dispute[]              @relation("DisputeRaisedBy")
  resolvedDisputes       Dispute[]              @relation("DisputeResolvedBy")
  closedDisputes         Dispute[]              @relation("DisputeClosedBy")
  assignedDisputes       Dispute[]              @relation("DisputeAssignedAdmin")
  submittedDisputeEvidence DisputeEvidence[]    @relation("EvidenceSubmittedBy")
  disputeMessages        DisputeMessage[]       @relation("DisputeMessageAuthor")
  /// Module 21 — Disputes & Support: general (non-order-tied) support tickets.
  openedSupportTickets    SupportTicket[]        @relation("SupportTicketOpenedBy")
  assignedSupportTickets  SupportTicket[]        @relation("SupportTicketAssignedAdmin")
  /// Module 22 — Commission & Financial: financial adjustments (refunds,
  /// commission reversals, etc.) requested by this user — almost always an
  /// admin/support agent acting on a resolved Dispute, occasionally a
  /// customer-initiated refund request. See FinancialAdjustment's doc
  /// comment.
  requestedFinancialAdjustments FinancialAdjustment[] @relation("FinancialAdjustmentRequestedBy")
  resolvedSupportTickets  SupportTicket[]        @relation("SupportTicketResolvedBy")
  closedSupportTickets    SupportTicket[]        @relation("SupportTicketClosedBy")
  auditLogEntries        AuditLog[]
  /// Module 24 — Security & Anti-Abuse.
  securityEvents             SecurityEvent[]
  accountRestrictions        AccountRestriction[]   @relation("AccountRestrictionSubject")
  accountRestrictionsCreated AccountRestriction[]   @relation("AccountRestrictionCreatedBy")
  proposedAppointments   Appointment[]          @relation("AppointmentProposedBy")
  cancelledAppointments  Appointment[]          @relation("AppointmentCancelledBy")
  /// Order / Job Lifecycle module (Module 11).
  startedJobs            Job[]                  @relation("JobStartedBy")
  completedJobs          Job[]                  @relation("JobCompletedBy")
  cancelledJobs          Job[]                  @relation("JobCancelledBy")
  /// Module 38 — GDPR Compliance.
  consents               Consent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([preferredLanguageId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Authentication module — Credentials auth support
//
// VerificationToken above is Auth.js-managed (reserved for its own
// Email/magic-link provider if one is ever added). The three models below
// are deliberately separate and owned entirely by this module's own code,
// to avoid two different systems writing to the same table for different
// purposes.
// ============================================================================

/// Single-use token proving control of an email address at registration
/// time (Credentials/email-password signup, distinct from Auth.js's own
/// magic-link VerificationToken). Consumed (deleted) on successful
/// verification; expired rows are safe to garbage-collect periodically.
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique /// SHA-256 of the token — the raw token is never stored
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Single-use token for the forgot-password → reset-password flow. Same
/// hash-at-rest treatment as EmailVerificationToken.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Long-lived, revocable refresh token backing the "Remember me" /
/// refresh-token requirement. Auth.js's own session JWT (short-lived,
/// stateless) stays the primary web-session mechanism — this table exists
/// so that mechanism can be *revoked* server-side (sign out everywhere,
/// ban a user mid-session) despite JWTs otherwise being stateless, and so
/// non-browser clients (a future mobile app) have a real refresh flow.
/// Rotated on every use (old row deleted, new row issued) so a stolen,
/// already-used refresh token is detectably invalid.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// Reference / lookup data (seeded — not marketplace entities per se)
// ============================================================================

/// Platform/interface language reference data — used for the platform
/// language picker (see User.preferredLanguageId), NOT a professional
/// "languages I speak with customers" feature. ProfessionalProfile
/// deliberately has no relation to this model; see migration
/// 20260807000000_remove_professional_languages, which dropped the
/// short-lived `_ProfessionalLanguages` join table.
model Language {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique /// ISO 639-1, e.g. "es", "en", "ca"
  name       String  /// English name, e.g. "Spanish"
  nativeName String  /// Native name, e.g. "Español"
  isActive   Boolean @default(true)
  /// Platform-language display priority (lower sorts first) — the picker
  /// orders by this, then by `name`, rather than relying on alphabetical
  /// order alone. See migration 20260806000000_add_language_sort_order.
  sortOrder  Int     @default(0)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

/// Platform roles for RBAC. Kept as seeded data (not a hardcoded enum) so
/// new roles (e.g. "SUPPORT") can be added without a schema migration.
/// A user can hold multiple roles at once — e.g. someone can be both a
/// CUSTOMER and a PROFESSIONAL on the same account.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique /// e.g. "CUSTOMER", "PROFESSIONAL", "ADMIN"
  name        String
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Join table: which roles a user holds.
model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Normalized geographic reference data (country → province → city), used
/// for structured location pickers/filtering. Deliberately independent of
/// Address, which keeps storing free-text city/province/country — linking
/// Address to this hierarchy (e.g. replacing Address.city with a FK) is a
/// bigger structural change than "add a seed script" and is left for a
/// deliberate future decision rather than made silently here.
model Country {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique /// ISO 3166-1 alpha-2, e.g. "ES"
  name String

  provinces Province[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model Province {
  id        String @id @default(uuid()) @db.Uuid
  countryId String @db.Uuid
  name      String

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([countryId])
  @@map("provinces")
}

model City {
  id         String @id @default(uuid()) @db.Uuid
  provinceId String @db.Uuid
  name       String

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

/// Platform-wide configuration as key/value rows (commission rate,
/// support email, feature flags, etc.) rather than hardcoded constants —
/// lets ops change these without a deploy. `value` is Json so a single
/// table can hold settings of any shape (a number, a string, an object).
model PlatformSetting {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  value       Json    @db.JsonB
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ============================================================================
// Enums
// ============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

/// Professional Onboarding: a *temporary routing flag* only, set when a
/// user registers via the "Soy profesional" CTA. It never replaces or
/// duplicates the role system (see UserRole/Role) — it exists purely so
/// middleware.ts can resume an interrupted onboarding (redirect back to
/// /dashboard/professional/onboarding on next login) for a user who
/// intended to become a professional but hasn't been granted the
/// PROVIDER role yet. Cleared (set back to null) the moment onboarding
/// completes; from then on PROVIDER role membership alone is the single
/// source of truth for "is this user a professional."
enum SignupIntent {
  CUSTOMER
  PROFESSIONAL
}

/// Module 18 — Company Professional: MANAGER added between ADMIN and MEMBER
/// (additive enum value — safe, non-breaking for existing OWNER/ADMIN/MEMBER
/// rows). See docs/MODULE_18_COMPANY_PROFESSIONAL.md for the full permission
/// matrix.
enum CompanyMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

/// Module 18 — Company Professional: lifecycle status of a CompanyProfile,
/// mirroring ProfessionalStatus's role for individual professionals but with
/// an explicit PENDING state (a company profile can exist — created by its
/// owner — before it is accepting public work, e.g. while verification is
/// still in progress).
enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Module 18 — Company Professional: lifecycle of a single company
/// membership invitation. Deliberately its own enum, not reusing
/// CompanyMemberRole or CompanyStatus — an invitation has its own state
/// machine (see company-invitation-rules.ts).
enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Module 18 — Company Professional: state machine for a CompanyVerification
/// case. Intentionally a separate enum from ProfessionalVerificationStatus
/// (Module 17) even though the values are identical — avoids coupling a
/// company-verification schema change to renaming/touching Module 17's enum,
/// which stays untouched. See company-verification-rules.ts (mirrors
/// professional-verification-rules.ts's transition map).
enum VerificationCaseStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  EXPIRED
}

enum AddressType {
  HOME
  WORK
  BILLING
  SERVICE_LOCATION
  OTHER
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Professional Module: lifecycle status of an individual professional's
/// profile, distinct from `verificationStatus` (trust/identity checks).
enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Professional Module: identity/trust verification state. Admin-only
/// future workflow moves a profile through PENDING -> VERIFIED/REJECTED;
/// professionals themselves can never set this field.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

/// Order / Job Lifecycle module (Module 11) note: IN_PROGRESS/COMPLETED
/// remain reserved-but-unused here by deliberate decision — Module 11
/// introduces Job.status as the authoritative execution-lifecycle field
/// instead (see JobStatus and domain/services/job-state.ts). This module
/// never writes ServiceRequest to IN_PROGRESS or COMPLETED as a side effect
/// of any Job/Appointment transition.
enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum QuoteStatus {
  PENDING
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

/// Module 22 — Commission & Financial: see QuoteItem.category's doc
/// comment. Deliberately just these two values — the business model only
/// ever needs "is this commissionable labor or excluded materials," not a
/// richer taxonomy (call-out fees, etc. are treated as LABOR unless a
/// future product decision says otherwise).
enum QuoteItemCategory {
  LABOR
  MATERIALS
}

enum AppointmentStatus {
  /// Booking/Appointments module (MVP): the Appointment row created the
  /// moment a Quote is accepted, before any actual scheduling has happened.
  /// Added because the original enum had no state representing "exists but
  /// unscheduled" — see prisma/migrations/20260723000000_add_appointment_pending_schedule
  /// for why this was unavoidable. A future scheduling module transitions
  /// this to SCHEDULED once `scheduledStart` is actually set.
  PENDING_SCHEDULE
  /// Deprecated/unused: superseded by the PROPOSED/CONFIRMED distinction
  /// added by the Booking & Scheduling module (Module 10) — see
  /// domain/services/appointment-state.ts. Kept on the enum only for
  /// backward compatibility with the value already shipped in the initial
  /// migration; no code writes it.
  SCHEDULED
  /// Booking & Scheduling module (Module 10): one party (customer or
  /// professional) has put forward a `[proposedStart, proposedEnd)` window
  /// that the other party has not yet confirmed. See
  /// domain/services/appointment-state.ts for the full transition rules.
  PROPOSED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

/// Booking & Scheduling module (Module 10): typed reason recorded when an
/// Appointment is cancelled — kept as a closed enum (rather than free text)
/// so a future Payment/Stripe Connect module can automate refund-eligibility
/// decisions from it without parsing prose. `cancellationNote` on
/// Appointment still carries optional free-text detail alongside this.
enum AppointmentCancellationReason {
  CUSTOMER_REQUEST
  PROFESSIONAL_UNAVAILABLE
  SCHEDULING_CONFLICT
  OTHER
}

/// Order / Job Lifecycle module (Module 11): the execution-lifecycle status
/// of a Job. Deliberately smaller than the full hypothetical lifecycle
/// (no separate SCHEDULED — that remains Appointment's job, see Module 10)
/// and deliberately does not reuse ServiceRequestStatus.IN_PROGRESS/
/// COMPLETED (see ServiceRequestStatus's own doc note) — Job.status is the
/// single authoritative execution-lifecycle field. COMPLETED and CANCELLED
/// are terminal; see domain/services/job-state.ts for the full transition
/// rules.
enum JobStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Order / Job Lifecycle module (Module 11): typed reason recorded when a
/// Job is cancelled — same "closed enum, not free text" pattern as
/// AppointmentCancellationReason, so a future Payment/Stripe Connect module
/// can automate refund-eligibility decisions from it without parsing
/// prose. `cancellationNote` on Job still carries optional free-text detail
/// alongside this.
enum JobCancellationReason {
  CUSTOMER_REQUEST
  PROFESSIONAL_UNABLE_TO_COMPLETE
  SERVICE_REQUEST_ISSUE
  OTHER
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

/// Booking & Scheduling module (Module 10): distinguishes a normal
/// user-authored chat message from an automated, informational one the
/// Booking module posts into an existing Conversation (appointment
/// proposed/confirmed/cancelled/rescheduled — see
/// application/ports/appointment-notifier.ts and
/// ChatAppointmentNotifier). SYSTEM messages are still attributed to the
/// user whose action triggered them (`Message.senderId`) — there is no
/// separate platform/system User account — `type` is what lets the UI
/// render them differently (e.g. centered, non-bubble) and lets other code
/// distinguish them without parsing message bodies. Booking never mutates
/// Conversation/Message state directly beyond calling
/// MessageRepository.create with this type — Chat owns its own schema and
/// persistence.
enum MessageType {
  USER
  SYSTEM
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  FLAGGED
  REMOVED
}

enum PaymentMethodType {
  CARD
  SEPA_DEBIT
  BANK_TRANSFER
  WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Module 22 — Commission & Financial extends this enum with more granular
/// ledger entry types (see docs/MODULE_22_COMMISSION_FINANCIAL.md's ledger
/// section) so `Transaction.type` alone is enough to reconstruct a
/// commission breakdown without re-deriving it from Quote/Payment every
/// time. CHARGE/REFUND/PAYOUT/COMMISSION/ADJUSTMENT were already defined
/// (unused, schema-only) before this module — kept for backward
/// compatibility; new code should prefer the more specific values below.
enum TransactionType {
  CHARGE
  REFUND
  PAYOUT
  COMMISSION
  ADJUSTMENT
  /// The labor portion of a captured Payment — the commission base.
  LABOR_CHARGE
  /// The materials portion of a captured Payment — never commissionable.
  MATERIALS_CHARGE
  /// The 7.5%-of-labor fee charged to the customer (see commission-policy.ts).
  CUSTOMER_PLATFORM_FEE
  /// The professional's/company's earnings after their own 7.5% commission
  /// is deducted from the labor amount.
  PROFESSIONAL_NET_EARNING
  /// MaestroYa's own gross revenue recognized from a Payment (customer
  /// platform fee + professional commission).
  PLATFORM_REVENUE
  /// A previously recognized Commission being reversed (e.g. a dispute
  /// resolved in the customer's favor after the commission was recorded).
  COMMISSION_REVERSAL
  /// A financial consequence of a resolved Dispute — see
  /// FinancialAdjustment.
  DISPUTE_ADJUSTMENT
  /// A previously recorded Payout being reversed/clawed back.
  PAYOUT_REVERSAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum CommissionStatus {
  PENDING
  INVOICED
  SETTLED
  WAIVED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELLED
}

/// Module 22 — Commission & Financial: the fixed vocabulary of financial
/// consequences a resolved Dispute (Module 21) can trigger. See
/// FinancialAdjustment's own doc comment.
enum FinancialAdjustmentType {
  FULL_REFUND
  PARTIAL_REFUND
  PROFESSIONAL_PAYOUT_REDUCTION
  PROFESSIONAL_PAYOUT_RELEASE
  CUSTOMER_COMPENSATION
  PLATFORM_FEE_REFUND
  COMMISSION_REVERSAL
}

enum FinancialAdjustmentStatus {
  PENDING
  APPLIED
  REJECTED
  FAILED
}

enum RefundReason {
  DUPLICATE
  FRAUDULENT
  REQUESTED_BY_CUSTOMER
  SERVICE_NOT_RENDERED
  QUALITY_ISSUE
  OTHER
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

/// Notifications module (Module 15): one value per real, currently
/// implemented trigger point — see docs/MODULE_15_NOTIFICATIONS.md
/// "Notification Types" for exactly which use case creates each one.
/// This replaces the Phase-1 placeholder enum (SERVICE_REQUEST_UPDATE,
/// QUOTE_RECEIVED, APPOINTMENT_REMINDER, MESSAGE_RECEIVED,
/// PAYMENT_RECEIVED, PAYOUT_PROCESSED, DISPUTE_UPDATE, SYSTEM, MARKETING),
/// none of which had a real trigger anywhere in the codebase yet — see the
/// module doc's "Deferred Functionality" section for why each was dropped
/// rather than kept unused (no professional-matching mechanism for a new
/// ServiceRequest, Payments/Disputes/Admin are out of Module 15's scope
/// per the module boundary, and there is no sender for MARKETING).
enum NotificationType {
  NEW_QUOTE
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  NEW_MESSAGE
  APPOINTMENT_PROPOSED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  JOB_STARTED
  JOB_COMPLETED
  JOB_CANCELLED
  REVIEW_RECEIVED
  /// Professional Verification module (Module 17): one value per real
  /// trigger point — see docs/MODULE_17_PROFESSIONAL_VERIFICATION.md. The
  /// recipient is always the owning professional's User (never an admin or
  /// arbitrary user).
  VERIFICATION_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  VERIFICATION_RESUBMISSION_REQUIRED
  /// Module 18 — Company Professional: one value per real trigger point —
  /// see docs/MODULE_18_COMPANY_PROFESSIONAL.md. Recipients: the invited
  /// user (COMPANY_INVITATION_RECEIVED), the company owner/admins
  /// (COMPANY_INVITATION_ACCEPTED/DECLINED, COMPANY_MEMBER_REMOVED), the
  /// owning company's owner (COMPANY_VERIFICATION_*, COMPANY_SUSPENDED,
  /// COMPANY_REACTIVATED).
  COMPANY_INVITATION_RECEIVED
  COMPANY_INVITATION_ACCEPTED
  COMPANY_INVITATION_DECLINED
  COMPANY_MEMBER_REMOVED
  COMPANY_MEMBER_ROLE_CHANGED
  COMPANY_VERIFICATION_SUBMITTED
  COMPANY_VERIFICATION_APPROVED
  COMPANY_VERIFICATION_REJECTED
  COMPANY_VERIFICATION_RESUBMISSION_REQUIRED
  COMPANY_SUSPENDED
  COMPANY_REACTIVATED
  /// Module 21 — Disputes & Support: one value per real trigger point —
  /// see docs/MODULE_21_DISPUTES_SUPPORT.md, "Notifications". Recipients:
  /// the dispute's respondent (DISPUTE_CREATED), the assigned admin
  /// (DISPUTE_ASSIGNED — sent to the admin, not the parties), both parties
  /// (DISPUTE_STATUS_CHANGED, DISPUTE_RESOLVED, DISPUTE_REJECTED,
  /// DISPUTE_CLOSED), and specifically whichever party is being asked to
  /// respond (DISPUTE_RESPONSE_REQUESTED).
  DISPUTE_CREATED
  DISPUTE_ASSIGNED
  DISPUTE_STATUS_CHANGED
  DISPUTE_RESPONSE_REQUESTED
  DISPUTE_RESOLVED
  DISPUTE_REJECTED
  DISPUTE_CLOSED
  /// Module 21 — Disputes & Support: SupportTicket events. Recipients: the
  /// assigned admin (SUPPORT_TICKET_ASSIGNED) and the ticket's opener
  /// (every other value).
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_ASSIGNED
  SUPPORT_TICKET_STATUS_CHANGED
  SUPPORT_TICKET_RESOLVED
  SUPPORT_TICKET_CLOSED
  /// Module 28 — Workflow Completion: fired by the daily expiration cron —
  /// see docs/MODULE_28_WORKFLOW_COMPLETION.md, "Notifications". Recipients:
  /// the ServiceRequest's customer (SERVICE_REQUEST_EXPIRED), the Quote's
  /// submitting professional (QUOTE_EXPIRED), the owning professional
  /// (VERIFICATION_EXPIRED) or the owning company's members
  /// (COMPANY_VERIFICATION_EXPIRED) — naming mirrors the existing
  /// VERIFICATION_*/COMPANY_VERIFICATION_* split from Module 17/18 rather
  /// than a single combined value.
  SERVICE_REQUEST_EXPIRED
  QUOTE_EXPIRED
  VERIFICATION_EXPIRED
  COMPANY_VERIFICATION_EXPIRED
  /// Module 41 — Reviews & Ratings: sent to the original reviewer when the
  /// reviewed professional posts or edits a public reply to their review.
  REVIEW_RESPONSE_ADDED
}

enum VerificationDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  INSURANCE_CERTIFICATE
  PROFESSIONAL_CERTIFICATION
  PROOF_OF_ADDRESS
  OTHER
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Professional Verification module (Module 17): the lifecycle of a single
/// professional's identity/trust verification *case* — a deliberately
/// explicit state machine rather than the coarse UNVERIFIED/PENDING/
/// VERIFIED/REJECTED VerificationStatus that lives on ProfessionalProfile
/// (that enum stays the *public* trust signal the discovery/profile badge
/// reads; this one drives the internal review workflow). DRAFT is the
/// pre-submission state a professional assembles documents in before ever
/// entering the admin queue — it isn't in the original spec's six statuses,
/// but the spec's own Create → Upload → Submit use-case split requires a
/// state that exists before submission, so it's added here (see
/// professional-verification-rules.ts for the full transition map and
/// docs/MODULE_17_PROFESSIONAL_VERIFICATION.md for the rationale). A
/// professional has at most one non-EXPIRED case at a time (partial unique
/// index, added in the migration).
enum ProfessionalVerificationStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  EXPIRED
}

/// Module 21 — Disputes & Support: controlled reason list for a Dispute,
/// reconciled from the Module 01 scaffold toward home-services-marketplace
/// vocabulary (see docs/MODULE_21_DISPUTES_SUPPORT.md, "Categories" for the
/// full mapping). Since this enum was never referenced by application code
/// before this module, values are renamed in place rather than kept
/// side-by-side with new ones: QUALITY_ISSUE -> SERVICE_QUALITY,
/// DAMAGE_CLAIM -> PROPERTY_DAMAGE, BILLING_ISSUE -> PRICE_DISAGREEMENT,
/// BEHAVIOR_ISSUE -> COMMUNICATION_ISSUE. PROFESSIONAL_NO_SHOW,
/// CUSTOMER_NO_SHOW and SCOPE_OF_WORK are new. SERVICE_NOT_COMPLETED and
/// OTHER are unchanged.
enum DisputeReason {
  SERVICE_NOT_COMPLETED
  SERVICE_QUALITY
  PROPERTY_DAMAGE
  PROFESSIONAL_NO_SHOW
  CUSTOMER_NO_SHOW
  PRICE_DISAGREEMENT
  SCOPE_OF_WORK
  COMMUNICATION_ISSUE
  OTHER
}

/// Module 21 — Disputes & Support: lifecycle status. AWAITING_RESPONSE
/// (Module 01 scaffold) is split into WAITING_FOR_CUSTOMER /
/// WAITING_FOR_PROFESSIONAL so a case's queue position always shows whose
/// turn it is to act; REJECTED is added (an admin can decline to uphold a
/// dispute without it having been "resolved" in anyone's favor); ESCALATED
/// is removed as a status — "escalated outside the platform" is now
/// expressed via DisputeResolution.ESCALATED_EXTERNALLY on a
/// RESOLVED/CLOSED case instead of a separate status, since it is an
/// outcome, not an in-progress state. See dispute-state.ts for the full
/// transition whitelist.
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_FOR_CUSTOMER
  WAITING_FOR_PROFESSIONAL
  RESOLVED
  REJECTED
  CLOSED
}

/// Module 21 — Disputes & Support: the *business-level* outcome of a
/// Dispute — never a Stripe/payment action. Renamed from the Module 01
/// scaffold's payment-action vocabulary (REFUND_CUSTOMER/PAY_PROFESSIONAL/
/// PARTIAL_REFUND) to outcome vocabulary a future Module 22 (financial
/// settlement) can consume without Module 21 ever executing money movement
/// itself: REFUND_CUSTOMER -> CUSTOMER_FAVOR, PAY_PROFESSIONAL ->
/// PROFESSIONAL_FAVOR, PARTIAL_REFUND -> PARTIAL_RESOLUTION.
/// FINANCIAL_ADJUSTMENT_REQUIRED is new — a generic "Module 22 must act"
/// flag distinct from the customer/professional-favor outcomes. NO_ACTION
/// and ESCALATED_EXTERNALLY are unchanged.
enum DisputeResolution {
  NO_ACTION
  CUSTOMER_FAVOR
  PROFESSIONAL_FAVOR
  PARTIAL_RESOLUTION
  FINANCIAL_ADJUSTMENT_REQUIRED
  ESCALATED_EXTERNALLY
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Module 21 — Disputes & Support: general (non-order-tied) support issues
/// — account problems, verification issues, bugs, login problems, general
/// questions. Kept as a separate model from Dispute (see
/// docs/MODULE_21_DISPUTES_SUPPORT.md, "Support Tickets vs Disputes") since
/// it has no order/job anchor and a different field set, while sharing the
/// same lifecycle *shape* (open -> in progress -> waiting -> resolved ->
/// closed), the same admin workflow, notification and audit-log
/// conventions as Dispute.
enum SupportTicketCategory {
  ACCOUNT
  VERIFICATION
  BUG
  LOGIN
  GENERAL
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT
  PAYOUT
  VERIFICATION
  OTHER
}

// ============================================================================
// Identity & Profiles
// ============================================================================

/// A saved address, owned by a user. Reused as billing addresses, service
/// locations, etc. Soft-deleted (not hard-deleted) because ServiceRequest
/// and Appointment keep a Restrict-protected FK to specific addresses for
/// historical accuracy — removing an address from an active address book
/// should not corrupt past job records.
model Address {
  id      String      @id @default(uuid()) @db.Uuid
  userId  String      @db.Uuid
  type    AddressType
  label   String?
  line1   String
  line2   String?
  city    String
  province String?
  postalCode String
  country String  @default("ES")
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerProfilesDefaultingHere CustomerProfile[]
  serviceRequests                ServiceRequest[]
  appointments                   Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deletedAt])
  /// Search & Ranking module (Module 19): supports city-based location
  /// matching in ProfessionalDiscoveryRepository.searchCandidates without a
  /// full table scan.
  @@index([city])
  /// Maps & Geolocation module (Module 20): supports the bounding-box radius
  /// pre-filter (computeBoundingBox) in
  /// ProfessionalDiscoveryRepository.searchCandidates.
  @@index([latitude, longitude])
  @@map("addresses")
}

/// Customer-specific extension of User. Deliberately thin — most identity
/// data lives on User itself; this only holds fields meaningful to the
/// "requests services" side of the marketplace.
model CustomerProfile {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @unique @db.Uuid
  defaultAddressId String? @db.Uuid
  marketingOptIn   Boolean @default(false)
  notes            String? @db.Text
  deletedAt        DateTime?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress Address? @relation(fields: [defaultAddressId], references: [id], onDelete: SetNull)

  serviceRequests ServiceRequest[]
  /// Order / Job Lifecycle module (Module 11).
  jobs            Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultAddressId])
  @@index([deletedAt])
  @@map("customer_profiles")
}

/// An individual freelance professional (not affiliated with a company).
/// Holds everything specific to "offers services solo": rate, radius,
/// verification/trust signals, and the Stripe Connect account payouts go to.
///
/// Verification note (Professional Module): `verificationStatus` is the
/// single source of truth for trust/verification state — there is
/// deliberately no separate `isVerified` boolean, to avoid two fields that
/// could disagree. `verifiedAt` is only ever set when `verificationStatus`
/// transitions to VERIFIED. Verification itself remains an admin-only
/// future workflow; the Professional Module never sets this to VERIFIED
/// on its own.
model ProfessionalProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  bio                  String?  @db.Text
  headline             String?
  yearsExperience      Int?
  hourlyRate           Decimal? @db.Decimal(10, 2)
  serviceRadiusKm      Int?
  verifiedAt           DateTime?
  stripeConnectAccountId String? @unique
  averageRating        Decimal? @db.Decimal(3, 2)
  reviewCount          Int      @default(0)
  isAcceptingRequests  Boolean  @default(true)
  deletedAt            DateTime?

  // --- Professional Module fields (added in Professional Module) ---
  businessName       String?
  contactEmail       String?
  contactPhone       String?
  websiteUrl         String?
  taxId              String?              @unique
  status             ProfessionalStatus   @default(ACTIVE)
  verificationStatus VerificationStatus   @default(UNVERIFIED)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories ServiceCategory[] @relation("ProfessionalCategories")

  quotes                Quote[]
  appointments            Appointment[]
  /// Order / Job Lifecycle module (Module 11).
  jobs                    Job[]
  reviewsReceived        Review[]                @relation("ReviewOfProfessional")
  payouts                Payout[]                @relation("PayoutToProfessional")
  commissions             Commission[]            @relation("CommissionOnProfessional")
  verificationDocuments   VerificationDocument[]  @relation("DocumentOfProfessional")
  respondentInDisputes    Dispute[]               @relation("DisputeRespondentProfessional")
  /// Portfolio module (Module 14).
  portfolioItems          PortfolioItem[]
  /// Professional Verification module (Module 17): the professional's
  /// verification case history (at most one non-EXPIRED at a time).
  verifications           ProfessionalVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([status])
  @@index([isAcceptingRequests])
  @@index([deletedAt])
  /// Search & Ranking module (Module 19): supports `minRating` filtering in
  /// ProfessionalDiscoveryRepository.searchCandidates.
  @@index([averageRating])
  @@map("professional_profiles")
}

/// A company/business account. Companies act on requests through their
/// CompanyMember employees, but the business entity itself (legal name,
/// tax id, verification, Stripe Connect account) lives here.
model CompanyProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  ownerUserId            String   @db.Uuid
  legalName              String
  tradeName              String?
  taxId                  String   @unique /// CIF/NIF
  description            String?  @db.Text
  logoUrl                String?
  websiteUrl             String?
  stripeConnectAccountId String?  @unique
  isVerified             Boolean  @default(false)
  verifiedAt             DateTime?
  averageRating          Decimal? @db.Decimal(3, 2)
  reviewCount            Int      @default(0)
  isAcceptingRequests    Boolean  @default(true)
  deletedAt              DateTime?

  // --- Module 18 — Company Professional additions (additive, nullable) ---
  /// URL-safe public identifier for the company's public profile page
  /// (`/companies/[slug]`), same role `ServiceCategory.slug` plays. Nullable
  /// because no company existed before this module — backfilled lazily by
  /// CreateCompanyUseCase, never required to be set for a company to
  /// function internally.
  slug                String?       @unique
  contactEmail        String?
  contactPhone        String?
  addressLine         String?
  city                String?
  province            String?
  postalCode          String?
  country             String?       @default("ES")
  latitude            Float?
  longitude           Float?
  /// Explicit, domain-controlled lifecycle status — distinct from
  /// `isVerified` (trust signal) and `deletedAt` (hard removal). See
  /// company-rules.ts for the transition map.
  status              CompanyStatus @default(PENDING)
  suspendedAt         DateTime?

  owner   User             @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members CompanyMember[]

  categories ServiceCategory[] @relation("CompanyCategories")

  quotes                 Quote[]
  appointments             Appointment[]
  /// Order / Job Lifecycle module (Module 11).
  jobs                     Job[]
  reviewsReceived         Review[]                @relation("ReviewOfCompany")
  payouts                 Payout[]                @relation("PayoutToCompany")
  commissions              Commission[]            @relation("CommissionOnCompany")
  verificationDocuments    VerificationDocument[]  @relation("DocumentOfCompany")
  respondentInDisputes     Dispute[]               @relation("DisputeRespondentCompany")
  /// Module 18 — Company Professional.
  invitations              CompanyInvitation[]
  verifications            CompanyVerification[]
  /// Module 14 (extended by Module 18): a company-level portfolio, kept
  /// alongside the existing professional-anchored PortfolioItem rather than
  /// merging the two — see PortfolioItem.companyProfileId's own doc comment.
  portfolioItems           PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([isVerified])
  @@index([status])
  @@index([deletedAt])
  /// Search & Ranking module (Module 19): supports city/province location
  /// matching and `minRating` filtering in
  /// CompanyDiscoveryRepository.searchCandidates.
  @@index([city])
  @@index([province])
  @@index([averageRating])
  /// Maps & Geolocation module (Module 20): supports the bounding-box radius
  /// pre-filter (computeBoundingBox) in
  /// CompanyDiscoveryRepository.searchCandidates.
  @@index([latitude, longitude])
  @@map("company_profiles")
}

/// Module 18 — Company Professional: a secure invitation for an existing
/// MaestroYa user to join a company. Scope: existing users only (matches
/// the module's minimum requirement — email invitations to non-existing
/// users are deferred, see docs/MODULE_18_COMPANY_PROFESSIONAL.md). The
/// token is never stored in plaintext (`tokenHash`, SHA-256 — same
/// convention as EmailVerificationToken/PasswordResetToken/RefreshToken).
/// `invitedUserId` is resolved server-side from `email` at creation time —
/// never client-supplied. At most one PENDING invitation may exist per
/// (companyId, email) — enforced by a partial unique index added in the
/// migration (Prisma cannot express partial unique indexes natively; same
/// pattern as ProfessionalVerification's active-case index).
model CompanyInvitation {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @db.Uuid
  email           String
  invitedUserId   String?                 @db.Uuid
  invitedByUserId String                  @db.Uuid
  /// The role the invitee will hold once accepted. Can never be OWNER —
  /// ownership only changes via TransferCompanyOwnershipUseCase, enforced
  /// in company-invitation-rules.ts, never at the DB layer alone.
  role            CompanyMemberRole       @default(MEMBER)
  status          CompanyInvitationStatus @default(PENDING)
  tokenHash       String                  @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  cancelledAt     DateTime?

  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedUser User?          @relation("CompanyInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedBy   User           @relation("CompanyInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([invitedUserId])
  @@index([email])
  @@index([expiresAt])
  @@map("company_invitations")
}

/// Module 18 — Company Professional: a single verification *case* for a
/// CompanyProfile — the company-side mirror of Module 17's
/// ProfessionalVerification aggregate (same DRAFT→PENDING→UNDER_REVIEW→
/// APPROVED/REJECTED/RESUBMISSION_REQUIRED→EXPIRED lifecycle, see
/// company-verification-rules.ts), kept as its own model rather than adding
/// a nullable `companyProfileId` onto ProfessionalVerification — that model
/// is `professionalProfileId`-required and reused as-is by Module 17's own
/// tests/queries, so extending it would risk destabilizing a working
/// module for a field it never needed. A company holds at most one
/// non-EXPIRED case at a time — enforced by a partial unique index
/// (`company_verifications_active_unique`, hand-written in the migration).
model CompanyVerification {
  id               String                  @id @default(uuid()) @db.Uuid
  companyProfileId String                  @db.Uuid
  status           VerificationCaseStatus  @default(DRAFT)
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?                 @db.Uuid
  rejectionReason  String?                 @db.Text
  resubmissionReason String?               @db.Text
  expiresAt        DateTime?

  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  reviewedBy     User?          @relation("CompanyVerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  documents CompanyVerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyProfileId])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([status, submittedAt])
  @@map("company_verifications")
}

/// Module 18 — Company Professional: a document uploaded as part of a
/// CompanyVerification case — mirrors ProfessionalVerificationDocument
/// exactly, reusing the same VerificationDocumentType/VerificationDocumentStatus
/// enums (no parallel enums introduced). Cascades with its parent case.
model CompanyVerificationDocument {
  id               String                     @id @default(uuid()) @db.Uuid
  verificationId   String                     @db.Uuid
  type             VerificationDocumentType
  status           VerificationDocumentStatus @default(PENDING)
  fileUrl          String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  rejectionReason  String?                    @db.Text

  verification CompanyVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationId])
  @@index([type])
  @@map("company_verification_documents")
}

/// Join table: which users work for which company, and in what capacity.
/// `removedAt` is a purpose-named soft-delete — it marks when someone's
/// membership ended without deleting the row, preserving "who worked here
/// and when" for dispute/audit purposes.
model CompanyMember {
  id               String            @id @default(uuid()) @db.Uuid
  companyProfileId String            @db.Uuid
  userId           String            @db.Uuid
  role             CompanyMemberRole @default(MEMBER)
  invitedAt        DateTime          @default(now())
  joinedAt         DateTime?
  removedAt        DateTime?

  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, userId])
  @@index([userId])
  @@index([companyProfileId, removedAt])
  @@map("company_members")
}

// ============================================================================
// Service Catalog
// ============================================================================

/// Hierarchical service categories (e.g. "Fontanería" → "Reparación de
/// fugas"). Self-referencing for subcategories. Soft-deleted rather than
/// hard-deleted so historical ServiceRequests keep a valid category
/// reference even after a category is deprecated.
model ServiceCategory {
  id          String                 @id @default(uuid()) @db.Uuid
  parentId    String?                @db.Uuid
  name        String
  slug        String                 @unique
  description String?
  iconUrl     String?
  status      ServiceCategoryStatus  @default(ACTIVE)
  sortOrder   Int                    @default(0)
  deletedAt   DateTime?

  parent   ServiceCategory?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("CategoryToSubcategory")

  professionals ProfessionalProfile[] @relation("ProfessionalCategories")
  companies     CompanyProfile[]      @relation("CompanyCategories")
  serviceRequests ServiceRequest[]
  /// Portfolio module (Module 14). Optional — a portfolio item may tag
  /// itself with the category of work it showcases.
  portfolioItems PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([status])
  @@index([deletedAt])
  @@map("service_categories")
}

// ============================================================================
// Portfolio (Module 14)
// ============================================================================

/// Portfolio module (Module 14): a showcase item ("previous work") a
/// professional attaches to their own profile. Always anchored to exactly
/// one ProfessionalProfile — never to a CompanyProfile (this codebase only
/// supports solo professionals end-to-end today, same scope note as
/// Review.revieweeProfessionalProfileId; see review-repository.ts) and
/// never editable/deletable by anyone but its owner.
///
/// `mediaUrl` is a plain URL string, not a stored file — Module 14 does not
/// introduce a new media/storage abstraction (an upload UI/flow is
/// explicitly deferred; see docs/MODULE_14_PORTFOLIO.md). When an upload
/// flow is eventually built, it can reuse the existing Cloudinary adapter
/// (see src/core/infrastructure/storage/cloudinary) and hand this field the
/// resulting `secure_url`, exactly like Address/ServiceRequest photos do
/// today — no schema change required.
///
/// `serviceCategoryId` is optional and `onDelete: SetNull` — unlike
/// ServiceRequest.categoryId (Restrict, since a request's category is
/// load-bearing for matching/history), a portfolio item's category tag is
/// purely descriptive, so a deprecated category should never block a
/// professional from managing their own portfolio.
///
/// Soft-deleted via `deletedAt` (never a hard delete) — same convention as
/// Address/Message/ProfessionalProfile elsewhere in this schema.
model PortfolioItem {
  id                    String    @id @default(uuid()) @db.Uuid
  /// Module 18 — Company Professional: made optional (was required) so a
  /// portfolio item can instead belong to a CompanyProfile. Exactly one of
  /// professionalProfileId/companyProfileId is set — enforced by a CHECK
  /// constraint added in the migration, same "exactly one" pattern as
  /// Quote/Job/Review. Every pre-existing row keeps its
  /// professionalProfileId unchanged; this is a nullability relaxation, not
  /// a data migration.
  professionalProfileId String?   @db.Uuid
  companyProfileId      String?   @db.Uuid
  serviceCategoryId     String?   @db.Uuid
  title                 String
  description           String?   @db.Text
  mediaUrl              String
  deletedAt             DateTime?

  /// Admin Panel (Module 16): admin content moderation, deliberately
  /// separate from `deletedAt` (owner-driven soft delete, Module 14).
  /// Non-null = an admin has hidden this item from public/professional
  /// listings; null = visible (default, unmoderated). Never set by the
  /// professional themselves — only ModeratePortfolioItemUseCase/
  /// RestorePortfolioItemUseCase (Admin Panel) write this field. Who
  /// moderated it and why is recorded on the append-only AuditLog, not
  /// denormalized here — same "narrow field, audit trail carries the
  /// detail" choice made for Review moderation (Review.status already
  /// existed pre-Module-16 and needed no schema change at all).
  moderatedAt DateTime?

  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  serviceCategory     ServiceCategory?     @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId, deletedAt, createdAt])
  @@index([companyProfileId, deletedAt, createdAt])
  @@index([serviceCategoryId])
  @@index([moderatedAt])
  @@map("portfolio_items")
}

// ============================================================================
// Requests, Quotes & Scheduling
// ============================================================================

/// A customer's request for a service — the core "job posting" of the
/// marketplace. FKs to CustomerProfile/ServiceCategory/Address are Restrict
/// (not Cascade): a request is a historical/financial record and must not
/// silently disappear if, say, an address is later removed from a user's
/// address book — removal there is itself soft-deleted for this reason.
model ServiceRequest {
  id               String                @id @default(uuid()) @db.Uuid
  customerId       String                @db.Uuid
  categoryId       String                @db.Uuid
  addressId        String                @db.Uuid
  title            String
  description      String                @db.Text
  status           ServiceRequestStatus  @default(DRAFT)
  urgency          RequestUrgency        @default(MEDIUM)
  budgetMin        Decimal?              @db.Decimal(10, 2)
  budgetMax        Decimal?              @db.Decimal(10, 2)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  expiresAt        DateTime?
  deletedAt        DateTime?

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  address  Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)

  photos        RequestPhoto[]
  quotes        Quote[]
  appointments  Appointment[]
  /// Order / Job Lifecycle module (Module 11). In practice at most one Job
  /// per ServiceRequest exists (a request has at most one accepted Quote —
  /// see AcceptQuoteUseCase's "one active job per request" guard), but this
  /// stays a list (like `quotes`/`appointments`) rather than an optional
  /// 1:1 back-relation for consistency with those siblings.
  jobs          Job[]
  conversations Conversation[]
  reviews       Review[]
  payments      Payment[]
  disputes      Dispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([categoryId])
  @@index([addressId])
  @@index([status, categoryId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("service_requests")
}

/// Photos the customer attaches to a request (e.g. a photo of the leak).
/// Cascades with its parent request — a photo has no meaning on its own.
model RequestPhoto {
  id               String   @id @default(uuid()) @db.Uuid
  serviceRequestId String   @db.Uuid
  url              String
  caption          String?
  sortOrder        Int      @default(0)

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@map("request_photos")
}

/// A professional's or company's bid on a ServiceRequest. Exactly one of
/// professionalProfileId / companyProfileId is set — enforced by a CHECK
/// constraint added in the migration (Prisma's schema language can't
/// express multi-column CHECK constraints natively). `submittedByUserId`
/// records which specific person submitted it (the solo pro themself, or
/// a specific CompanyMember acting on the company's behalf).
model Quote {
  id                    String      @id @default(uuid()) @db.Uuid
  serviceRequestId      String      @db.Uuid
  professionalProfileId String?     @db.Uuid
  companyProfileId      String?     @db.Uuid
  submittedByUserId     String      @db.Uuid
  status                QuoteStatus @default(PENDING)
  totalAmount           Decimal     @db.Decimal(10, 2)
  currency              String      @default("EUR")
  validUntil            DateTime?
  notes                 String?     @db.Text
  respondedAt           DateTime?

  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  submittedBy         User                 @relation("QuoteSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  items        QuoteItem[]
  appointments Appointment[]
  payments     Payment[]
  /// Order / Job Lifecycle module (Module 11): 1:1 with the Job created
  /// when this Quote is accepted (see Job.quoteId's `@unique`) — null for
  /// every Quote that was never accepted.
  job          Job?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId, status])
  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([submittedByUserId])
  @@map("quotes")
}

/// Line items making up a Quote's total (labor, materials, call-out fee,
/// etc.). `amount` is stored (not computed) so historical quotes remain
/// accurate even if pricing logic changes later.
model QuoteItem {
  id          String            @id @default(uuid()) @db.Uuid
  quoteId     String            @db.Uuid
  description String
  quantity    Decimal           @db.Decimal(10, 2)
  unitPrice   Decimal           @db.Decimal(10, 2)
  amount      Decimal           @db.Decimal(10, 2)
  sortOrder   Int               @default(0)
  /// Module 22 — Commission & Financial: distinguishes labor from
  /// materials so commission (7.5% customer platform fee, 7.5%
  /// professional commission — see domain/services/commission-policy.ts)
  /// is calculated on labor only, never on materials. Defaults to LABOR so
  /// every quote item created before this module existed (and any created
  /// by a client that hasn't been updated to send a category yet) is
  /// treated as commissionable labor — the conservative default from the
  /// platform's own revenue perspective, and never silently zero-rates a
  /// line item's commission. The quote-submission UI is expected to let a
  /// professional mark specific items as MATERIALS going forward; this
  /// column only adds the capability, it does not retroactively
  /// reclassify anything.
  category    QuoteItemCategory @default(LABOR)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("quote_items")
}

/// Order / Job Lifecycle module (Module 11): the execution-lifecycle
/// entity — created automatically (never by a customer/professional
/// directly) the moment a Quote is accepted, inside the same transaction
/// that already creates the initial Appointment (see
/// PrismaQuoteAcceptanceRepository.acceptQuote). 1:1 with the accepted
/// Quote (`quoteId` is unique); a Job can own multiple Appointments (e.g.
/// a multi-day renovation is one Job with several visit-level
/// Appointments — see Appointment's own doc comment).
///
/// Deliberately separate from ServiceRequest: ServiceRequest remains the
/// customer-facing marketplace posting/request lifecycle (DRAFT ->
/// PUBLISHED -> ACCEPTED, see ServiceRequestStatus), while Job.status is
/// the authoritative record of whether the *accepted work itself* has
/// started/finished — see JobStatus and domain/services/job-state.ts. No
/// Module 11 code ever writes ServiceRequest to IN_PROGRESS or COMPLETED
/// as a side effect of a Job/Appointment transition.
///
/// `customerId`/`professionalProfileId`/`companyProfileId` are
/// denormalized at creation time from the ServiceRequest/accepted Quote —
/// same "denormalize the frequently-joined FK" pattern Appointment already
/// uses for its own professionalProfileId/companyProfileId — so "find my
/// active jobs" never requires a join through ServiceRequest/Quote.
/// Exactly one of professionalProfileId/companyProfileId is set, enforced
/// by a CHECK constraint (same pattern as Quote/Appointment).
model Job {
  id                    String                  @id @default(uuid()) @db.Uuid
  serviceRequestId      String                  @db.Uuid
  quoteId               String                  @unique @db.Uuid
  customerId            String                  @db.Uuid
  professionalProfileId String?                 @db.Uuid
  companyProfileId      String?                 @db.Uuid
  status                JobStatus               @default(CREATED)
  startedAt             DateTime?
  startedByUserId       String?                 @db.Uuid
  completedAt           DateTime?
  completedByUserId     String?                 @db.Uuid
  cancelledAt           DateTime?
  cancelledByUserId     String?                 @db.Uuid
  cancellationReason    JobCancellationReason?
  cancellationNote      String?                 @db.Text

  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customer            CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  startedBy           User?                @relation("JobStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  completedBy         User?                @relation("JobCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  cancelledBy          User?               @relation("JobCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  appointments Appointment[]

  /// Reviews & Ratings module (Module 13): at most one customer review per
  /// Job — see Review.jobId's `@unique`. Optional because most Jobs will
  /// never be reviewed.
  review Review?

  /// Module 21 — Disputes & Support: a Job may have more than one Dispute
  /// over its lifetime (e.g. the customer and the professional each open
  /// their own — see dispute-rules.ts's doc comment on why both are
  /// allowed independently).
  disputes Dispute[]

  /// Module 22 — Commission & Financial: financial adjustments (refunds,
  /// commission reversals, payout holds/releases, etc.) recorded against
  /// this Job's financial settlement. See FinancialAdjustment's doc
  /// comment.
  financialAdjustments FinancialAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([customerId])
  @@index([professionalProfileId, status])
  @@index([companyProfileId, status])
  @@index([status])
  @@map("jobs")
}

/// A scheduled (or completed) visit stemming from an accepted Quote. One
/// Quote can produce multiple Appointments (e.g. a multi-day renovation
/// job), which is why this isn't just a field on Quote.
///
/// Order / Job Lifecycle module (Module 11): every Appointment now also
/// belongs to exactly one Job (`jobId`, non-nullable) — the Job created
/// alongside it at quote-acceptance time, or, for a rescheduled
/// appointment, the same Job its superseded row belonged to (see
/// RescheduleAppointmentUseCase / PrismaAppointmentRepository.reschedule).
/// This is additive: quoteId/serviceRequestId are unchanged and continue
/// to be set exactly as before.
model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @db.Uuid
  quoteId          String            @db.Uuid
  serviceRequestId String            @db.Uuid
  addressId        String            @db.Uuid

  /// Booking & Scheduling module (Module 10): denormalized from the
  /// accepted Quote at creation time (see PrismaQuoteAcceptanceRepository).
  /// Exactly one of professionalProfileId / companyProfileId is set —
  /// enforced by a CHECK constraint (same "exactly one" pattern as
  /// Quote.professionalProfileId/companyProfileId), added in
  /// prisma/migrations/*_add_appointment_scheduling_lifecycle. This is what
  /// makes "does this professional have a conflicting appointment"
  /// queryable directly on Appointment instead of requiring a join through
  /// Quote — see the composite indexes below and
  /// ConfirmAppointmentUseCase's conflict check.
  professionalProfileId String? @db.Uuid
  companyProfileId      String? @db.Uuid

  /// Booking/Appointments module (MVP): nullable because an Appointment is
  /// now created immediately on Quote acceptance, before any actual
  /// scheduling — see the PENDING_SCHEDULE status above and
  /// prisma/migrations/20260723000000_add_appointment_pending_schedule.
  /// Booking & Scheduling module (Module 10): filled in by
  /// ConfirmAppointmentUseCase once the other party confirms a proposed
  /// time — this is always the authoritative, conflict-checked schedule,
  /// never a placeholder.
  ///
  /// Timezone decision (Module 10): unlike the rest of this schema (which
  /// uses Prisma's default `TIMESTAMP(3)`, i.e. timezone-naive, per the
  /// audit report's "Database gaps" finding), every DateTime field on this
  /// model is explicitly `@db.Timestamptz(3)` — stored as a true UTC
  /// instant. Scheduling is exactly the place a naive timestamp becomes
  /// ambiguous once the platform has customers/professionals in different
  /// IANA zones (EU expansion) or across a DST boundary (Spain observes
  /// DST). A platform-wide migration of every DateTime column is explicitly
  /// out of scope for this module (see the audit's "CAN BE DEFERRED"
  /// section) — this is a narrow, self-contained exception scoped to the
  /// one model where the ambiguity is actually user-visible today. The
  /// application layer always converts a proposed local time to its UTC
  /// instant at the DTO boundary using the proposer's own `User.timezone`
  /// (see booking.dto.ts) before it ever reaches this column.
  scheduledStart   DateTime? @db.Timestamptz(3)
  scheduledEnd     DateTime? @db.Timestamptz(3)

  /// Booking & Scheduling module (Module 10): an unconfirmed time put
  /// forward by either party (see AppointmentStatus.PROPOSED and
  /// domain/services/appointment-state.ts). Left in place after
  /// confirmation as a record of what was last proposed; superseded values
  /// from earlier counter-proposals are not separately retained (only the
  /// most recent proposal matters operationally — full history lives at
  /// the Appointment-row level via rescheduling, not per-proposal).
  proposedStart    DateTime? @db.Timestamptz(3)
  proposedEnd      DateTime? @db.Timestamptz(3)
  proposedByUserId String?   @db.Uuid

  actualStart      DateTime? @db.Timestamptz(3)
  actualEnd        DateTime? @db.Timestamptz(3)
  status           AppointmentStatus @default(PENDING_SCHEDULE)
  notes            String?           @db.Text

  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelledByUserId  String?                         @db.Uuid
  cancellationReason AppointmentCancellationReason?
  /// Booking & Scheduling module (Module 10): optional free-text detail
  /// alongside the typed `cancellationReason` — kept separate so a future
  /// Payment/Stripe Connect refund-eligibility workflow can key off the
  /// typed enum without parsing prose.
  cancellationNote   String?                         @db.Text

  /// Booking & Scheduling module (Module 10): non-destructive rescheduling.
  /// Set only on the *new* Appointment row created by
  /// RescheduleAppointmentUseCase, pointing back at the row it supersedes.
  /// The old row is transitioned to RESCHEDULED and never mutated further —
  /// its proposal/confirmation/cancellation history is preserved forever
  /// instead of being overwritten in place. `@unique` because a superseded
  /// appointment can be rescheduled into at most one successor.
  rescheduledFromId String? @unique @db.Uuid

  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  address             Address              @relation(fields: [addressId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  proposedBy          User?                @relation("AppointmentProposedBy", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  cancelledBy         User?                @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  rescheduledFrom     Appointment?         @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo       Appointment?         @relation("AppointmentReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([quoteId])
  @@index([serviceRequestId])
  @@index([addressId])
  @@index([scheduledStart])
  @@index([status])
  @@index([professionalProfileId, status, scheduledStart, scheduledEnd])
  @@index([companyProfileId, status, scheduledStart, scheduledEnd])
  @@map("appointments")
}

// ============================================================================
// Messaging
// ============================================================================

/// A chat thread. Usually tied to a ServiceRequest (customer ↔
/// professional/company discussing a job); `serviceRequestId` is nullable
/// to also allow platform/support conversations not tied to a request.
model Conversation {
  id               String              @id @default(uuid()) @db.Uuid
  serviceRequestId String?             @db.Uuid
  status           ConversationStatus  @default(ACTIVE)
  lastMessageAt    DateTime?

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([lastMessageAt])
  @@map("conversations")
}

/// Join table: who's in a conversation. `leftAt` lets someone leave
/// without losing the historical fact they were part of it; `lastReadAt`
/// backs unread-message counts.
model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// A single chat message. `senderId` is Restrict (not Cascade) so message
/// history survives even if the app is ever configured to hard-delete a
/// user — in practice, User uses soft delete (`deletedAt`) for exactly
/// this reason, so this constraint should rarely if ever actually block
/// anything. `deletedAt` supports a user "unsending" their own message.
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderId       String        @db.Uuid
  body           String        @db.Text
  status         MessageStatus @default(SENT)
  /// Booking & Scheduling module (Module 10) addition — see MessageType's
  /// doc comment.
  type           MessageType   @default(USER)
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  attachments MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/// Files attached to a message (photos, PDFs, etc.). Cascades with its
/// parent message.
model MessageAttachment {
  id            String  @id @default(uuid()) @db.Uuid
  messageId     String  @db.Uuid
  url           String
  fileName      String
  fileType      String
  fileSizeBytes Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId])
  @@map("message_attachments")
}

// ============================================================================
// Reviews
// ============================================================================

/// A customer's review of a completed Job (Reviews & Ratings module,
/// Module 13). Originally anchored to ServiceRequest only; Module 13
/// re-anchors it to `Job` (`jobId`, unique — one review per Job) because
/// Job, not ServiceRequest, is the authoritative record of "was the work
/// actually completed" (see job-state.ts and the Module 11 audit report,
/// "Finding 1"). `serviceRequestId` is kept as an additional denormalized
/// FK for convenient querying — same "keep the frequently-joined FK
/// alongside the newer authoritative one" pattern Appointment already uses
/// for quoteId/serviceRequestId next to jobId — but Job is always the
/// source of truth for eligibility/authorization, never ServiceRequest or
/// Quote directly.
///
/// Exactly one of revieweeProfessionalProfileId / revieweeCompanyProfileId
/// is set (CHECK constraint added in migration), matching the same
/// solo-pro-vs-company duality used on Quote/Payout/etc — this keeps the
/// model ready for a future company-side review without redesign. `response`
/// lets the professional/company reply publicly, a standard marketplace
/// pattern; unused by Module 13 (no reply use case yet) but left in place
/// for a future module to fill in.
///
/// `status` defaults to PUBLISHED, not PENDING: Module 13 does not
/// implement a moderation/approval workflow (that's Module 16 — Admin
/// Panel's job), so a review is visible as soon as it's created. The enum
/// itself (PENDING/PUBLISHED/FLAGGED/REMOVED) is left untouched so Module
/// 16 can later flag/remove a review, or reintroduce a pending-approval
/// step, without a schema change.
///
/// Module 41 — Reviews & Ratings: `response`/`respondedAt` are now used
/// (RespondToReviewUseCase) — no schema change was needed, exactly as this
/// doc comment's own Module 13 note anticipated. `deletedAt` (below) is new
/// in Module 41: an author-initiated soft delete, distinct from `status`,
/// which remains Module 16's own admin-moderation axis.
model Review {
  id                             String       @id @default(uuid()) @db.Uuid
  jobId                          String       @unique @db.Uuid
  serviceRequestId               String       @db.Uuid
  reviewerId                     String       @db.Uuid
  revieweeProfessionalProfileId  String?      @db.Uuid
  revieweeCompanyProfileId       String?      @db.Uuid
  rating                         Int /// 1–5, enforced by CHECK constraint in migration
  comment                        String?      @db.Text
  response                       String?      @db.Text
  respondedAt                    DateTime?
  status                         ReviewStatus @default(PUBLISHED)
  deletedAt                      DateTime?

  job                  Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  serviceRequest       ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  reviewer             User                 @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeProfessional ProfessionalProfile? @relation("ReviewOfProfessional", fields: [revieweeProfessionalProfileId], references: [id], onDelete: Restrict)
  revieweeCompany      CompanyProfile?      @relation("ReviewOfCompany", fields: [revieweeCompanyProfileId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([reviewerId])
  @@index([revieweeProfessionalProfileId])
  @@index([revieweeCompanyProfileId])
  @@index([status])
  /// Module 41 — Reviews & Ratings: composite index covering
  /// ListProfessionalReviewsUseCase/GetProfessionalRatingSummaryUseCase's
  /// query shape exactly (`WHERE revieweeProfessionalProfileId = ? AND
  /// status = 'PUBLISHED' AND deletedAt IS NULL`, see
  /// PrismaReviewRepository's `PUBLIC_WHERE`) — the pre-existing single-
  /// column `revieweeProfessionalProfileId` index above still serves
  /// `findByJobId`-adjacent lookups, but every public-facing read this
  /// module added/extended now hits this one instead, avoiding a filter
  /// step over rows an index-only scan of the single-column index would
  /// still have to fetch.
  @@index([revieweeProfessionalProfileId, status, deletedAt])
  @@map("reviews")
}

// ============================================================================
// Payments & Finance
// ============================================================================

/// A customer's payment for a ServiceRequest/Quote. All money fields use
/// Decimal(10,2) — never Float — to avoid floating-point rounding errors
/// in financial data.
model Payment {
  id                    String            @id @default(uuid()) @db.Uuid
  serviceRequestId      String            @db.Uuid
  quoteId               String?           @db.Uuid
  payerId               String            @db.Uuid
  amount                Decimal           @db.Decimal(10, 2)
  currency              String            @default("EUR")
  method                PaymentMethodType
  status                PaymentStatus     @default(PENDING)
  stripePaymentIntentId String?           @unique
  capturedAt            DateTime?
  failureReason         String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote          Quote?         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  payer          User           @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)

  refunds      Refund[]
  commission   Commission?
  transactions Transaction[] @relation("TransactionPayment")
  /// Module 22 — Commission & Financial: adjustments recorded against this
  /// specific Payment (a dispute-driven partial refund, a platform-fee
  /// refund, etc.) — most FinancialAdjustments are only anchored to a Job,
  /// this is set only once a Payment actually exists to adjust.
  financialAdjustments FinancialAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([quoteId])
  @@index([payerId])
  @@index([status])
  @@map("payments")
}

/// The platform's fee taken from a Payment. One-to-one with Payment —
/// every captured payment produces exactly one commission record, even if
/// its rate is later found to be 0 (waived). `rateBps` (basis points,
/// e.g. 1000 = 10.00%) avoids the float-precision issues a percentage
/// stored as a fraction would introduce.
///
/// Unlike Quote/Review/Payout/VerificationDocument/Dispute, the
/// professionalProfileId/companyProfileId pair here is constrained to
/// "at most one" (not "exactly one") in the migration — a manual platform
/// adjustment with neither set is a legitimate edge case for this model.
model Commission {
  id                    String           @id @default(uuid()) @db.Uuid
  paymentId             String           @unique @db.Uuid
  professionalProfileId String?          @db.Uuid
  companyProfileId      String?          @db.Uuid
  rateBps               Int
  amount                Decimal          @db.Decimal(10, 2)
  status                CommissionStatus @default(PENDING)
  settledAt             DateTime?

  payment             Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation("CommissionOnProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("CommissionOnCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionCommission")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([status])
  @@map("commissions")
}

/// A payout of earnings to a professional or company via Stripe Connect.
/// Same solo-pro-vs-company duality pattern as Quote/Review (CHECK
/// constraint in migration).
model Payout {
  id                     String       @id @default(uuid()) @db.Uuid
  professionalProfileId  String?      @db.Uuid
  companyProfileId       String?      @db.Uuid
  amount                 Decimal      @db.Decimal(10, 2)
  currency               String       @default("EUR")
  status                 PayoutStatus @default(PENDING)
  stripeTransferId       String?      @unique
  periodStart            DateTime?
  periodEnd              DateTime?
  processedAt            DateTime?
  failureReason          String?

  professionalProfile ProfessionalProfile? @relation("PayoutToProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("PayoutToCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionPayout")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([status])
  @@map("payouts")
}

/// A refund against a Payment. `requestedByUserId` may be the customer or
/// an admin acting on a dispute resolution.
model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  requestedByUserId String       @db.Uuid
  amount            Decimal      @db.Decimal(10, 2)
  reason            RefundReason
  status            RefundStatus @default(REQUESTED)
  stripeRefundId    String?      @unique
  processedAt       DateTime?
  notes             String?      @db.Text

  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedByUser User    @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionRefund")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("refunds")
}

/// Append-only general ledger. Every money movement (charge, refund,
/// payout, commission, manual adjustment) gets one Transaction row, giving
/// a single queryable audit trail independent of which specific table
/// (Payment/Refund/Payout/Commission) generated it. At most one of the
/// four source FKs is set, matching which `type` the row is.
model Transaction {
  id            String             @id @default(uuid()) @db.Uuid
  paymentId     String?            @db.Uuid
  payoutId      String?            @db.Uuid
  refundId      String?            @db.Uuid
  commissionId  String?            @db.Uuid
  type          TransactionType
  status        TransactionStatus  @default(PENDING)
  amount        Decimal            @db.Decimal(10, 2) /// signed: positive = inflow to the platform, negative = outflow
  currency      String             @default("EUR")
  description   String?
  /// Module 22 — Commission & Financial: caller-supplied idempotency key
  /// (e.g. "commission:<paymentId>", "dispute-adjustment:<disputeId>:<type>")
  /// so a retried financial operation (webhook redelivery, a double-submit
  /// admin action) can never create a second ledger entry for the same
  /// logical event — see FinancialLedgerRepository.findByIdempotencyKey.
  /// Nullable because the two pre-existing writers implied by this model
  /// (none yet in code) may not always have a natural key; every Module 22
  /// write path always supplies one.
  idempotencyKey String? @unique

  payment    Payment?    @relation("TransactionPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  payout     Payout?     @relation("TransactionPayout", fields: [payoutId], references: [id], onDelete: Restrict)
  refund     Refund?     @relation("TransactionRefund", fields: [refundId], references: [id], onDelete: Restrict)
  commission Commission? @relation("TransactionCommission", fields: [commissionId], references: [id], onDelete: Restrict)

  /// Module 22 — Commission & Financial: the FinancialAdjustment this
  /// ledger entry was created to record, if any (1:1 — see
  /// FinancialAdjustment.transactionId's `@unique`).
  financialAdjustment FinancialAdjustment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([payoutId])
  @@index([refundId])
  @@index([commissionId])
  @@index([type, status])
  @@index([createdAt])
  @@map("transactions")
}

/// Module 22 — Commission & Financial: the boundary Module 21 (Disputes &
/// Support) uses to request a financial consequence of a resolved dispute
/// without executing money movement itself (see
/// ResolveDisputeUseCase's own doc comment and Dispute.resolution's —
/// `FINANCIAL_ADJUSTMENT_REQUIRED` is the generic "Module 22 must act"
/// flag they describe). Always anchored to a Job (every dispute is); a
/// Payment reference is added once one exists to adjust. Recording an
/// adjustment here is a two-step, auditable process: `create()` writes a
/// PENDING row (idempotent on `idempotencyKey`), and a separate `apply()`
/// call links the resulting ledger Transaction and marks it APPLIED —
/// this module never silently marks money as moved without a
/// corresponding Transaction row existing first.
model FinancialAdjustment {
  id                String                    @id @default(uuid()) @db.Uuid
  jobId             String                    @db.Uuid
  disputeId         String?                   @db.Uuid
  paymentId         String?                   @db.Uuid
  type              FinancialAdjustmentType
  status            FinancialAdjustmentStatus @default(PENDING)
  amount            Decimal                   @db.Decimal(10, 2)
  currency          String                    @default("EUR")
  reason            String?                   @db.Text
  requestedByUserId String                    @db.Uuid
  /// e.g. "dispute-adjustment:<disputeId>:<type>" — guards against the
  /// same dispute resolution being processed twice (a double-submit admin
  /// action, a retried background job, etc.).
  idempotencyKey    String                    @unique
  transactionId     String?                   @unique @db.Uuid
  appliedAt         DateTime?

  job             Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  dispute         Dispute?     @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  payment         Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedByUser User         @relation("FinancialAdjustmentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([disputeId])
  @@index([paymentId])
  @@index([status])
  @@map("financial_adjustments")
}

// ============================================================================
// Notifications
// ============================================================================

/// A single notification instance for a user across any channel. Unlike
/// most tables here, this Cascades with User — notifications are
/// disposable, not part of the financial/legal record, so there's no
/// reason to block a (hypothetical, rare) hard user deletion on their
/// notification history.
/// Notifications module (Module 15): a single in-app notification instance
/// for a user. Reshaped from the Phase-1 placeholder version (see git
/// history) — that shape anticipated multi-channel (email/SMS/push)
/// delivery (`channel`/`status`/`sentAt`) that no module has implemented;
/// Module 15 is in-app only, so those fields were replaced with the
/// concrete shape it actually needs: `resourceType`/`resourceId` +
/// `actionUrl` for deep-linking back to the resource the notification is
/// about, `metadata` for small structured extras, and `dismissedAt` as the
/// soft-delete marker (distinct from `readAt` — see the module doc's
/// "Read/Unread vs. Dismissal" section). Multi-channel delivery remains a
/// valid future extension that would reintroduce a channel/status pair
/// without disturbing this shape.
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  type         NotificationType
  title        String
  message      String           @db.Text
  /// e.g. "SERVICE_REQUEST" | "QUOTE" | "CONVERSATION" | "APPOINTMENT" |
  /// "JOB" | "REVIEW" — free-text tag, not a DB enum, since new resource
  /// kinds may be added by future modules without a migration here.
  resourceType String?
  resourceId   String?
  /// Safe, internal-only path (see notification-rules.ts's isSafeActionUrl)
  /// — never an absolute/external URL, never javascript:/data:/vbscript:.
  actionUrl    String?
  metadata     Json?            @db.JsonB
  /// null = unread. Distinct from dismissedAt — a read notification still
  /// appears in the list until dismissed.
  readAt       DateTime?
  /// null = active. Non-null = soft-deleted; excluded from listings, unread
  /// counts, and mark-all-as-read. Never hard-deleted.
  dismissedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dismissedAt, createdAt])
  @@index([userId, readAt, dismissedAt])
  @@map("notifications")
}

// ============================================================================
// Trust & Safety
// ============================================================================

/// A KYC/verification document uploaded by a professional or company.
/// Same solo-pro-vs-company duality pattern (CHECK constraint in
/// migration). `reviewedByUserId` uses SetNull (not Restrict) — losing
/// the "who reviewed this" pointer if that admin account is later removed
/// is an acceptable trade-off; the document and its outcome remain intact.
model VerificationDocument {
  id                     String                      @id @default(uuid()) @db.Uuid
  professionalProfileId  String?                     @db.Uuid
  companyProfileId       String?                     @db.Uuid
  type                   VerificationDocumentType
  status                 VerificationDocumentStatus  @default(PENDING)
  fileUrl                String
  expiresAt              DateTime?
  reviewedByUserId       String?                     @db.Uuid
  reviewedAt             DateTime?
  rejectionReason        String?
  deletedAt              DateTime?

  professionalProfile ProfessionalProfile? @relation("DocumentOfProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("DocumentOfCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)
  reviewedBy          User?                @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([reviewedByUserId])
  @@index([status])
  @@map("verification_documents")
}

/// Professional Verification module (Module 17): a single verification
/// *case* for an individual professional — the aggregate root of the review
/// workflow. Deliberately separate from the pre-existing, unused
/// `VerificationDocument` model (which is profile-anchored, company-capable,
/// and has no case/lifecycle concept): this module needs a case that moves
/// through an explicit state machine and owns its own set of documents, so
/// it introduces its own aggregate rather than overloading that placeholder.
///
/// A professional accumulates a *history* of cases over time (one row per
/// case), but only ever has one that is not EXPIRED at any moment — enforced
/// by a partial unique index (`professional_verifications_active_unique`,
/// added in the migration, since Prisma can't express a partial index) as
/// well as by application logic in CreateProfessionalVerificationUseCase.
///
/// `professionalProfileId` is Restrict (a case is a trust/compliance record
/// and must not silently vanish if the profile row is ever hard-deleted —
/// the profile itself is soft-deleted, same rationale as elsewhere in this
/// schema). `reviewedByUserId` is SetNull, matching VerificationDocument.
model ProfessionalVerification {
  id                    String                          @id @default(uuid()) @db.Uuid
  professionalProfileId String                          @db.Uuid
  status                ProfessionalVerificationStatus  @default(DRAFT)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedByUserId      String?                         @db.Uuid
  /// Set only when status = REJECTED. Never exposed on any public API.
  rejectionReason       String?                         @db.Text
  /// Set only when status = RESUBMISSION_REQUIRED — instructions the
  /// professional sees so they know what to fix. Never exposed publicly.
  resubmissionReason    String?                         @db.Text
  /// Set when APPROVED — the point past which an APPROVED case is treated as
  /// EXPIRED and a fresh case may be opened.
  expiresAt             DateTime?

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  reviewedBy          User?               @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  documents ProfessionalVerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([status, submittedAt])
  @@map("professional_verifications")
}

/// Professional Verification module (Module 17): a document uploaded as part
/// of a verification case. Cascades with its parent case (a document has no
/// meaning outside the case it was uploaded for). `fileUrl` is a sensitive
/// Cloudinary reference — never returned on any public/professional-profile
/// API response; only the owning professional and ADMIN/SUPER_ADMIN can read
/// it (see the module's use cases and docs). Reuses the existing
/// `VerificationDocumentType`/`VerificationDocumentStatus` enums rather than
/// introducing parallel ones.
model ProfessionalVerificationDocument {
  id               String                     @id @default(uuid()) @db.Uuid
  verificationId   String                     @db.Uuid
  type             VerificationDocumentType
  status           VerificationDocumentStatus @default(PENDING)
  fileUrl          String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  /// Optional per-document rejection note (a reviewer may reject one
  /// document without rejecting the whole case). Never exposed publicly.
  rejectionReason  String?                    @db.Text

  verification ProfessionalVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationId])
  @@index([type])
  @@map("professional_verification_documents")
}

/// A dispute raised over an Order/Job (Module 21 — Disputes & Support).
/// Anchored primarily to `jobId` (added by Module 21's migration) rather
/// than only ServiceRequest: the task a customer/professional actually
/// disputes is the concrete Job engagement, and Job is also where
/// Module 22 (future financial settlement) will need to look up amounts.
/// `serviceRequestId` is kept alongside `jobId` (always set to
/// `job.serviceRequestId` at creation) purely as a query-convenience
/// denormalization for admin filtering/search — it is never independently
/// writable and never diverges from the Job it was copied from; see
/// docs/MODULE_21_DISPUTES_SUPPORT.md, "Job vs ServiceRequest anchoring"
/// for the tradeoff. `quoteId`/`appointmentId` are deliberately NOT
/// duplicated here — both are reachable via `job.quoteId`/
/// `job.appointments`, and the module spec explicitly asks not to
/// duplicate order data into the dispute record.
///
/// Same solo-pro-vs-company duality on the respondent side as before
/// (CHECK constraint in migration). `resolvedByUserId`/`assignedAdminUserId`
/// use SetNull for the same reason as VerificationDocument.reviewedBy.
model Dispute {
  id                                String              @id @default(uuid()) @db.Uuid
  /// Human-readable case number, e.g. "DSP-2026-000123" — see
  /// dispute-rules.ts's `formatCaseNumber`. Unique, immutable once created.
  caseNumber                        String              @unique
  title                             String
  jobId                             String              @db.Uuid
  serviceRequestId                  String              @db.Uuid
  raisedByUserId                    String              @db.Uuid
  respondentProfessionalProfileId   String?             @db.Uuid
  respondentCompanyProfileId        String?             @db.Uuid
  reason                            DisputeReason
  status                            DisputeStatus       @default(OPEN)
  priority                          DisputePriority     @default(MEDIUM)
  description                       String              @db.Text
  assignedAdminUserId               String?             @db.Uuid
  resolution                        DisputeResolution?
  resolutionNote                    String?             @db.Text
  resolvedAt                        DateTime?
  resolvedByUserId                  String?             @db.Uuid
  closedAt                          DateTime?
  closedByUserId                    String?             @db.Uuid

  job                     Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  serviceRequest          ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  raisedBy                User                 @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  respondentProfessional  ProfessionalProfile? @relation("DisputeRespondentProfessional", fields: [respondentProfessionalProfileId], references: [id], onDelete: Restrict)
  respondentCompany       CompanyProfile?      @relation("DisputeRespondentCompany", fields: [respondentCompanyProfileId], references: [id], onDelete: Restrict)
  assignedAdmin           User?                @relation("DisputeAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  resolvedBy              User?                @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  closedBy                User?                @relation("DisputeClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  evidence DisputeEvidence[]
  messages DisputeMessage[]

  /// Module 22 — Commission & Financial: financial adjustments executed as
  /// a consequence of this dispute's resolution (see
  /// FinancialAdjustment's doc comment). A Dispute never moves money
  /// itself — see ResolveDisputeUseCase's own doc comment — this relation
  /// only lets an admin/Module 22 trace which adjustments originated from
  /// which dispute. Zero or more: NO_ACTION resolutions produce none, a
  /// PARTIAL_RESOLUTION could in principle produce several.
  financialAdjustments FinancialAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One OPEN dispute per (job, opener): prevents the same user from
  // opening a second concurrently-open case on the same Job (see
  // dispute-rules.ts's doc comment) while still allowing a new dispute
  // once the previous one from that same opener has left status=OPEN.
  // This is a partial index (Postgres), added by the module's migration
  // SQL rather than expressible directly here (Prisma has no partial
  // unique index syntax pre-`@@unique(..., where:)`); documented as a
  // best-effort DB-level guard behind the use case's own application-level
  // check.
  @@index([jobId])
  @@index([serviceRequestId])
  @@index([raisedByUserId])
  @@index([assignedAdminUserId])
  @@index([resolvedByUserId])
  @@index([status])
  @@index([priority])
  @@index([respondentProfessionalProfileId])
  @@index([respondentCompanyProfileId])
  @@map("disputes")
}

/// Supporting evidence (photos, documents) submitted for a Dispute by
/// either party. Cascades with its parent dispute. `fileType`/`fileName`/
/// `fileSize` mirror MessageAttachment's metadata fields for consistency
/// with the platform's other "URL + metadata" attachment pattern.
model DisputeEvidence {
  id                 String  @id @default(uuid()) @db.Uuid
  disputeId          String  @db.Uuid
  submittedByUserId  String  @db.Uuid
  fileUrl            String
  fileName           String?
  fileType           String?
  fileSizeBytes      Int?
  description        String?

  dispute         Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedByUser User    @relation("EvidenceSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disputeId])
  @@index([submittedByUserId])
  @@map("dispute_evidence")
}

/// Module 21 — Disputes & Support: the dispute's communication thread.
/// Deliberately a small dedicated model rather than reusing Conversation/
/// Message (Chat, Module ~14) — see docs/MODULE_21_DISPUTES_SUPPORT.md,
/// "Relationship with Chat" for the full reasoning: a dispute thread needs
/// 3-way visibility (customer, professional/company, admin) plus an
/// admin-only "internal note" channel that must NEVER be reachable by a
/// non-admin code path, which is a materially different invariant set than
/// Chat's 1:1/booking conversations, and bolting it onto Conversation/
/// Message would risk weakening Chat's existing guarantees. `isInternalNote`
/// distinguishes the two: `false` rows are visible to every case
/// participant (raiser + respondent + assigned/any admin); `true` rows are
/// admin-authored and only ever read by an admin-authorized use case (see
/// ListDisputeInternalNotesUseCase / AddDisputeInternalNoteUseCase) — no
/// customer/professional-facing repository method ever selects them.
model DisputeMessage {
  id              String  @id @default(uuid()) @db.Uuid
  disputeId       String  @db.Uuid
  authorUserId    String  @db.Uuid
  body            String  @db.Text
  isInternalNote  Boolean @default(false)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation("DisputeMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([disputeId, isInternalNote, createdAt])
  @@index([authorUserId])
  @@map("dispute_messages")
}

/// Module 21 — Disputes & Support: general (non-order-tied) support ticket
/// — see the SupportTicketCategory/SupportTicketStatus enum doc comments
/// for why this is a separate model from Dispute.
model SupportTicket {
  id                   String                @id @default(uuid()) @db.Uuid
  ticketNumber         String                @unique
  category             SupportTicketCategory
  subject              String
  description          String                @db.Text
  status               SupportTicketStatus   @default(OPEN)
  priority             DisputePriority       @default(MEDIUM)
  openedByUserId       String                @db.Uuid
  assignedAdminUserId  String?               @db.Uuid
  resolutionNote       String?               @db.Text
  resolvedAt           DateTime?
  resolvedByUserId     String?               @db.Uuid
  closedAt             DateTime?
  closedByUserId       String?               @db.Uuid

  openedBy      User  @relation("SupportTicketOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedAdmin User? @relation("SupportTicketAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  resolvedBy    User? @relation("SupportTicketResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  closedBy      User? @relation("SupportTicketClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([openedByUserId])
  @@index([assignedAdminUserId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

// ============================================================================
// Platform / Audit
// ============================================================================

/// Append-only audit trail of significant actions across the platform.
/// Deliberately has NO `updatedAt` and NO soft delete — an audit log
/// entry that could be edited or hidden after the fact would defeat its
/// entire purpose. `actorUserId` is nullable + SetNull for
/// system-initiated actions (e.g. an expired-request cron job) that have
/// no human actor. `entityType`/`entityId` form a lightweight polymorphic
/// reference (e.g. entityType="ServiceRequest") rather than one FK column
/// per possible entity, since virtually every table in this schema could
/// need to be audited.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorUserId String?       @db.Uuid
  action     AuditLogAction
  entityType String
  entityId   String?        @db.Uuid
  metadata   Json?          @db.JsonB
  ipAddress  String?
  userAgent  String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Security & Anti-Abuse (Module 24)
// ============================================================================
//
// Two new models, deliberately kept separate from the existing AuditLog
// above rather than reusing it:
//   - AuditLog's own doc comment describes it as a trail of "significant
//     actions" performed by a resolved actor on a resolved entity. Most
//     SecurityEvents below (LOGIN_FAILED, RATE_LIMIT_TRIGGERED, an
//     anonymous registration flood from one IP) have *no* authenticated
//     actor and *no* single target entity — exactly the cases AuditLog's
//     shape doesn't fit.
//   - AuditLogAction is a shared enum already reused by five other modules
//     (see its doc comment / AdminAuditAction) for their own action
//     vocabularies via `metadata.adminAction`. Widening it with 10+
//     security-specific values not applicable to any of those modules
//     would be a broader, riskier change than adding one small, purpose-
//     built enum here.
// Both stay additive: no existing table, column, or enum is modified.

/// What kind of security-relevant thing happened. Deliberately narrower
/// than "log everything" — only events an anti-abuse policy or an admin
/// investigating abuse actually needs. See docs/MODULE_24_SECURITY_ANTI_ABUSE.md.
enum SecurityEventType {
  LOGIN_FAILED
  LOGIN_SUCCEEDED
  ACCOUNT_CREATED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFICATION_REQUESTED
  RATE_LIMIT_TRIGGERED
  ACCOUNT_TEMPORARILY_BLOCKED
  SUSPICIOUS_ACTIVITY_DETECTED
  SERVICE_REQUEST_RATE_LIMITED
  QUOTE_RATE_LIMITED
  MESSAGE_RATE_LIMITED
  REVIEW_RATE_LIMITED
  ADMIN_ACTION
  SECURITY_POLICY_BLOCKED
}

/// Append-only security event log. Never exposed to the subject user
/// (see SecurityEventRepository's doc comment) — read access is
/// SUPER_ADMIN-only, same requireRole() gate as every other admin-only
/// repository/use case in this codebase.
///
/// Privacy: raw IP addresses are never stored here. `ipHash` is a
/// keyed SHA-256 hash (see infrastructure/auth/security-key.ts) of the
/// caller's IP — enough to recognise "the same source acted repeatedly"
/// for rate-limiting/investigation without persisting an address that
/// identifies a person or location. `userAgent` is stored verbatim
/// (browser/client strings are not personally identifying on their own)
/// but truncated at the application boundary. `metadata` must never hold
/// passwords, tokens, or other secrets — see the doc comment on
/// SecurityEventRepository.record().
model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  type      SecurityEventType
  userId    String?           @db.Uuid
  ipHash    String?
  userAgent String?
  metadata  Json?             @db.JsonB

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@map("security_events")
}

/// Current abuse-related state, internal reason category, and (auto-)
/// expiry for one active restriction on a User. Deliberately its own
/// table rather than a status column bolted onto User — User.status
/// (see UserStatus) already models the *account lifecycle*
/// (pending/active/suspended/banned, an explicit admin/moderation
/// decision); this models a *temporary, often automated* anti-abuse
/// state layered on top of it (e.g. "still ACTIVE, but throttled for the
/// next 15 minutes because of a burst of failed logins"). Multiple rows
/// per user are allowed (history of past restrictions); "is this user
/// currently restricted" is "is there a row for this userId with
/// liftedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now())".
///
/// No permanent auto-bans: automated restrictions (createdByUserId null)
/// always carry an expiresAt. Only an explicit admin action
/// (createdByUserId set) may create one with expiresAt = null — a
/// deliberate, reviewable decision, never something the rate-limit/abuse
/// policy layer does on its own. `reason` is an internal category never
/// shown to the restricted user (see AccountRestrictionRepository).
model AccountRestriction {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @db.Uuid
  state           AccountRestrictionState
  reason          AccountRestrictionReason
  notes           String?                  @db.Text /// internal only, never exposed to the restricted user
  createdByUserId String?                  @db.Uuid /// null = system/automated; set = explicit admin action
  expiresAt       DateTime?                /// null only allowed when createdByUserId is set (admin decision)
  liftedAt        DateTime?

  user      User  @relation("AccountRestrictionSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AccountRestrictionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, state])
  @@index([expiresAt])
  @@map("account_restrictions")
}

enum AccountRestrictionState {
  THROTTLED
  TEMPORARILY_BLOCKED
  FLAGGED
}

enum AccountRestrictionReason {
  FAILED_LOGIN_BURST
  REGISTRATION_ABUSE
  SERVICE_REQUEST_SPAM
  QUOTE_SPAM
  MESSAGE_SPAM
  REVIEW_ABUSE
  ADMIN_DECISION
  OTHER
}

// ============================================================================
// Module 38 — GDPR Compliance
// ============================================================================

/// Append-only record of a user granting (and, later, possibly withdrawing)
/// one of the platform's tracked consent types. See
/// src/core/domain/entities/consent.ts for the domain model and
/// src/core/domain/value-objects/consent-type.ts for why these three values
/// were chosen. Granting the same type again after a withdrawal creates a
/// brand-new row rather than reactivating the old one — a full history is
/// the point, not just current state.
model Consent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  type        ConsentType
  /// Free-form identifier for the terms/policy text version consented to
  /// (e.g. "2026-01-15"). Not validated against a fixed list here — that
  /// lives at the application edge/CMS that manages legal copy.
  version     String
  grantedAt   DateTime    @default(now())
  withdrawnAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@map("consents")
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING
}
