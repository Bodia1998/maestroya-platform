// ============================================================================
// MaestroYa — Marketplace Domain Model
// ============================================================================
//
// Scope note (Phase 1): this file defines the complete data model only.
// No API, UI, pages, or business logic live here or were added elsewhere.
// See docs/DOMAIN_MODEL.md for a full explanation of every model and the
// reasoning behind each cascading/indexing decision.
//
// Two reference tables — Language and Role — were added beyond the
// requested 26 models. They aren't marketplace entities in their own
// right, but the task explicitly asks to seed "Languages" and "Roles",
// and seeding requires a table to seed into. Flagged here for visibility.
//
// Four more reference tables — Country, Province, City, PlatformSetting —
// were added in a later pass for the same reason: a task explicitly asked
// to seed Spain/Valencia/Gandia and platform settings, and Address stores
// geography as free-text with nothing to seed a lookup table into. See
// docs/DOMAIN_MODEL.md for details on why these stay independent of
// Address rather than replacing its free-text fields.
//
// A handful of CHECK constraints (e.g. "exactly one of professionalProfileId
// / companyProfileId must be set") can't be expressed in Prisma's schema
// language and are instead added via raw SQL in the migration — see
// prisma/migrations/20260717000000_init_domain_model/migration.sql.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth.js (next-auth) required models
// https://authjs.dev/getting-started/adapters/prisma
//
// Field names/shapes are fixed by the adapter and must not change. The one
// modification made here is switching User/Account/Session ids from cuid()
// to uuid() so every primary key in the schema is a UUID, per Phase 1's
// requirements — Auth.js does not care which id-generation strategy is used.
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // --- Marketplace fields (added in Phase 1) ---
  phone            String?    @unique
  phoneVerifiedAt  DateTime?
  status           UserStatus @default(PENDING_VERIFICATION)
  preferredLanguageId String? @db.Uuid
  timezone         String?
  notificationPreferences Json? @db.JsonB
  lastLoginAt      DateTime?
  deletedAt        DateTime? // soft delete — see docs/DOMAIN_MODEL.md "Why soft-delete users"

  // --- Authentication fields (added in Authentication module) ---
  // Nullable: users who only ever sign in via OAuth (Google/Apple/Facebook)
  // never get one. Never store or return this field outside the auth
  // module's own password-verification code path.
  passwordHash String?

  accounts Account[]
  sessions Session[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]

  preferredLanguage Language? @relation(fields: [preferredLanguageId], references: [id], onDelete: SetNull)
  roles             UserRole[]
  customerProfile     CustomerProfile?
  professionalProfile ProfessionalProfile?
  companyMemberships  CompanyMember[]
  addresses           Address[]

  ownedCompanies         CompanyProfile[]      @relation("CompanyOwner")
  submittedQuotes        Quote[]               @relation("QuoteSubmittedBy")
  conversationMembers    ConversationMember[]
  sentMessages           Message[]             @relation("MessageSender")
  writtenReviews         Review[]              @relation("ReviewAuthor")
  payments               Payment[]             @relation("PaymentPayer")
  requestedRefunds       Refund[]              @relation("RefundRequestedBy")
  notifications          Notification[]
  reviewedDocuments      VerificationDocument[] @relation("DocumentReviewer")
  raisedDisputes         Dispute[]              @relation("DisputeRaisedBy")
  resolvedDisputes       Dispute[]              @relation("DisputeResolvedBy")
  submittedDisputeEvidence DisputeEvidence[]    @relation("EvidenceSubmittedBy")
  auditLogEntries        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([preferredLanguageId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Authentication module — Credentials auth support
//
// VerificationToken above is Auth.js-managed (reserved for its own
// Email/magic-link provider if one is ever added). The three models below
// are deliberately separate and owned entirely by this module's own code,
// to avoid two different systems writing to the same table for different
// purposes.
// ============================================================================

/// Single-use token proving control of an email address at registration
/// time (Credentials/email-password signup, distinct from Auth.js's own
/// magic-link VerificationToken). Consumed (deleted) on successful
/// verification; expired rows are safe to garbage-collect periodically.
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique /// SHA-256 of the token — the raw token is never stored
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Single-use token for the forgot-password → reset-password flow. Same
/// hash-at-rest treatment as EmailVerificationToken.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Long-lived, revocable refresh token backing the "Remember me" /
/// refresh-token requirement. Auth.js's own session JWT (short-lived,
/// stateless) stays the primary web-session mechanism — this table exists
/// so that mechanism can be *revoked* server-side (sign out everywhere,
/// ban a user mid-session) despite JWTs otherwise being stateless, and so
/// non-browser clients (a future mobile app) have a real refresh flow.
/// Rotated on every use (old row deleted, new row issued) so a stolen,
/// already-used refresh token is detectably invalid.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// Reference / lookup data (seeded — not marketplace entities per se)
// ============================================================================

/// Spoken/interface languages. Seeded at deploy time; referenced by User
/// (preferred language) and ProfessionalProfile (languages spoken, for
/// customer-professional matching).
model Language {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique /// ISO 639-1, e.g. "es", "en", "ca"
  name       String  /// English name, e.g. "Spanish"
  nativeName String  /// Native name, e.g. "Español"
  isActive   Boolean @default(true)

  users                User[]
  professionalProfiles ProfessionalProfile[] @relation("ProfessionalLanguages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

/// Platform roles for RBAC. Kept as seeded data (not a hardcoded enum) so
/// new roles (e.g. "SUPPORT") can be added without a schema migration.
/// A user can hold multiple roles at once — e.g. someone can be both a
/// CUSTOMER and a PROFESSIONAL on the same account.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique /// e.g. "CUSTOMER", "PROFESSIONAL", "ADMIN"
  name        String
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Join table: which roles a user holds.
model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Normalized geographic reference data (country → province → city), used
/// for structured location pickers/filtering. Deliberately independent of
/// Address, which keeps storing free-text city/province/country — linking
/// Address to this hierarchy (e.g. replacing Address.city with a FK) is a
/// bigger structural change than "add a seed script" and is left for a
/// deliberate future decision rather than made silently here.
model Country {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique /// ISO 3166-1 alpha-2, e.g. "ES"
  name String

  provinces Province[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model Province {
  id        String @id @default(uuid()) @db.Uuid
  countryId String @db.Uuid
  name      String

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([countryId])
  @@map("provinces")
}

model City {
  id         String @id @default(uuid()) @db.Uuid
  provinceId String @db.Uuid
  name       String

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

/// Platform-wide configuration as key/value rows (commission rate,
/// support email, feature flags, etc.) rather than hardcoded constants —
/// lets ops change these without a deploy. `value` is Json so a single
/// table can hold settings of any shape (a number, a string, an object).
model PlatformSetting {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  value       Json    @db.JsonB
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ============================================================================
// Enums
// ============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum AddressType {
  HOME
  WORK
  BILLING
  SERVICE_LOCATION
  OTHER
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Professional Module: lifecycle status of an individual professional's
/// profile, distinct from `verificationStatus` (trust/identity checks).
enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Professional Module: identity/trust verification state. Admin-only
/// future workflow moves a profile through PENDING -> VERIFIED/REJECTED;
/// professionals themselves can never set this field.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

