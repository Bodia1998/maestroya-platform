  contactEmail        String?
  contactPhone        String?
  addressLine         String?
  city                String?
  province            String?
  postalCode          String?
  country             String?       @default("ES")
  latitude            Float?
  longitude           Float?
  /// Explicit, domain-controlled lifecycle status — distinct from
  /// `isVerified` (trust signal) and `deletedAt` (hard removal). See
  /// company-rules.ts for the transition map.
  status              CompanyStatus @default(PENDING)
  suspendedAt         DateTime?

  owner   User             @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members CompanyMember[]

  categories ServiceCategory[] @relation("CompanyCategories")

  quotes                 Quote[]
  appointments             Appointment[]
  /// Order / Job Lifecycle module (Module 11).
  jobs                     Job[]
  reviewsReceived         Review[]                @relation("ReviewOfCompany")
  payouts                 Payout[]                @relation("PayoutToCompany")
  commissions              Commission[]            @relation("CommissionOnCompany")
  verificationDocuments    VerificationDocument[]  @relation("DocumentOfCompany")
  respondentInDisputes     Dispute[]               @relation("DisputeRespondentCompany")
  /// Module 18 — Company Professional.
  invitations              CompanyInvitation[]
  verifications            CompanyVerification[]
  /// Module 14 (extended by Module 18): a company-level portfolio, kept
  /// alongside the existing professional-anchored PortfolioItem rather than
  /// merging the two — see PortfolioItem.companyProfileId's own doc comment.
  portfolioItems           PortfolioItem[]
  /// Module 75 — Company Payout Eligibility: the company's own payout
  /// destination — see CompanyPayoutAccount's own doc comment.
  payoutAccount            CompanyPayoutAccount?
  /// Module 79 — Invoicing & Credit Notes.
  selfBillingAuthorizations SelfBillingAuthorization[]
  invoices                  Invoice[]
  creditNotes               CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([isVerified])
  @@index([status])
  @@index([deletedAt])
  /// Search & Ranking module (Module 19): supports city/province location
  /// matching and `minRating` filtering in
  /// CompanyDiscoveryRepository.searchCandidates.
  @@index([city])
  @@index([province])
  @@index([averageRating])
  /// Maps & Geolocation module (Module 20): supports the bounding-box radius
  /// pre-filter (computeBoundingBox) in
  /// CompanyDiscoveryRepository.searchCandidates.
  @@index([latitude, longitude])
  @@map("company_profiles")
}

/// Module 18 — Company Professional: a secure invitation for an existing
/// MaestroYa user to join a company. Scope: existing users only (matches
/// the module's minimum requirement — email invitations to non-existing
/// users are deferred, see docs/MODULE_18_COMPANY_PROFESSIONAL.md). The
/// token is never stored in plaintext (`tokenHash`, SHA-256 — same
/// convention as EmailVerificationToken/PasswordResetToken/RefreshToken).
/// `invitedUserId` is resolved server-side from `email` at creation time —
/// never client-supplied. At most one PENDING invitation may exist per
/// (companyId, email) — enforced by a partial unique index added in the
/// migration (Prisma cannot express partial unique indexes natively; same
/// pattern as ProfessionalVerification's active-case index).
model CompanyInvitation {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @db.Uuid
  email           String
  invitedUserId   String?                 @db.Uuid
  invitedByUserId String                  @db.Uuid
  /// The role the invitee will hold once accepted. Can never be OWNER —
  /// ownership only changes via TransferCompanyOwnershipUseCase, enforced
  /// in company-invitation-rules.ts, never at the DB layer alone.
  role            CompanyMemberRole       @default(MEMBER)
  status          CompanyInvitationStatus @default(PENDING)
  tokenHash       String                  @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  cancelledAt     DateTime?

  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedUser User?          @relation("CompanyInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedBy   User           @relation("CompanyInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([invitedUserId])
  @@index([email])
  @@index([expiresAt])
  @@map("company_invitations")
}

/// Module 18 — Company Professional: a single verification *case* for a
/// CompanyProfile — the company-side mirror of Module 17's
/// ProfessionalVerification aggregate (same DRAFT→PENDING→UNDER_REVIEW→
/// APPROVED/REJECTED/RESUBMISSION_REQUIRED→EXPIRED lifecycle, see
/// company-verification-rules.ts), kept as its own model rather than adding
/// a nullable `companyProfileId` onto ProfessionalVerification — that model
/// is `professionalProfileId`-required and reused as-is by Module 17's own
/// tests/queries, so extending it would risk destabilizing a working
/// module for a field it never needed. A company holds at most one
/// non-EXPIRED case at a time — enforced by a partial unique index
/// (`company_verifications_active_unique`, hand-written in the migration).
model CompanyVerification {
  id               String                  @id @default(uuid()) @db.Uuid
  companyProfileId String                  @db.Uuid
  status           VerificationCaseStatus  @default(DRAFT)
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?                 @db.Uuid
  rejectionReason  String?                 @db.Text
  resubmissionReason String?               @db.Text
  expiresAt        DateTime?

  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  reviewedBy     User?          @relation("CompanyVerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  documents CompanyVerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyProfileId])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([status, submittedAt])
  @@map("company_verifications")
}

/// Module 18 — Company Professional: a document uploaded as part of a
/// CompanyVerification case — mirrors ProfessionalVerificationDocument
/// exactly, reusing the same VerificationDocumentType/VerificationDocumentStatus
/// enums (no parallel enums introduced). Cascades with its parent case.
model CompanyVerificationDocument {
  id               String                     @id @default(uuid()) @db.Uuid
  verificationId   String                     @db.Uuid
  type             VerificationDocumentType
  status           VerificationDocumentStatus @default(PENDING)
  fileUrl          String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  rejectionReason  String?                    @db.Text

  verification CompanyVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationId])
  @@index([type])
  @@map("company_verification_documents")
}

/// Join table: which users work for which company, and in what capacity.
/// `removedAt` is a purpose-named soft-delete — it marks when someone's
/// membership ended without deleting the row, preserving "who worked here
/// and when" for dispute/audit purposes.
model CompanyMember {
  id               String            @id @default(uuid()) @db.Uuid
  companyProfileId String            @db.Uuid
  userId           String            @db.Uuid
  role             CompanyMemberRole @default(MEMBER)
  invitedAt        DateTime          @default(now())
  joinedAt         DateTime?
  removedAt        DateTime?

  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, userId])
  @@index([userId])
  @@index([companyProfileId, removedAt])
  @@map("company_members")
}

// ============================================================================
// Service Catalog
// ============================================================================

/// Hierarchical service categories (e.g. "Fontanería" → "Reparación de
/// fugas"). Self-referencing for subcategories. Soft-deleted rather than
/// hard-deleted so historical ServiceRequests keep a valid category
/// reference even after a category is deprecated.
model ServiceCategory {
  id          String                 @id @default(uuid()) @db.Uuid
  parentId    String?                @db.Uuid
  name        String
  slug        String                 @unique
  description String?
  iconUrl     String?
  status      ServiceCategoryStatus  @default(ACTIVE)
  sortOrder   Int                    @default(0)
  deletedAt   DateTime?

  parent   ServiceCategory?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("CategoryToSubcategory")

  professionals ProfessionalProfile[] @relation("ProfessionalCategories")
  companies     CompanyProfile[]      @relation("CompanyCategories")
  serviceRequests ServiceRequest[]
  /// Portfolio module (Module 14). Optional — a portfolio item may tag
  /// itself with the category of work it showcases.
  portfolioItems PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([status])
  @@index([deletedAt])
  @@map("service_categories")
}

// ============================================================================
// Portfolio (Module 14)
// ============================================================================

/// Portfolio module (Module 14): a showcase item ("previous work") a
/// professional attaches to their own profile. Always anchored to exactly
/// one ProfessionalProfile — never to a CompanyProfile (this codebase only
/// supports solo professionals end-to-end today, same scope note as
/// Review.revieweeProfessionalProfileId; see review-repository.ts) and
/// never editable/deletable by anyone but its owner.
///
/// `mediaUrl` is a plain URL string, not a stored file — Module 14 does not
/// introduce a new media/storage abstraction (an upload UI/flow is
/// explicitly deferred; see docs/MODULE_14_PORTFOLIO.md). When an upload
/// flow is eventually built, it can reuse the existing Cloudinary adapter
/// (see src/core/infrastructure/storage/cloudinary) and hand this field the
/// resulting `secure_url`, exactly like Address/ServiceRequest photos do
/// today — no schema change required.
///
/// `serviceCategoryId` is optional and `onDelete: SetNull` — unlike
/// ServiceRequest.categoryId (Restrict, since a request's category is
/// load-bearing for matching/history), a portfolio item's category tag is
/// purely descriptive, so a deprecated category should never block a
/// professional from managing their own portfolio.
///
/// Soft-deleted via `deletedAt` (never a hard delete) — same convention as
/// Address/Message/ProfessionalProfile elsewhere in this schema.
model PortfolioItem {
  id                    String    @id @default(uuid()) @db.Uuid
  /// Module 18 — Company Professional: made optional (was required) so a
  /// portfolio item can instead belong to a CompanyProfile. Exactly one of
  /// professionalProfileId/companyProfileId is set — enforced by a CHECK
  /// constraint added in the migration, same "exactly one" pattern as
  /// Quote/Job/Review. Every pre-existing row keeps its
  /// professionalProfileId unchanged; this is a nullability relaxation, not
  /// a data migration.
  professionalProfileId String?   @db.Uuid
  companyProfileId      String?   @db.Uuid
  serviceCategoryId     String?   @db.Uuid
  title                 String
  description           String?   @db.Text
  mediaUrl              String
  deletedAt             DateTime?

  /// Admin Panel (Module 16): admin content moderation, deliberately
  /// separate from `deletedAt` (owner-driven soft delete, Module 14).
  /// Non-null = an admin has hidden this item from public/professional
  /// listings; null = visible (default, unmoderated). Never set by the
  /// professional themselves — only ModeratePortfolioItemUseCase/
  /// RestorePortfolioItemUseCase (Admin Panel) write this field. Who
  /// moderated it and why is recorded on the append-only AuditLog, not
  /// denormalized here — same "narrow field, audit trail carries the
  /// detail" choice made for Review moderation (Review.status already
  /// existed pre-Module-16 and needed no schema change at all).
  moderatedAt DateTime?

  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  serviceCategory     ServiceCategory?     @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId, deletedAt, createdAt])
  @@index([companyProfileId, deletedAt, createdAt])
  @@index([serviceCategoryId])
  @@index([moderatedAt])
  @@map("portfolio_items")
}

// ============================================================================
// Requests, Quotes & Scheduling
// ============================================================================

/// A customer's request for a service — the core "job posting" of the
/// marketplace. FKs to CustomerProfile/ServiceCategory/Address are Restrict
/// (not Cascade): a request is a historical/financial record and must not
/// silently disappear if, say, an address is later removed from a user's
/// address book — removal there is itself soft-deleted for this reason.
model ServiceRequest {
  id               String                @id @default(uuid()) @db.Uuid
  customerId       String                @db.Uuid
  categoryId       String                @db.Uuid
  addressId        String                @db.Uuid
  title            String
  description      String                @db.Text
  status           ServiceRequestStatus  @default(DRAFT)
  urgency          RequestUrgency        @default(MEDIUM)
  budgetMin        Decimal?              @db.Decimal(10, 2)
  budgetMax        Decimal?              @db.Decimal(10, 2)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  expiresAt        DateTime?
  deletedAt        DateTime?

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  address  Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)

  photos        RequestPhoto[]
  quotes        Quote[]
  appointments  Appointment[]
  /// Order / Job Lifecycle module (Module 11). In practice at most one Job
  /// per ServiceRequest exists (a request has at most one accepted Quote —
  /// see AcceptQuoteUseCase's "one active job per request" guard), but this
  /// stays a list (like `quotes`/`appointments`) rather than an optional
  /// 1:1 back-relation for consistency with those siblings.
  jobs          Job[]
  conversations Conversation[]
  reviews       Review[]
  payments      Payment[]
  disputes      Dispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([categoryId])
  @@index([addressId])
  @@index([status, categoryId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("service_requests")
}

/// Photos the customer attaches to a request (e.g. a photo of the leak).
/// Cascades with its parent request — a photo has no meaning on its own.
model RequestPhoto {
  id               String   @id @default(uuid()) @db.Uuid
  serviceRequestId String   @db.Uuid
  url              String
  caption          String?
  sortOrder        Int      @default(0)

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@map("request_photos")
}

/// A professional's or company's bid on a ServiceRequest. Exactly one of
/// professionalProfileId / companyProfileId is set — enforced by a CHECK
/// constraint added in the migration (Prisma's schema language can't
/// express multi-column CHECK constraints natively). `submittedByUserId`
/// records which specific person submitted it (the solo pro themself, or
/// a specific CompanyMember acting on the company's behalf).
model Quote {
  id                    String      @id @default(uuid()) @db.Uuid
  serviceRequestId      String      @db.Uuid
  professionalProfileId String?     @db.Uuid
  companyProfileId      String?     @db.Uuid
  submittedByUserId     String      @db.Uuid
  status                QuoteStatus @default(PENDING)
  totalAmount           Decimal     @db.Decimal(10, 2)
  currency              String      @default("EUR")
  validUntil            DateTime?
  notes                 String?     @db.Text
  respondedAt           DateTime?

  /// Module 63 — Materials Procurement Workflow: defaults to
  /// PROFESSIONAL_SUPPLIED so every Quote created before this module
  /// existed (and any client that hasn't been updated to send a strategy
  /// yet) keeps behaving exactly as before — the conservative default,
  /// same reasoning QuoteItem.category's own doc comment gives for
  /// defaulting to LABOR.
  materialsStrategy         MaterialsStrategy @default(PROFESSIONAL_SUPPLIED)
  /// Set once the *customer* confirms they have purchased every item on
  /// the `materials` checklist (see ConfirmMaterialsPurchasedUseCase).
  /// Always null while materialsStrategy is PROFESSIONAL_SUPPLIED, and
  /// null for a CUSTOMER_PURCHASED quote until the customer confirms.
  /// StartJobUseCase refuses to start work while this is still null on a
  /// CUSTOMER_PURCHASED quote — see
  /// domain/services/materials-procurement-rules.ts.
  materialsConfirmedAt      DateTime?
  /// The customer User who confirmed the purchase. Deliberately a plain
  /// scalar (no `@relation`) — same convention as
  /// Appointment.proposedByUserId — since this module never needs to
  /// query "every quote a given user confirmed materials for".
  materialsConfirmedByUserId String? @db.Uuid

  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  submittedBy         User                 @relation("QuoteSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  items        QuoteItem[]
  /// Module 63 — Materials Procurement Workflow: the required-materials
  /// checklist a professional attaches when materialsStrategy is
  /// CUSTOMER_PURCHASED. Always empty for a PROFESSIONAL_SUPPLIED quote.
  materials    QuoteMaterial[]
  appointments Appointment[]
  payments     Payment[]
  /// Order / Job Lifecycle module (Module 11): 1:1 with the Job created
  /// when this Quote is accepted (see Job.quoteId's `@unique`) — null for
  /// every Quote that was never accepted.
  job          Job?
  /// Module 79 — Invoicing & Credit Notes.
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId, status])
  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([submittedByUserId])
  @@map("quotes")
}

/// Line items making up a Quote's total (labor, materials, call-out fee,
/// etc.). `amount` is stored (not computed) so historical quotes remain
/// accurate even if pricing logic changes later.
model QuoteItem {
  id          String            @id @default(uuid()) @db.Uuid
  quoteId     String            @db.Uuid
  description String
  quantity    Decimal           @db.Decimal(10, 2)
  unitPrice   Decimal           @db.Decimal(10, 2)
  amount      Decimal           @db.Decimal(10, 2)
  sortOrder   Int               @default(0)
  /// Module 22 — Commission & Financial: distinguishes labor from
  /// materials so commission (7.5% customer platform fee, 7.5%
  /// professional commission — see domain/services/commission-policy.ts)
  /// is calculated on labor only, never on materials. Defaults to LABOR so
  /// every quote item created before this module existed (and any created
  /// by a client that hasn't been updated to send a category yet) is
  /// treated as commissionable labor — the conservative default from the
  /// platform's own revenue perspective, and never silently zero-rates a
  /// line item's commission. The quote-submission UI is expected to let a
  /// professional mark specific items as MATERIALS going forward; this
  /// column only adds the capability, it does not retroactively
  /// reclassify anything.
  category    QuoteItemCategory @default(LABOR)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("quote_items")
}

/// Module 63 — Materials Procurement Workflow: one required-materials
/// checklist line item (e.g. "Bosch Condens 2300iW boiler", qty 1) that a
/// professional attaches to a Quote whose materialsStrategy is
/// CUSTOMER_PURCHASED. Deliberately separate from QuoteItem (which prices
/// labor/materials the professional is *including in their quoted
/// price*) — a QuoteMaterial never has a price, quantity is a plain
/// decimal (not currency), and this list only exists to tell the customer
/// what to go buy before the appointment. See
/// domain/services/materials-procurement-rules.ts for the validation this
/// list must satisfy, and Quote.materialsConfirmedAt for how the
/// customer's purchase confirmation is recorded.
model QuoteMaterial {
  id      String  @id @default(uuid()) @db.Uuid
  quoteId String  @db.Uuid
  name    String
  brand   String?
  model   String?
  /// Decimal (not Int) for consistency with QuoteItem.quantity — allows
  /// fractional quantities (e.g. "12.5 m of copper pipe").
  quantity Decimal @db.Decimal(10, 2)
  notes   String? @db.Text
  sortOrder Int    @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("quote_materials")
}

/// Order / Job Lifecycle module (Module 11): the execution-lifecycle
/// entity — created automatically (never by a customer/professional
/// directly) the moment a Quote is accepted, inside the same transaction
/// that already creates the initial Appointment (see
/// PrismaQuoteAcceptanceRepository.acceptQuote). 1:1 with the accepted
/// Quote (`quoteId` is unique); a Job can own multiple Appointments (e.g.
/// a multi-day renovation is one Job with several visit-level
/// Appointments — see Appointment's own doc comment).
///
/// Deliberately separate from ServiceRequest: ServiceRequest remains the
/// customer-facing marketplace posting/request lifecycle (DRAFT ->
/// PUBLISHED -> ACCEPTED, see ServiceRequestStatus), while Job.status is
/// the authoritative record of whether the *accepted work itself* has
/// started/finished — see JobStatus and domain/services/job-state.ts. No
/// Module 11 code ever writes ServiceRequest to IN_PROGRESS or COMPLETED
/// as a side effect of a Job/Appointment transition.
///
/// `customerId`/`professionalProfileId`/`companyProfileId` are
/// denormalized at creation time from the ServiceRequest/accepted Quote —
/// same "denormalize the frequently-joined FK" pattern Appointment already
/// uses for its own professionalProfileId/companyProfileId — so "find my
/// active jobs" never requires a join through ServiceRequest/Quote.
/// Exactly one of professionalProfileId/companyProfileId is set, enforced
/// by a CHECK constraint (same pattern as Quote/Appointment).
model Job {
  id                    String                  @id @default(uuid()) @db.Uuid
  serviceRequestId      String                  @db.Uuid
  quoteId               String                  @unique @db.Uuid
  customerId            String                  @db.Uuid
  professionalProfileId String?                 @db.Uuid
  companyProfileId      String?                 @db.Uuid
  status                JobStatus               @default(CREATED)
  startedAt             DateTime?
  startedByUserId       String?                 @db.Uuid
  completedAt           DateTime?
  completedByUserId     String?                 @db.Uuid
  cancelledAt           DateTime?
  cancelledByUserId     String?                 @db.Uuid
  cancellationReason    JobCancellationReason?
  cancellationNote      String?                 @db.Text

  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customer            CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  startedBy           User?                @relation("JobStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  completedBy         User?                @relation("JobCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  cancelledBy          User?               @relation("JobCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  appointments Appointment[]

  /// Reviews & Ratings module (Module 13): at most one customer review per
  /// Job — see Review.jobId's `@unique`. Optional because most Jobs will
  /// never be reviewed.
  review Review?

  /// Module 21 — Disputes & Support: a Job may have more than one Dispute
  /// over its lifetime (e.g. the customer and the professional each open
  /// their own — see dispute-rules.ts's doc comment on why both are
  /// allowed independently).
  disputes Dispute[]

  /// Module 22 — Commission & Financial: financial adjustments (refunds,
  /// commission reversals, payout holds/releases, etc.) recorded against
  /// this Job's financial settlement. See FinancialAdjustment's doc
  /// comment.
  financialAdjustments FinancialAdjustment[]

  /// Module 68 — Dispute Resolution & Financial Protection: dispute
  /// resolution decisions recorded against this Job — normally at most one
  /// per Dispute (see DisputeResolutionDecision.disputeId's `@unique`),
  /// but a Job may have more than one Dispute over its lifetime (see
  /// `disputes` above), so more than one decision per Job is possible.
  disputeResolutionDecisions DisputeResolutionDecision[]

  /// Module 66 — Job Completion & Payment Release Protection: at most one
  /// per Job — see JobCompletionConfirmation.jobId's `@unique`. Created the
  /// moment the professional completes the Job (never before); a Job that
  /// hasn't reached COMPLETED yet has none.
  completionConfirmation JobCompletionConfirmation?
  /// Module 79 — Invoicing & Credit Notes: at most one non-CANCELLED
  /// Invoice per Job — enforced by a partial unique index in the
  /// Module 79 migration, not representable directly in this schema.
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([customerId])
  @@index([professionalProfileId, status])
  @@index([companyProfileId, status])
  @@index([status])
  @@map("jobs")
}

/// Module 66 — Job Completion & Payment Release Protection: the
/// customer-confirmation + payment-release-gate record layered on top of
/// Job's own COMPLETED status (see JobCompletionConfirmationStatus's own
/// doc comment for why this is a separate table rather than new JobStatus
/// values). Created exactly once, atomically alongside `Job.complete()` —
/// see `JobRepository.complete`'s doc comment — never created directly by
/// a use case the way Dispute is.
///
/// `releaseStatus`/`releaseReason`/`releaseDecidedAt` are the persisted
/// output of `PaymentReleaseDecisionService`, written by
/// `EvaluatePaymentReleaseUseCase` — the ONE place in this codebase
/// allowed to write these three fields. No other use case (commission
/// recording, payout eligibility, KYC approval, etc.) may ever set
/// `releaseStatus` directly — see that use case's own doc comment for the
/// full rationale. `releaseStatus` starts at `PENDING` and is
/// re-evaluated (never just once) as the underlying conditions change —
/// customer confirms, a dispute opens/resolves, a trust payout hold is
/// applied/lifted, KYC is approved, etc.
model JobCompletionConfirmation {
  id    String @id @default(uuid()) @db.Uuid
  jobId String @unique @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  status JobCompletionConfirmationStatus @default(WAITING_FOR_CUSTOMER)

  /// Denormalized off Job.completedAt/completedByUserId at creation time —
  /// same "cheap read, no join" convention as Job's own
  /// customerId/professionalProfileId denormalization (see Job's doc
  /// comment) — this record's own lifecycle is entirely about what
  /// happens *after* that instant.
  professionalCompletedAt DateTime

  /// `professionalCompletedAt` + the confirmation-window duration (see
  /// `job-completion-confirmation-rules.ts`'s `CONFIRMATION_WINDOW_HOURS`)
  /// — snapshotted at creation time rather than recomputed from a
  /// possibly-changed config constant later, so a window that's already
  /// running is never silently shortened/lengthened by a config change.
  confirmationDeadlineAt DateTime

  confirmedAt         DateTime?
  confirmedByUserId   String?   @db.Uuid
  confirmedBy         User?     @relation("JobCompletionConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  /// Set only when status = DISPUTED — the real Dispute row backing the
  /// rejection (created via the existing Module 21 CreateDisputeUseCase,
  /// never duplicated here). Optional so a WAITING_FOR_CUSTOMER /
  /// TIMED_OUT_UNDER_REVIEW row (no dispute yet) has none.
  disputeId String?  @db.Uuid
  dispute   Dispute? @relation(fields: [disputeId], references: [id], onDelete: Restrict)

  /// Set once the confirmation window elapses without a customer response
  /// (status -> TIMED_OUT_UNDER_REVIEW) — the Module 65 ManualReviewCase
  /// opened for an admin to investigate. Reused, not duplicated — see
  /// `ProcessJobCompletionConfirmationsUseCase`'s own doc comment.
  manualReviewCaseId String?           @db.Uuid
  manualReviewCase   ManualReviewCase? @relation(fields: [manualReviewCaseId], references: [id], onDelete: SetNull)

  /// Best-effort reminder tracking so the reminder batch never re-sends
  /// the same reminder twice for the same row — not a strict idempotency
  /// boundary (see that use case's own doc comment), just duplicate-notice
  /// avoidance.
  reminderSentAt DateTime?

  /// The persisted output of PaymentReleaseDecisionService — see this
  /// model's own doc comment. `releaseReason` is the human-readable
  /// explanation shown to admins/support, never parsed back into logic.
  releaseStatus    PaymentReleaseStatus @default(PENDING)
  releaseReason    String               @db.Text
  releaseDecidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([confirmationDeadlineAt])
  @@index([releaseStatus])
  @@index([disputeId])
  @@index([manualReviewCaseId])
  @@map("job_completion_confirmations")
}

/// A scheduled (or completed) visit stemming from an accepted Quote. One
/// Quote can produce multiple Appointments (e.g. a multi-day renovation
/// job), which is why this isn't just a field on Quote.
///
/// Order / Job Lifecycle module (Module 11): every Appointment now also
/// belongs to exactly one Job (`jobId`, non-nullable) — the Job created
/// alongside it at quote-acceptance time, or, for a rescheduled
/// appointment, the same Job its superseded row belonged to (see
/// RescheduleAppointmentUseCase / PrismaAppointmentRepository.reschedule).
/// This is additive: quoteId/serviceRequestId are unchanged and continue
/// to be set exactly as before.
model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @db.Uuid
  quoteId          String            @db.Uuid
  serviceRequestId String            @db.Uuid
  addressId        String            @db.Uuid

  /// Booking & Scheduling module (Module 10): denormalized from the
  /// accepted Quote at creation time (see PrismaQuoteAcceptanceRepository).
  /// Exactly one of professionalProfileId / companyProfileId is set —
  /// enforced by a CHECK constraint (same "exactly one" pattern as
  /// Quote.professionalProfileId/companyProfileId), added in
  /// prisma/migrations/*_add_appointment_scheduling_lifecycle. This is what
  /// makes "does this professional have a conflicting appointment"
  /// queryable directly on Appointment instead of requiring a join through
  /// Quote — see the composite indexes below and
  /// ConfirmAppointmentUseCase's conflict check.
  professionalProfileId String? @db.Uuid
  companyProfileId      String? @db.Uuid

  /// Booking/Appointments module (MVP): nullable because an Appointment is
  /// now created immediately on Quote acceptance, before any actual
  /// scheduling — see the PENDING_SCHEDULE status above and
  /// prisma/migrations/20260723000000_add_appointment_pending_schedule.
  /// Booking & Scheduling module (Module 10): filled in by
  /// ConfirmAppointmentUseCase once the other party confirms a proposed
  /// time — this is always the authoritative, conflict-checked schedule,
  /// never a placeholder.
  ///
  /// Timezone decision (Module 10): unlike the rest of this schema (which
  /// uses Prisma's default `TIMESTAMP(3)`, i.e. timezone-naive, per the
  /// audit report's "Database gaps" finding), every DateTime field on this
  /// model is explicitly `@db.Timestamptz(3)` — stored as a true UTC
  /// instant. Scheduling is exactly the place a naive timestamp becomes
  /// ambiguous once the platform has customers/professionals in different
  /// IANA zones (EU expansion) or across a DST boundary (Spain observes
  /// DST). A platform-wide migration of every DateTime column is explicitly
  /// out of scope for this module (see the audit's "CAN BE DEFERRED"
  /// section) — this is a narrow, self-contained exception scoped to the
  /// one model where the ambiguity is actually user-visible today. The
  /// application layer always converts a proposed local time to its UTC
  /// instant at the DTO boundary using the proposer's own `User.timezone`
  /// (see booking.dto.ts) before it ever reaches this column.
  scheduledStart   DateTime? @db.Timestamptz(3)
  scheduledEnd     DateTime? @db.Timestamptz(3)

  /// Booking & Scheduling module (Module 10): an unconfirmed time put
  /// forward by either party (see AppointmentStatus.PROPOSED and
  /// domain/services/appointment-state.ts). Left in place after
  /// confirmation as a record of what was last proposed; superseded values
  /// from earlier counter-proposals are not separately retained (only the
  /// most recent proposal matters operationally — full history lives at
  /// the Appointment-row level via rescheduling, not per-proposal).
  proposedStart    DateTime? @db.Timestamptz(3)
  proposedEnd      DateTime? @db.Timestamptz(3)
  proposedByUserId String?   @db.Uuid

  actualStart      DateTime? @db.Timestamptz(3)
  actualEnd        DateTime? @db.Timestamptz(3)
  status           AppointmentStatus @default(PENDING_SCHEDULE)
  notes            String?           @db.Text

  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelledByUserId  String?                         @db.Uuid
  cancellationReason AppointmentCancellationReason?
  /// Booking & Scheduling module (Module 10): optional free-text detail
  /// alongside the typed `cancellationReason` — kept separate so a future
  /// Payment/Stripe Connect refund-eligibility workflow can key off the
  /// typed enum without parsing prose.
  cancellationNote   String?                         @db.Text

  /// Booking & Scheduling module (Module 10): non-destructive rescheduling.
  /// Set only on the *new* Appointment row created by
  /// RescheduleAppointmentUseCase, pointing back at the row it supersedes.
  /// The old row is transitioned to RESCHEDULED and never mutated further —
  /// its proposal/confirmation/cancellation history is preserved forever
  /// instead of being overwritten in place. `@unique` because a superseded
  /// appointment can be rescheduled into at most one successor.
  rescheduledFromId String? @unique @db.Uuid

  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  serviceRequest      ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  address             Address              @relation(fields: [addressId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  proposedBy          User?                @relation("AppointmentProposedBy", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  cancelledBy         User?                @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  rescheduledFrom     Appointment?         @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo       Appointment?         @relation("AppointmentReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([quoteId])
  @@index([serviceRequestId])
  @@index([addressId])
  @@index([scheduledStart])
  @@index([status])
  @@index([professionalProfileId, status, scheduledStart, scheduledEnd])
  @@index([companyProfileId, status, scheduledStart, scheduledEnd])
  @@map("appointments")
}

// ============================================================================
// Messaging
// ============================================================================

/// A chat thread. Usually tied to a ServiceRequest (customer ↔
/// professional/company discussing a job); `serviceRequestId` is nullable
/// to also allow platform/support conversations not tied to a request.
model Conversation {
  id               String              @id @default(uuid()) @db.Uuid
  serviceRequestId String?             @db.Uuid
  status           ConversationStatus  @default(ACTIVE)
  lastMessageAt    DateTime?

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([lastMessageAt])
  @@map("conversations")
}

/// Join table: who's in a conversation. `leftAt` lets someone leave
/// without losing the historical fact they were part of it; `lastReadAt`
/// backs unread-message counts.
model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// A single chat message. `senderId` is Restrict (not Cascade) so message
/// history survives even if the app is ever configured to hard-delete a
/// user — in practice, User uses soft delete (`deletedAt`) for exactly
/// this reason, so this constraint should rarely if ever actually block
/// anything. `deletedAt` supports a user "unsending" their own message.
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderId       String        @db.Uuid
  body           String        @db.Text
  status         MessageStatus @default(SENT)
  /// Booking & Scheduling module (Module 10) addition — see MessageType's
  /// doc comment.
  type           MessageType   @default(USER)
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  attachments MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/// Files attached to a message (photos, PDFs, etc.). Cascades with its
/// parent message.
model MessageAttachment {
  id            String  @id @default(uuid()) @db.Uuid
  messageId     String  @db.Uuid
  url           String
  fileName      String
  fileType      String
  fileSizeBytes Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId])
  @@map("message_attachments")
}

// ============================================================================
// Reviews
// ============================================================================

/// A customer's review of a completed Job (Reviews & Ratings module,
/// Module 13). Originally anchored to ServiceRequest only; Module 13
/// re-anchors it to `Job` (`jobId`, unique — one review per Job) because
/// Job, not ServiceRequest, is the authoritative record of "was the work
/// actually completed" (see job-state.ts and the Module 11 audit report,
/// "Finding 1"). `serviceRequestId` is kept as an additional denormalized
/// FK for convenient querying — same "keep the frequently-joined FK
/// alongside the newer authoritative one" pattern Appointment already uses
/// for quoteId/serviceRequestId next to jobId — but Job is always the
/// source of truth for eligibility/authorization, never ServiceRequest or
/// Quote directly.
///
/// Exactly one of revieweeProfessionalProfileId / revieweeCompanyProfileId
/// is set (CHECK constraint added in migration), matching the same
/// solo-pro-vs-company duality used on Quote/Payout/etc — this keeps the
/// model ready for a future company-side review without redesign. `response`
/// lets the professional/company reply publicly, a standard marketplace
/// pattern; unused by Module 13 (no reply use case yet) but left in place
/// for a future module to fill in.
///
/// `status` defaults to PUBLISHED, not PENDING: Module 13 does not
/// implement a moderation/approval workflow (that's Module 16 — Admin
/// Panel's job), so a review is visible as soon as it's created. The enum
/// itself (PENDING/PUBLISHED/FLAGGED/REMOVED) is left untouched so Module
/// 16 can later flag/remove a review, or reintroduce a pending-approval
/// step, without a schema change.
///
/// Module 41 — Reviews & Ratings: `response`/`respondedAt` are now used
/// (RespondToReviewUseCase) — no schema change was needed, exactly as this
/// doc comment's own Module 13 note anticipated. `deletedAt` (below) is new
/// in Module 41: an author-initiated soft delete, distinct from `status`,
/// which remains Module 16's own admin-moderation axis.
model Review {
  id                             String       @id @default(uuid()) @db.Uuid
  jobId                          String       @unique @db.Uuid
  serviceRequestId               String       @db.Uuid
  reviewerId                     String       @db.Uuid
  revieweeProfessionalProfileId  String?      @db.Uuid
  revieweeCompanyProfileId       String?      @db.Uuid
  rating                         Int /// 1–5, enforced by CHECK constraint in migration
  comment                        String?      @db.Text
  response                       String?      @db.Text
  respondedAt                    DateTime?
  status                         ReviewStatus @default(PUBLISHED)
  deletedAt                      DateTime?

  job                  Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  serviceRequest       ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  reviewer             User                 @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeProfessional ProfessionalProfile? @relation("ReviewOfProfessional", fields: [revieweeProfessionalProfileId], references: [id], onDelete: Restrict)
  revieweeCompany      CompanyProfile?      @relation("ReviewOfCompany", fields: [revieweeCompanyProfileId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([reviewerId])
  @@index([revieweeProfessionalProfileId])
  @@index([revieweeCompanyProfileId])
  @@index([status])
  /// Module 41 — Reviews & Ratings: composite index covering
  /// ListProfessionalReviewsUseCase/GetProfessionalRatingSummaryUseCase's
  /// query shape exactly (`WHERE revieweeProfessionalProfileId = ? AND
  /// status = 'PUBLISHED' AND deletedAt IS NULL`, see
  /// PrismaReviewRepository's `PUBLIC_WHERE`) — the pre-existing single-
  /// column `revieweeProfessionalProfileId` index above still serves
  /// `findByJobId`-adjacent lookups, but every public-facing read this
  /// module added/extended now hits this one instead, avoiding a filter
  /// step over rows an index-only scan of the single-column index would
  /// still have to fetch.
  @@index([revieweeProfessionalProfileId, status, deletedAt])
  @@map("reviews")
}

// ============================================================================
// Payments & Finance
// ============================================================================

/// A customer's payment for a ServiceRequest/Quote. All money fields use
/// Decimal(10,2) — never Float — to avoid floating-point rounding errors
/// in financial data.
model Payment {
  id                    String            @id @default(uuid()) @db.Uuid
  serviceRequestId      String            @db.Uuid
  quoteId               String?           @db.Uuid
  payerId               String            @db.Uuid
  amount                Decimal           @db.Decimal(10, 2)
  currency              String            @default("EUR")
  method                PaymentMethodType
  status                PaymentStatus     @default(PENDING)
  stripePaymentIntentId String?           @unique
  capturedAt            DateTime?
  failureReason         String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote          Quote?         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  payer          User           @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)

  refunds      Refund[]
  commission   Commission?
  transactions Transaction[] @relation("TransactionPayment")
  /// Module 22 — Commission & Financial: adjustments recorded against this
  /// specific Payment (a dispute-driven partial refund, a platform-fee
  /// refund, etc.) — most FinancialAdjustments are only anchored to a Job,
  /// this is set only once a Payment actually exists to adjust.
  financialAdjustments FinancialAdjustment[]
  /// Module 68 — Dispute Resolution & Financial Protection: decisions
  /// evaluated against this Payment, if any existed at decision time.
  disputeResolutionDecisions DisputeResolutionDecision[]
  /// Module 79 — Invoicing & Credit Notes.
  invoices                   Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([quoteId])
  @@index([payerId])
  @@index([status])
  @@map("payments")
}

/// The platform's fee taken from a Payment. One-to-one with Payment —
/// every captured payment produces exactly one commission record, even if
/// its rate is later found to be 0 (waived). `rateBps` (basis points,
/// e.g. 1000 = 10.00%) avoids the float-precision issues a percentage
/// stored as a fraction would introduce.
///
/// Unlike Quote/Review/Payout/VerificationDocument/Dispute, the
/// professionalProfileId/companyProfileId pair here is constrained to
/// "at most one" (not "exactly one") in the migration — a manual platform
/// adjustment with neither set is a legitimate edge case for this model.
model Commission {
  id                    String           @id @default(uuid()) @db.Uuid
  paymentId             String           @unique @db.Uuid
  professionalProfileId String?          @db.Uuid
  companyProfileId      String?          @db.Uuid
  rateBps               Int
  amount                Decimal          @db.Decimal(10, 2)
  status                CommissionStatus @default(PENDING)
  settledAt             DateTime?

  payment             Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation("CommissionOnProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("CommissionOnCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionCommission")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([status])
  @@map("commissions")
}

/// A payout of earnings to a professional or company via Stripe Connect.
/// Same solo-pro-vs-company duality pattern as Quote/Review (CHECK
/// constraint in migration).
model Payout {
  id                     String       @id @default(uuid()) @db.Uuid
  professionalProfileId  String?      @db.Uuid
  companyProfileId       String?      @db.Uuid
  amount                 Decimal      @db.Decimal(10, 2)
  currency               String       @default("EUR")
  status                 PayoutStatus @default(PENDING)
  stripeTransferId       String?      @unique
  periodStart            DateTime?
  periodEnd              DateTime?
  processedAt            DateTime?
  failureReason          String?

  /// Module 76 — Professional Payout Execution: the specific Job this
  /// per-job payout was executed for. `@unique` (not just indexed) is the
  /// database-level backstop against a second successful/in-flight Payout
  /// ever being created for the same Job — see
  /// `ExecuteProfessionalPayoutUseCase`'s own doc comment on why the
  /// application-level idempotency check alone is not trusted. Nullable
  /// (not required) so a future *periodic* payout batch (the
  /// `periodStart`/`periodEnd` shape this model already has, never used by
  /// Module 76) never collides with this constraint — Module 76 rows
  /// always set it, a periodic batch row never does.
  jobId String? @unique @db.Uuid

  /// Module 76 — Professional Payout Execution: the captured Payment this
  /// payout's amount was derived from (via the already-recorded
  /// `Commission` row — see `ExecuteProfessionalPayoutUseCase`'s own doc
  /// comment). Read-only correlation for reconciliation/observability;
  /// never itself re-derives the amount at read time. Deliberately not a
  /// Prisma relation object (unlike `professionalProfile`/`companyProfile`
  /// above) — this migration only touches the `Payout` model, never
  /// `Payment`'s, matching this module's "minimal, focused changes" rule.
  paymentId String? @db.Uuid

  /// Module 76 — Professional Payout Execution: the deterministic key
  /// (`payout:<jobId>`) used both as this row's own duplicate-Payout guard
  /// (`@unique`) and as the Stripe `Idempotency-Key` request header for
  /// `stripe.transfers.create` — see `StripeTransferGatewayAdapter`'s own
  /// doc comment for why the *same* key is reused across a retried
  /// execution rather than a fresh one per attempt (Stripe idempotency
  /// keys are only useful when reused).
  idempotencyKey String? @unique

  /// Module 76 — Professional Payout Execution: how many times
  /// `ExecuteProfessionalPayoutUseCase` has attempted to move this Payout
  /// to `PAID` — incremented on every `FAILED` outcome, never on a
  /// duplicate/idempotent short-circuit. Observability/reconciliation only
  /// (Module 80); never itself a business-rule input.
  attemptCount Int @default(0)

  /// Module 76 — Professional Payout Execution: wall-clock time of the
  /// most recent execution attempt (successful or failed) — `processedAt`
  /// below is set only once, on the attempt that actually succeeds.
  lastAttemptedAt DateTime?

  /// Module 77 — Refund & Dispute Financial Execution: Stripe's own
  /// `Transfer Reversal.id` (`trr_...`) — set only once `status` first
  /// reaches `REVERSED`.
  stripeReversalId String? @unique

  /// Module 77: the deterministic `payout-reversal:<payoutId>` key — this
  /// row's own duplicate-reversal guard and the Stripe idempotency key
  /// reused across every retried reversal attempt — same role as
  /// `idempotencyKey` above, for the reversal operation.
  reversalIdempotencyKey String? @unique

  /// Module 77: the amount actually reversed — always equal to `amount`
  /// today (only a full reversal is supported).
  reversedAmount Decimal? @db.Decimal(10, 2)

  /// Module 77: set only when a reversal attempt fails. Cleared back to
  /// null once a later retry succeeds — same convention as `failureReason`.
  reversalFailureReason String?

  /// Module 77: how many times a reversal has been attempted — same
  /// observability-only role as `attemptCount`.
  reversalAttemptCount Int @default(0)

  /// Module 77: wall-clock time this Payout was actually reversed.
  reversedAt DateTime?

  professionalProfile ProfessionalProfile? @relation("PayoutToProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("PayoutToCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionPayout")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([status])
  @@index([paymentId])
  @@map("payouts")
}

/// A refund against a Payment. `requestedByUserId` may be the customer or
/// an admin acting on a dispute resolution.
model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  requestedByUserId String       @db.Uuid
  amount            Decimal      @db.Decimal(10, 2)
  reason            RefundReason
  status            RefundStatus @default(REQUESTED)
  stripeRefundId    String?      @unique
  processedAt       DateTime?
  notes             String?      @db.Text

  /// Module 77 — Refund & Dispute Financial Execution: the
  /// `FinancialAdjustment` (a refund-type one) this Refund executes.
  /// `@unique` — the database-level guarantee that at most one Stripe
  /// refund is ever executed per already-decided adjustment (see
  /// `RefundRepository`'s own doc comment). Deliberately a plain scalar
  /// column with no Prisma relation object — mirrors `Payout.paymentId`'s
  /// own precedent (Module 76) of touching only this migration's own
  /// model, never `FinancialAdjustment`'s; the FK constraint is still
  /// added at the database level (see this migration's own SQL).
  financialAdjustmentId String? @unique @db.Uuid

  /// Module 77: the deterministic `refund:<financialAdjustmentId>` key —
  /// this row's own duplicate guard and the Stripe request idempotency
  /// key reused across every retried execution attempt.
  idempotencyKey String? @unique

  /// Module 77: set only when `status === "FAILED"` — the reason
  /// surfaced by the most recent failed attempt. Cleared back to null
  /// once a later retry succeeds.
  failureReason String?

  /// Module 77: how many times execution of this refund has been
  /// attempted — observability/reconciliation only, incremented on every
  /// `FAILED` outcome.
  attemptCount Int @default(0)

  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedByUser User    @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  transactions Transaction[] @relation("TransactionRefund")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("refunds")
}

/// Append-only general ledger. Every money movement (charge, refund,
/// payout, commission, manual adjustment) gets one Transaction row, giving
/// a single queryable audit trail independent of which specific table
/// (Payment/Refund/Payout/Commission) generated it. At most one of the
/// four source FKs is set, matching which `type` the row is.
model Transaction {
  id            String             @id @default(uuid()) @db.Uuid
  paymentId     String?            @db.Uuid
  payoutId      String?            @db.Uuid
  refundId      String?            @db.Uuid
  commissionId  String?            @db.Uuid
  type          TransactionType
  status        TransactionStatus  @default(PENDING)
  amount        Decimal            @db.Decimal(10, 2) /// signed: positive = inflow to the platform, negative = outflow
  currency      String             @default("EUR")
  description   String?
  /// Module 22 — Commission & Financial: caller-supplied idempotency key
  /// (e.g. "commission:<paymentId>", "dispute-adjustment:<disputeId>:<type>")
  /// so a retried financial operation (webhook redelivery, a double-submit
  /// admin action) can never create a second ledger entry for the same
  /// logical event — see FinancialLedgerRepository.findByIdempotencyKey.
  /// Nullable because the two pre-existing writers implied by this model
  /// (none yet in code) may not always have a natural key; every Module 22
  /// write path always supplies one.
  idempotencyKey String? @unique

  payment    Payment?    @relation("TransactionPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  payout     Payout?     @relation("TransactionPayout", fields: [payoutId], references: [id], onDelete: Restrict)
  refund     Refund?     @relation("TransactionRefund", fields: [refundId], references: [id], onDelete: Restrict)
  commission Commission? @relation("TransactionCommission", fields: [commissionId], references: [id], onDelete: Restrict)

  /// Module 22 — Commission & Financial: the FinancialAdjustment this
  /// ledger entry was created to record, if any (1:1 — see
  /// FinancialAdjustment.transactionId's `@unique`).
  financialAdjustment FinancialAdjustment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([payoutId])
  @@index([refundId])
  @@index([commissionId])
  @@index([type, status])
  @@index([createdAt])
  @@map("transactions")
}

/// Module 22 — Commission & Financial: the boundary Module 21 (Disputes &
/// Support) uses to request a financial consequence of a resolved dispute
/// without executing money movement itself (see
/// ResolveDisputeUseCase's own doc comment and Dispute.resolution's —
/// `FINANCIAL_ADJUSTMENT_REQUIRED` is the generic "Module 22 must act"
/// flag they describe). Always anchored to a Job (every dispute is); a
/// Payment reference is added once one exists to adjust. Recording an
/// adjustment here is a two-step, auditable process: `create()` writes a
/// PENDING row (idempotent on `idempotencyKey`), and a separate `apply()`
/// call links the resulting ledger Transaction and marks it APPLIED —
/// this module never silently marks money as moved without a
/// corresponding Transaction row existing first.
model FinancialAdjustment {
  id                String                    @id @default(uuid()) @db.Uuid
  jobId             String                    @db.Uuid
  disputeId         String?                   @db.Uuid
  paymentId         String?                   @db.Uuid
  type              FinancialAdjustmentType
  status            FinancialAdjustmentStatus @default(PENDING)
  amount            Decimal                   @db.Decimal(10, 2)
  currency          String                    @default("EUR")
  reason            String?                   @db.Text
  requestedByUserId String                    @db.Uuid
  /// e.g. "dispute-adjustment:<disputeId>:<type>" — guards against the
  /// same dispute resolution being processed twice (a double-submit admin
  /// action, a retried background job, etc.).
  idempotencyKey    String                    @unique
  transactionId     String?                   @unique @db.Uuid
  /// Module 68 — Dispute Resolution & Financial Protection: the
  /// DisputeResolutionDecision this adjustment was created to carry out,
  /// if any — null for adjustments created outside Module 68's atomic
  /// resolution flow (there are none as of Module 68; kept nullable so no
  /// future caller of CreateFinancialAdjustmentUseCase is forced to
  /// fabricate one). See DisputeResolutionDecision's own doc comment for
  /// why a single decision can require more than one adjustment.
  resolutionDecisionId String?                @db.Uuid
  appliedAt         DateTime?

  job             Job                        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  dispute         Dispute?                   @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  payment         Payment?                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedByUser User                       @relation("FinancialAdjustmentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  transaction     Transaction?               @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  resolutionDecision DisputeResolutionDecision? @relation(fields: [resolutionDecisionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([disputeId])
  @@index([paymentId])
  @@index([status])
  @@index([resolutionDecisionId])
  @@map("financial_adjustments")
}

/// Module 68 — Dispute Resolution & Financial Protection: the single
/// authoritative, immutable-once-created record of a Dispute's financial
/// resolution — WHAT was decided (`outcome`), WHY (`reason`), WHO decided
/// it (`decidedByUserId`), WHEN (`decidedAt`), WHICH dispute/job/payment it
/// belongs to, and WHETHER it has already been applied (`status`/
/// `appliedAt`). See DisputeResolutionDecisionRepository's own doc comment
/// for why this exists as its own model rather than being folded into
/// Dispute.resolution or FinancialAdjustment.
///
/// At most one row per Dispute (`disputeId` unique) — a PARTIAL_RESOLUTION
/// that requires more than one FinancialAdjustment (e.g. a partial refund
/// to the customer AND a payout reduction for the professional) still
/// produces exactly one DisputeResolutionDecision; every resulting
/// FinancialAdjustment links back to it via
/// FinancialAdjustment.resolutionDecisionId.
model DisputeResolutionDecision {
  id        String  @id @default(uuid()) @db.Uuid
  disputeId String  @unique @db.Uuid
  jobId     String  @db.Uuid
  paymentId String? @db.Uuid

  /// Denormalized copy of Dispute.resolution at the instant this decision
  /// was created — never re-read from Dispute afterward.
  resolution DisputeResolution
  outcome    DisputeFinancialOutcome
  status     DisputeResolutionDecisionStatus @default(PENDING_APPLICATION)
  reason     String                          @db.Text

  decidedByUserId String   @db.Uuid
  decidedAt       DateTime
  appliedAt       DateTime?

  dispute         Dispute              @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  job             Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  payment         Payment?             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  decidedByUser   User                 @relation("DisputeResolutionDecisionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  financialAdjustments FinancialAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([paymentId])
  @@index([status])
  @@map("dispute_resolution_decisions")
}

// ============================================================================
// Notifications
// ============================================================================

/// A single notification instance for a user across any channel. Unlike
/// most tables here, this Cascades with User — notifications are
/// disposable, not part of the financial/legal record, so there's no
/// reason to block a (hypothetical, rare) hard user deletion on their
/// notification history.
/// Notifications module (Module 15): a single in-app notification instance
/// for a user. Reshaped from the Phase-1 placeholder version (see git
/// history) — that shape anticipated multi-channel (email/SMS/push)
/// delivery (`channel`/`status`/`sentAt`) that no module has implemented;
/// Module 15 is in-app only, so those fields were replaced with the
/// concrete shape it actually needs: `resourceType`/`resourceId` +
/// `actionUrl` for deep-linking back to the resource the notification is
/// about, `metadata` for small structured extras, and `dismissedAt` as the
/// soft-delete marker (distinct from `readAt` — see the module doc's
/// "Read/Unread vs. Dismissal" section). Multi-channel delivery remains a
/// valid future extension that would reintroduce a channel/status pair
/// without disturbing this shape.
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  type         NotificationType
  title        String
  message      String           @db.Text
  /// e.g. "SERVICE_REQUEST" | "QUOTE" | "CONVERSATION" | "APPOINTMENT" |
  /// "JOB" | "REVIEW" — free-text tag, not a DB enum, since new resource
  /// kinds may be added by future modules without a migration here.
  resourceType String?
  resourceId   String?
  /// Safe, internal-only path (see notification-rules.ts's isSafeActionUrl)
  /// — never an absolute/external URL, never javascript:/data:/vbscript:.
  actionUrl    String?
  metadata     Json?            @db.JsonB
  /// null = unread. Distinct from dismissedAt — a read notification still
  /// appears in the list until dismissed.
  readAt       DateTime?
  /// null = active. Non-null = soft-deleted; excluded from listings, unread
  /// counts, and mark-all-as-read. Never hard-deleted.
  dismissedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dismissedAt, createdAt])
  @@index([userId, readAt, dismissedAt])
  @@map("notifications")
}

// ============================================================================
// Trust & Safety
// ============================================================================

/// A KYC/verification document uploaded by a professional or company.
/// Same solo-pro-vs-company duality pattern (CHECK constraint in
/// migration). `reviewedByUserId` uses SetNull (not Restrict) — losing
/// the "who reviewed this" pointer if that admin account is later removed
/// is an acceptable trade-off; the document and its outcome remain intact.
model VerificationDocument {
  id                     String                      @id @default(uuid()) @db.Uuid
  professionalProfileId  String?                     @db.Uuid
  companyProfileId       String?                     @db.Uuid
  type                   VerificationDocumentType
  status                 VerificationDocumentStatus  @default(PENDING)
  fileUrl                String
  expiresAt              DateTime?
  reviewedByUserId       String?                     @db.Uuid
  reviewedAt             DateTime?
  rejectionReason        String?
  deletedAt              DateTime?

  professionalProfile ProfessionalProfile? @relation("DocumentOfProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation("DocumentOfCompany", fields: [companyProfileId], references: [id], onDelete: Restrict)
  reviewedBy          User?                @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@index([reviewedByUserId])
  @@index([status])
  @@map("verification_documents")
}

/// Professional Verification module (Module 17): a single verification
/// *case* for an individual professional — the aggregate root of the review
/// workflow. Deliberately separate from the pre-existing, unused
/// `VerificationDocument` model (which is profile-anchored, company-capable,
/// and has no case/lifecycle concept): this module needs a case that moves
/// through an explicit state machine and owns its own set of documents, so
/// it introduces its own aggregate rather than overloading that placeholder.
///
/// A professional accumulates a *history* of cases over time (one row per
/// case), but only ever has one that is not EXPIRED at any moment — enforced
/// by a partial unique index (`professional_verifications_active_unique`,
/// added in the migration, since Prisma can't express a partial index) as
/// well as by application logic in CreateProfessionalVerificationUseCase.
///
/// `professionalProfileId` is Restrict (a case is a trust/compliance record
/// and must not silently vanish if the profile row is ever hard-deleted —
/// the profile itself is soft-deleted, same rationale as elsewhere in this
/// schema). `reviewedByUserId` is SetNull, matching VerificationDocument.
model ProfessionalVerification {
  id                    String                          @id @default(uuid()) @db.Uuid
  professionalProfileId String                          @db.Uuid
  status                ProfessionalVerificationStatus  @default(DRAFT)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedByUserId      String?                         @db.Uuid
  /// Set only when status = REJECTED. Never exposed on any public API.
  rejectionReason       String?                         @db.Text
  /// Set only when status = RESUBMISSION_REQUIRED — instructions the
  /// professional sees so they know what to fix. Never exposed publicly.
  resubmissionReason    String?                         @db.Text
  /// Set when APPROVED — the point past which an APPROVED case is treated as
  /// EXPIRED and a fresh case may be opened.
  expiresAt             DateTime?

  /// Module 59 — Professional Verification (Persona). `MANUAL` (the
  /// default) for every pre-existing/Module-17-only case. `providerXxx`
  /// columns are always null while `provider = MANUAL`.
  provider               VerificationProviderName @default(MANUAL)
  /// Persona's own identifier for the inquiry created for this case
  /// (`Inquiry.id`) — opaque to the domain, used only to correlate a
  /// later `getVerification`/`refreshStatus`/webhook call back to this
  /// row. Never a document image or any raw PII — see this module's GDPR
  /// notes in docs/MODULE_59_PROFESSIONAL_VERIFICATION_PERSONA.md.
  providerVerificationId String?                   @db.VarChar(191)
  /// The provider's own last-observed status string (e.g. Persona's
  /// `created`/`pending`/`completed`/`failed`/`needs_review`/`expired`),
  /// kept verbatim for observability/debugging. Never the source of
  /// truth for `status` above — `RefreshVerificationStatusUseCase` maps
  /// it through `verification-provider-outcome.ts` and
  /// `professional-verification-rules.ts`'s own `canTransition` before
  /// ever changing `status`.
  providerStatus         String?
  /// When `providerStatus` was last refreshed from the provider (a
  /// `refreshStatus`/`getVerification` call or, in the future, a
  /// validated webhook) — lets an operator/CLI report tell a stale sync
  /// apart from one that never started.
  providerSyncedAt       DateTime?

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  reviewedBy          User?               @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  documents ProfessionalVerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([status, submittedAt])
  /// Module 59: correlates an inbound provider lookup/webhook (which only
  /// carries the provider's own inquiry id) back to a case, and lets
  /// `SynchronizeVerificationUseCase` cheaply select every PERSONA case
  /// still awaiting a decision.
  @@index([provider, providerVerificationId])
  @@map("professional_verifications")
}

/// Professional Verification module (Module 17): a document uploaded as part
/// of a verification case. Cascades with its parent case (a document has no
/// meaning outside the case it was uploaded for). `fileUrl` is a sensitive
/// Cloudinary reference — never returned on any public/professional-profile
/// API response; only the owning professional and ADMIN/SUPER_ADMIN can read
/// it (see the module's use cases and docs). Reuses the existing
/// `VerificationDocumentType`/`VerificationDocumentStatus` enums rather than
/// introducing parallel ones.
model ProfessionalVerificationDocument {
  id               String                     @id @default(uuid()) @db.Uuid
  verificationId   String                     @db.Uuid
  type             VerificationDocumentType
  status           VerificationDocumentStatus @default(PENDING)
  fileUrl          String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  /// Optional per-document rejection note (a reviewer may reject one
  /// document without rejecting the whole case). Never exposed publicly.
  rejectionReason  String?                    @db.Text

  verification ProfessionalVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationId])
  @@index([type])
  @@map("professional_verification_documents")
}

/// A dispute raised over an Order/Job (Module 21 — Disputes & Support).
/// Anchored primarily to `jobId` (added by Module 21's migration) rather
/// than only ServiceRequest: the task a customer/professional actually
/// disputes is the concrete Job engagement, and Job is also where
/// Module 22 (future financial settlement) will need to look up amounts.
/// `serviceRequestId` is kept alongside `jobId` (always set to
/// `job.serviceRequestId` at creation) purely as a query-convenience
/// denormalization for admin filtering/search — it is never independently
/// writable and never diverges from the Job it was copied from; see
/// docs/MODULE_21_DISPUTES_SUPPORT.md, "Job vs ServiceRequest anchoring"
/// for the tradeoff. `quoteId`/`appointmentId` are deliberately NOT
/// duplicated here — both are reachable via `job.quoteId`/
/// `job.appointments`, and the module spec explicitly asks not to
/// duplicate order data into the dispute record.
///
/// Same solo-pro-vs-company duality on the respondent side as before
/// (CHECK constraint in migration). `resolvedByUserId`/`assignedAdminUserId`
/// use SetNull for the same reason as VerificationDocument.reviewedBy.
model Dispute {
  id                                String              @id @default(uuid()) @db.Uuid
  /// Human-readable case number, e.g. "DSP-2026-000123" — see
  /// dispute-rules.ts's `formatCaseNumber`. Unique, immutable once created.
  caseNumber                        String              @unique
  title                             String
  jobId                             String              @db.Uuid
  serviceRequestId                  String              @db.Uuid
  raisedByUserId                    String              @db.Uuid
  respondentProfessionalProfileId   String?             @db.Uuid
  respondentCompanyProfileId        String?             @db.Uuid
  reason                            DisputeReason
  status                            DisputeStatus       @default(OPEN)
  priority                          DisputePriority     @default(MEDIUM)
  description                       String              @db.Text
  assignedAdminUserId               String?             @db.Uuid
  resolution                        DisputeResolution?
  resolutionNote                    String?             @db.Text
  resolvedAt                        DateTime?
  resolvedByUserId                  String?             @db.Uuid
  closedAt                          DateTime?
  closedByUserId                    String?             @db.Uuid

  job                     Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  serviceRequest          ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  raisedBy                User                 @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  respondentProfessional  ProfessionalProfile? @relation("DisputeRespondentProfessional", fields: [respondentProfessionalProfileId], references: [id], onDelete: Restrict)
  respondentCompany       CompanyProfile?      @relation("DisputeRespondentCompany", fields: [respondentCompanyProfileId], references: [id], onDelete: Restrict)
  assignedAdmin           User?                @relation("DisputeAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  resolvedBy              User?                @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  closedBy                User?                @relation("DisputeClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  evidence DisputeEvidence[]
  messages DisputeMessage[]

  /// Module 22 — Commission & Financial: financial adjustments executed as
  /// a consequence of this dispute's resolution (see
  /// FinancialAdjustment's doc comment). A Dispute never moves money
  /// itself — see ResolveDisputeUseCase's own doc comment — this relation
  /// only lets an admin/Module 22 trace which adjustments originated from
  /// which dispute. Zero or more: NO_ACTION resolutions produce none, a
  /// PARTIAL_RESOLUTION could in principle produce several.
  financialAdjustments FinancialAdjustment[]

  /// Module 66 — Job Completion & Payment Release Protection: set on the
  /// JobCompletionConfirmation row(s) that were moved to DISPUTED because
  /// of this Dispute — see DisputeJobCompletionUseCase.
  jobCompletionConfirmations JobCompletionConfirmation[]

  /// Module 68 — Dispute Resolution & Financial Protection: at most one —
  /// see DisputeResolutionDecision.disputeId's `@unique`.
  resolutionDecision DisputeResolutionDecision?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One OPEN dispute per (job, opener): prevents the same user from
  // opening a second concurrently-open case on the same Job (see
  // dispute-rules.ts's doc comment) while still allowing a new dispute
  // once the previous one from that same opener has left status=OPEN.
  // This is a partial index (Postgres), added by the module's migration
  // SQL rather than expressible directly here (Prisma has no partial
  // unique index syntax pre-`@@unique(..., where:)`); documented as a
  // best-effort DB-level guard behind the use case's own application-level
  // check.
  @@index([jobId])
  @@index([serviceRequestId])
  @@index([raisedByUserId])
  @@index([assignedAdminUserId])
  @@index([resolvedByUserId])
  @@index([status])
  @@index([priority])
  @@index([respondentProfessionalProfileId])
  @@index([respondentCompanyProfileId])
  @@map("disputes")
}

/// Supporting evidence (photos, documents) submitted for a Dispute by
/// either party. Cascades with its parent dispute. `fileType`/`fileName`/
/// `fileSize` mirror MessageAttachment's metadata fields for consistency
/// with the platform's other "URL + metadata" attachment pattern.
model DisputeEvidence {
  id                 String  @id @default(uuid()) @db.Uuid
  disputeId          String  @db.Uuid
  submittedByUserId  String  @db.Uuid
  fileUrl            String
  fileName           String?
  fileType           String?
  fileSizeBytes      Int?
  description        String?

  dispute         Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedByUser User    @relation("EvidenceSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disputeId])
  @@index([submittedByUserId])
  @@map("dispute_evidence")
}

/// Module 21 — Disputes & Support: the dispute's communication thread.
/// Deliberately a small dedicated model rather than reusing Conversation/
/// Message (Chat, Module ~14) — see docs/MODULE_21_DISPUTES_SUPPORT.md,
/// "Relationship with Chat" for the full reasoning: a dispute thread needs
/// 3-way visibility (customer, professional/company, admin) plus an
/// admin-only "internal note" channel that must NEVER be reachable by a
/// non-admin code path, which is a materially different invariant set than
/// Chat's 1:1/booking conversations, and bolting it onto Conversation/
/// Message would risk weakening Chat's existing guarantees. `isInternalNote`
/// distinguishes the two: `false` rows are visible to every case
/// participant (raiser + respondent + assigned/any admin); `true` rows are
/// admin-authored and only ever read by an admin-authorized use case (see
/// ListDisputeInternalNotesUseCase / AddDisputeInternalNoteUseCase) — no
/// customer/professional-facing repository method ever selects them.
model DisputeMessage {
  id              String  @id @default(uuid()) @db.Uuid
  disputeId       String  @db.Uuid
  authorUserId    String  @db.Uuid
  body            String  @db.Text
  isInternalNote  Boolean @default(false)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation("DisputeMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([disputeId, isInternalNote, createdAt])
  @@index([authorUserId])
  @@map("dispute_messages")
}

/// Module 21 — Disputes & Support: general (non-order-tied) support ticket
/// — see the SupportTicketCategory/SupportTicketStatus enum doc comments
/// for why this is a separate model from Dispute.
model SupportTicket {
  id                   String                @id @default(uuid()) @db.Uuid
  ticketNumber         String                @unique
  category             SupportTicketCategory
  subject              String
  description          String                @db.Text
  status               SupportTicketStatus   @default(OPEN)
  priority             DisputePriority       @default(MEDIUM)
  openedByUserId       String                @db.Uuid
  assignedAdminUserId  String?               @db.Uuid
  resolutionNote       String?               @db.Text
  resolvedAt           DateTime?
  resolvedByUserId     String?               @db.Uuid
  closedAt             DateTime?
  closedByUserId       String?               @db.Uuid

  openedBy      User  @relation("SupportTicketOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedAdmin User? @relation("SupportTicketAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  resolvedBy    User? @relation("SupportTicketResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  closedBy      User? @relation("SupportTicketClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([openedByUserId])
  @@index([assignedAdminUserId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

// ============================================================================
// Platform / Audit
// ============================================================================

/// Append-only audit trail of significant actions across the platform.
/// Deliberately has NO `updatedAt` and NO soft delete — an audit log
/// entry that could be edited or hidden after the fact would defeat its
/// entire purpose. `actorUserId` is nullable + SetNull for
/// system-initiated actions (e.g. an expired-request cron job) that have
/// no human actor. `entityType`/`entityId` form a lightweight polymorphic
/// reference (e.g. entityType="ServiceRequest") rather than one FK column
/// per possible entity, since virtually every table in this schema could
/// need to be audited.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorUserId String?       @db.Uuid
  action     AuditLogAction
  entityType String
  entityId   String?        @db.Uuid
  metadata   Json?          @db.JsonB
  ipAddress  String?
  userAgent  String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Security & Anti-Abuse (Module 24)
// ============================================================================
//
// Two new models, deliberately kept separate from the existing AuditLog
// above rather than reusing it:
//   - AuditLog's own doc comment describes it as a trail of "significant
//     actions" performed by a resolved actor on a resolved entity. Most
//     SecurityEvents below (LOGIN_FAILED, RATE_LIMIT_TRIGGERED, an
//     anonymous registration flood from one IP) have *no* authenticated
//     actor and *no* single target entity — exactly the cases AuditLog's
//     shape doesn't fit.
//   - AuditLogAction is a shared enum already reused by five other modules
//     (see its doc comment / AdminAuditAction) for their own action
//     vocabularies via `metadata.adminAction`. Widening it with 10+
//     security-specific values not applicable to any of those modules
//     would be a broader, riskier change than adding one small, purpose-
//     built enum here.
// Both stay additive: no existing table, column, or enum is modified.

/// What kind of security-relevant thing happened. Deliberately narrower
/// than "log everything" — only events an anti-abuse policy or an admin
/// investigating abuse actually needs. See docs/MODULE_24_SECURITY_ANTI_ABUSE.md.
enum SecurityEventType {
  LOGIN_FAILED
  LOGIN_SUCCEEDED
  ACCOUNT_CREATED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFICATION_REQUESTED
  RATE_LIMIT_TRIGGERED
  ACCOUNT_TEMPORARILY_BLOCKED
  SUSPICIOUS_ACTIVITY_DETECTED
  SERVICE_REQUEST_RATE_LIMITED
  QUOTE_RATE_LIMITED
  MESSAGE_RATE_LIMITED
  REVIEW_RATE_LIMITED
  ADMIN_ACTION
  SECURITY_POLICY_BLOCKED
}

/// Append-only security event log. Never exposed to the subject user
/// (see SecurityEventRepository's doc comment) — read access is
/// SUPER_ADMIN-only, same requireRole() gate as every other admin-only
/// repository/use case in this codebase.
///
/// Privacy: raw IP addresses are never stored here. `ipHash` is a
/// keyed SHA-256 hash (see infrastructure/auth/security-key.ts) of the
/// caller's IP — enough to recognise "the same source acted repeatedly"
/// for rate-limiting/investigation without persisting an address that
/// identifies a person or location. `userAgent` is stored verbatim
/// (browser/client strings are not personally identifying on their own)
/// but truncated at the application boundary. `metadata` must never hold
/// passwords, tokens, or other secrets — see the doc comment on
/// SecurityEventRepository.record().
model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  type      SecurityEventType
  userId    String?           @db.Uuid
  ipHash    String?
  userAgent String?
  metadata  Json?             @db.JsonB

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@map("security_events")
}

/// Current abuse-related state, internal reason category, and (auto-)
/// expiry for one active restriction on a User. Deliberately its own
/// table rather than a status column bolted onto User — User.status
/// (see UserStatus) already models the *account lifecycle*
/// (pending/active/suspended/banned, an explicit admin/moderation
/// decision); this models a *temporary, often automated* anti-abuse
/// state layered on top of it (e.g. "still ACTIVE, but throttled for the
/// next 15 minutes because of a burst of failed logins"). Multiple rows
/// per user are allowed (history of past restrictions); "is this user
/// currently restricted" is "is there a row for this userId with
/// liftedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now())".
///
/// No permanent auto-bans: automated restrictions (createdByUserId null)
/// always carry an expiresAt. Only an explicit admin action
/// (createdByUserId set) may create one with expiresAt = null — a
/// deliberate, reviewable decision, never something the rate-limit/abuse
/// policy layer does on its own. `reason` is an internal category never
/// shown to the restricted user (see AccountRestrictionRepository).
model AccountRestriction {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @db.Uuid
  state           AccountRestrictionState
  reason          AccountRestrictionReason
  notes           String?                  @db.Text /// internal only, never exposed to the restricted user
  createdByUserId String?                  @db.Uuid /// null = system/automated; set = explicit admin action
  expiresAt       DateTime?                /// null only allowed when createdByUserId is set (admin decision)
  liftedAt        DateTime?

  user      User  @relation("AccountRestrictionSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AccountRestrictionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, state])
  @@index([expiresAt])
  @@map("account_restrictions")
}

enum AccountRestrictionState {
  THROTTLED
  TEMPORARILY_BLOCKED
  FLAGGED
}

enum AccountRestrictionReason {
  FAILED_LOGIN_BURST
  REGISTRATION_ABUSE
  SERVICE_REQUEST_SPAM
  QUOTE_SPAM
  MESSAGE_SPAM
  REVIEW_ABUSE
  ADMIN_DECISION
  OTHER
}

// ============================================================================
// Module 38 — GDPR Compliance
// ============================================================================

/// Append-only record of a user granting (and, later, possibly withdrawing)
/// one of the platform's tracked consent types. See
/// src/core/domain/entities/consent.ts for the domain model and
/// src/core/domain/value-objects/consent-type.ts for why these three values
/// were chosen. Granting the same type again after a withdrawal creates a
/// brand-new row rather than reactivating the old one — a full history is
/// the point, not just current state.
model Consent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  type        ConsentType
  /// Free-form identifier for the terms/policy text version consented to
  /// (e.g. "2026-01-15"). Not validated against a fixed list here — that
  /// lives at the application edge/CMS that manages legal copy.
  version     String
  grantedAt   DateTime    @default(now())
  withdrawnAt DateTime?
  /// Module 62 — Professional Onboarding: additive, optional request
  /// provenance columns, populated when this consent was granted through
  /// the onboarding flow's Terms & Conditions step (see
  /// AcceptOnboardingTermsUseCase). `null` for every consent granted
  /// through a channel with no request context (every pre-Module-62
  /// caller, and the Privacy Policy onboarding step, which the module
  /// brief does not require these for).
  ipHash      String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@map("consents")
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING
}

// ============================================================================
// Module 54 — Backup & Disaster Recovery
// ============================================================================

/// One backup run, from being scheduled through to expiry or restore. See
/// src/core/domain/entities/backup.ts for the aggregate/state-machine this
/// table backs (src/core/infrastructure/backup/prisma-backup-record-
/// repository.ts maps between the two). `sizeBytes` is BigInt because a
/// full database dump can exceed Int's ~2GB ceiling.
model BackupRecord {
  id                 String             @id @default(uuid()) @db.Uuid
  target             BackupTargetKind
  type               BackupTypeKind
  status             BackupStatusKind
  /// Denormalized from the RetentionPolicy value object at schedule time
  /// (never re-read from live config later) so a policy change can never
  /// retroactively alter what an already-completed backup's own expiry
  /// means.
  retentionDays      Int
  minRetainedBackups Int
  startedAt          DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  sizeBytes          BigInt?
  checksumSha256     String?
  /// A filesystem path or manifest location — never a full connection
  /// string or credential; see DatabaseBackupProvider's own doc comment
  /// on never exposing sensitive information.
  locationUri        String?            @db.Text
  verifiedAt         DateTime?
  restoredAt         DateTime?
  /// Internal diagnostic only; providers are required to raise redacted,
  /// safe-to-log messages (see PgDumpDatabaseBackupProvider).
  failureReason      String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([target, status])
  @@index([target, completedAt])
  @@index([status, expiresAt])
  @@map("backup_records")
}

enum BackupTargetKind {
  DATABASE
  FILE_STORAGE
}

enum BackupTypeKind {
  FULL
  INCREMENTAL
}

enum BackupStatusKind {
  PENDING
  RUNNING
  COMPLETED
  VERIFIED
  FAILED
  RESTORED
  EXPIRED
}

/// Audit trail of one disaster-recovery plan execution (real incident or
/// scheduled drill). Plans themselves are a code-defined catalog (see
/// src/core/application/services/recovery/disaster-recovery-plans.ts's own
/// doc comment for why), so only executions are persisted here.
model RecoveryExecution {
  id            String              @id @default(uuid()) @db.Uuid
  /// References a DisasterRecoveryPlan.id from the code catalog — not a
  /// foreign key, since the catalog is not a database table.
  planId        String
  /// Free-text reason this execution started (e.g. "scheduled drill",
  /// "database-outage-2026-08-09"). Never a secret or PII value.
  triggeredBy   String
  isDrill       Boolean             @default(false)
  status        RecoveryStatusKind
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  /// Ordered array of { stepId, status, reachedAt, notes } — see
  /// RecoveryCheckpoint in domain/entities/disaster-recovery.ts. Modeled
  /// as JSON rather than a child table: checkpoints are always read/written
  /// as one atomic list scoped to their own execution, never queried
  /// independently.
  checkpoints   Json                @default("[]")
  failureReason String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, status])
  @@index([planId, isDrill, status])
  @@map("recovery_executions")
}

enum RecoveryStatusKind {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  ABORTED
}

// ============================================================================
// Module 57 — Load Testing & Capacity Planning
// ============================================================================
//
// Persists AGGREGATED results only, never raw per-request samples — a
// `LoadTestResult` already only ever holds `LatencyStatistics` (six
// numbers: min/max/average/median/p95/p99), never the raw latency array
// they were computed from (see domain/value-objects/latency-distribution.ts's
// own doc comment); that computed shape is exactly what `LoadTestRun`
// stores. `LoadTestRun` rows come in two flavours distinguished by whether
// `productionReadinessScore`/`bottlenecks`/`recommendations`/`reportJson`/
// `reportMarkdown` are set: most rows are one per-scenario execution
// (those columns null), and at most one row per `npm run capacity-report`
// invocation additionally anchors the full report (those columns
// populated) — see PersistCapacityReportUseCase.
//
// `PerformanceBaseline` is the comparison point future executions diff
// against for regression detection — captured once (auto-captured on a
// scenario's first successful run when none exists yet, see
// GenerateCapacityReportUseCase) and reused by every later run via
// `PerformanceBaselineRepository.findLatestByScenario`.

/// One aggregated execution of a PerformanceScenario (see
/// src/core/domain/entities/load-test-result.ts for the aggregate this
/// backs) or, for at most one row per capacity-report run, the report's
/// own anchor/summary row. Mapped by
/// infrastructure/database/prisma/repositories/prisma-load-test-result-repository.ts.
model LoadTestRun {
  id     String  @id @default(uuid()) @db.Uuid
  scenarioId   String
  scenarioName String
  /// The PRNG seed BenchmarkRunner ran this scenario with, if pinned —
  /// null when the executor derived its own (still deterministic; see
  /// LoadTestingService.run's own doc comment).
  seed         Int?

  executedAt DateTime @default(now())
  durationMs Int

  totalRequests    Int
  failedRequests   Int
  timedOutRequests Int
  retriedRequests  Int

  latencyAverageMs Float
  latencyMedianMs  Float
  latencyP95Ms     Float
  latencyP99Ms     Float
  latencyMinMs     Float
  latencyMaxMs     Float

  requestsPerSecond     Float
  transactionsPerSecond Float

  cpuPercent               Float
  memoryMB                 Float
  dbPoolUtilizationPercent Float
  cacheHitRatioPercent     Float

  errorRate   Float
  timeoutRate Float
  retryRate   Float

  /// The four fields below are only set on the single row (per
  /// capacity-report run) that anchors the full report — null for an
  /// ordinary per-scenario execution row.
  productionReadinessScore Float?
  /// Structured CapacityBottleneck[] snapshot — never raw samples.
  bottlenecks              Json?
  /// Structured CapacityRecommendation[] snapshot — never raw samples.
  recommendations          Json?
  /// The full StructuredCapacityReport, as returned by
  /// infrastructure/performance/report-generator.ts's toJsonReport().
  reportJson               Json?
  reportMarkdown           String? @db.Text

  gitCommit   String?
  gitBranch   String?
  appVersion  String?
  environment String?

  createdAt DateTime @default(now())

  @@index([scenarioId, executedAt])
  @@map("load_test_runs")
}

/// An immutable, labelled snapshot of one LoadTestRun's aggregated
/// metrics for a scenario — the comparison point regression detection
/// diffs a later run against. Mirrors
/// src/core/domain/entities/performance-baseline.ts. Mapped by
/// prisma-performance-baseline-repository.ts.
model PerformanceBaseline {
  id           String   @id @default(uuid()) @db.Uuid
  scenarioId   String
  label        String
  capturedAt   DateTime @default(now())
  /// References a LoadTestRun.id — not a foreign key, since a baseline is
  /// designed to outlive the run it was captured from (see
  /// domain/entities/performance-baseline.ts's own doc comment).
  sourceRunId  String
  /// Sample count the source run's LatencyStatistics was computed from —
  /// descriptive only, needed to rehydrate LatencyStatistics; never a raw
  /// sample array.
  sampleCount  Int

  latencyAverageMs Float
  latencyMedianMs  Float
  latencyP95Ms     Float
  latencyP99Ms     Float
  latencyMinMs     Float
  latencyMaxMs     Float

  requestsPerSecond     Float
  transactionsPerSecond Float

  cpuPercent               Float
  memoryMB                 Float
  dbPoolUtilizationPercent Float
  cacheHitRatioPercent     Float

  errorRate Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scenarioId, label])
  @@index([scenarioId, capturedAt])
  @@map("performance_baselines")
}

// ============================================================================
// Module 60 — Referral & Marketing Attribution Platform
// ============================================================================
//
// Tracking/attribution/reporting only — no payment provider integration, no
// affiliate payouts, no commission calculation, no Partner System (those are
// future modules; see docs/MODULE_60_REFERRAL_MARKETING_PLATFORM.md's
// "Future Affiliate integration" / "Future Commission integration"
// sections). `ConversionEvent` may reference an existing `Commission.id`
// via its plain `referenceId` string column, but this module never writes
// to the `Commission` table and never computes `rateBps`/`amount`.
//
// Deliberately no separate `MarketingCampaign` table — a campaign is
// identified by its `utmCampaign` string (falling back to `referralCode`
// when `utmCampaign` is absent), not a separately administered entity,
// because nothing in this module's scope requires campaign lifecycle
// management (budget, start/end dates, owner). See the module doc's
// "Campaign modeling" section.

/// The closed set of marketing channels a visit/attribution resolves to.
/// See src/core/domain/services/marketing-source-rules.ts for the pure
/// resolution function and its documented precedence order.
enum MarketingSourceKind {
  TELEGRAM
  INSTAGRAM
  TIKTOK
  FACEBOOK
  GOOGLE_ADS
  YOUTUBE
  ORGANIC_SEARCH
  DIRECT
  REFERRAL
  EMAIL
  UNKNOWN
}

/// The closed set of conversion types this module records as
/// `ConversionEvent.type`. See conversion-event-repository.ts's own doc
/// comment for why `referenceId` (a Booking/Payment/Commission id) is a
/// plain string, not a Prisma relation.
enum ConversionTypeKind {
  REGISTRATION
  PROFESSIONAL_REGISTRATION
  CLIENT_REGISTRATION
  BOOKING_CREATED
  BOOKING_COMPLETED
  COMMISSION_GENERATED
}

/// An administered, unique referral code string (e.g. `telegram_valencia`)
/// a professional/campaign shares as `?r=<code>`. Format rules (length
/// 3–40, lowercase alphanumeric + underscore) live in
/// domain/services/referral-code-rules.ts, enforced both there and by this
/// table's own unique constraint. Mapped by
/// prisma-referral-code-repository.ts.
model ReferralCode {
  id      String  @id @default(uuid()) @db.Uuid
  code    String  @unique @db.VarChar(40)
  /// The user this code is attributed to (e.g. a professional's own
  /// referral link) — null for a platform-level/campaign code with no
  /// single owner. SetNull on delete: losing the owner pointer must never
  /// cascade-delete historical visit/attribution data that already
  /// references this code by its string value.
  ownerUserId String? @db.Uuid
  owner       User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  label       String? @db.VarChar(120)

  createdAt DateTime @default(now())

  @@index([ownerUserId])
  @@map("referral_codes")
}

/// One row per tracked, non-duplicate click/visit — see
/// domain/services/referral-visit-dedup-rules.ts for the 60-second dedup
/// window `TrackVisitUseCase` applies before ever inserting a row here.
/// `referralCode` is a plain string (not a `ReferralCode` relation/FK) —
/// a visit may legitimately carry a code that was never administered via
/// `CreateReferralCodeUseCase` (format-valid but unregistered), and this
/// table must keep recording UTM-only visits regardless. Mapped by
/// prisma-referral-visit-repository.ts.
model ReferralVisit {
  id     String @id @default(uuid()) @db.Uuid
  /// Opaque, client-generated/cookie-stored visitor identifier — see
  /// MarketingAttribution.visitorId's own doc comment for the full
  /// "visitor identity" design rationale. NOT the ipHash below.
  visitorId String @db.VarChar(100)

  referralCode String? @db.VarChar(40)
  utmSource    String? @db.VarChar(191)
  utmMedium    String? @db.VarChar(191)
  utmCampaign  String? @db.VarChar(191)
  utmContent   String? @db.VarChar(191)
  utmTerm      String? @db.VarChar(191)

  /// Resolved once, at ingestion time, by
  /// domain/services/marketing-source-rules.ts — never recomputed later
  /// even if the resolution rules themselves change, so a historical
  /// visit's recorded source is always what the platform actually believed
  /// at the time.
  marketingSource MarketingSourceKind

  /// Keyed hash of the visitor's IP (domain/services/security-key.ts's
  /// hashIp) — never the raw IP. Stored for abuse/dedup auxiliary signal
  /// only; never the attribution join key (see MarketingAttribution's own
  /// doc comment).
  ipHash             String? @db.VarChar(64)
  userAgentTruncated String? @db.VarChar(200)
  landingPage        String  @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([referralCode])
  @@index([utmCampaign])
  @@map("referral_visits")
}

/// One row per visitor (`visitorId` unique) — write-once first-touch,
/// always-overwritten last-touch attribution. See
/// domain/services/marketing-attribution-touch-rules.ts's own doc comment
/// for the immutability rule and prisma-marketing-attribution-repository.ts
/// for how it's persisted.
model MarketingAttribution {
  id        String @id @default(uuid()) @db.Uuid
  visitorId String @unique @db.VarChar(100)

  firstSource       MarketingSourceKind
  firstCampaign     String?             @db.VarChar(191)
  firstReferralCode String?             @db.VarChar(40)
  firstVisitAt      DateTime

  lastSource       MarketingSourceKind
  lastCampaign     String?             @db.VarChar(191)
  lastReferralCode String?             @db.VarChar(40)
  lastVisitAt      DateTime

  /// Set once the visitor registers (via
  /// LinkRegistrationAttributionUseCase, called best-effort from
  /// RegisterUserUseCase). Not a unique constraint: nothing in this
  /// module's scope prevents a user from having registered under a
  /// different visitorId than the one carrying this row (e.g. they visited
  /// from two browsers before signing up on one of them) — a second,
  /// never-linked MarketingAttribution row simply stays userId: null
  /// forever, which is an acceptable, non-corrupting outcome for a
  /// best-effort attribution signal. SetNull on delete: losing the user
  /// pointer must never delete the historical attribution/visit data.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  conversionEvents ConversionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("marketing_attributions")
}

/// A read-only record of "something the platform already considers a
/// conversion happened for this attributed visitor." This module never
/// computes `revenueAmount` or decides when a conversion happened — see
/// conversion-event-repository.ts's own doc comment. No other module's use
/// case calls RecordConversionUseCase yet (see docs/MODULE_60's "Remaining
/// Limitations") — this table and its repository are ready for that
/// wiring, not yet connected to it.
model ConversionEvent {
  id            String   @id @default(uuid()) @db.Uuid
  attributionId String   @db.Uuid
  attribution   MarketingAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)

  type       ConversionTypeKind
  occurredAt DateTime           @default(now())
  /// Plain string reference to a Booking/Payment/Commission id, etc. — not
  /// a Prisma relation across module boundaries (same convention
  /// CommissionRecord.paymentId already establishes for the identical
  /// reason: this module has no business depending on those modules'
  /// schemas).
  referenceId String? @db.VarChar(191)
  /// Read from existing Booking/Payment data at recording time by
  /// whichever caller supplies it — this module stores what it's told,
  /// never computes it itself.
  revenueAmount Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([attributionId])
  @@index([type])
  @@map("conversion_events")
}

// ============================================================================
// Module 61 — Affiliate & Partner System
// ============================================================================
//
// Extends Module 60 — does NOT duplicate it. A Partner's referral links are
// ordinary `ReferralCode` rows whose `ownerUserId` is the partner's own
// `userId` (see `ReferralCode.owner`'s existing relation, reused as-is);
// there is no second "partner referral code" table here. Attribution
// (first/last touch, UTM, visitor identity) stays entirely owned by
// `MarketingAttribution`/`ReferralVisit` — this module only ever reads
// those tables (via `ReferralVisitRepository.listByReferralCodes` /
// `MarketingAttributionRepository.listByReferralCodes`, both added by this
// module), never writes to them.
//
// MaestroYa's own platform commission calculation (Module 22's
// `Commission` model / `commission-policy.ts`) is untouched by this
// module — `AffiliateCommission.platformCommissionAmount` is always a
// read-only snapshot of an already-existing `Commission.amount`, supplied
// by whichever future caller invokes `RecordAffiliateCommissionUseCase`.
// See `domain/services/affiliate-commission-policy.ts` for the exact
// "10% of MaestroYa's commission, never 10% of the booking" calculation.

/// The kind of partner account — every category the module spec's
/// "Partner types" section lists. Purely descriptive; no business rule in
/// this module branches on `type` (a COMPANY partner and an INDIVIDUAL
/// partner go through the identical approval workflow and commission
/// calculation) — it exists for admin-panel filtering/reporting only.
enum PartnerType {
  INDIVIDUAL
  COMPANY
  AGENCY
  BLOGGER
  TELEGRAM_CHANNEL
  INSTAGRAM_CREATOR
  TIKTOK_CREATOR
  YOUTUBE_CREATOR
  FACEBOOK_COMMUNITY
}

/// The partner approval-workflow state machine's states. See
/// domain/services/partner-approval-rules.ts for the allowed-transition
/// table (PENDING -> APPROVED|REJECTED, APPROVED -> SUSPENDED|BANNED,
/// SUSPENDED -> APPROVED|BANNED; REJECTED/BANNED are terminal).
enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
}

/// How a partner is paid. STRIPE is modeled now purely so the payout
/// architecture never needs a migration later — no Stripe SDK call
/// happens anywhere in this module today. See docs/MODULE_61's "Future
/// Stripe support" section.
enum PartnerPayoutMethod {
  MANUAL
  STRIPE
}

/// An affiliate/partner account. One row per User (`userId` unique) — a
/// user is either a partner or not; there is no "multiple partner
/// identities per user" concept. See domain/repositories/partner-repository.ts
/// for the full field-by-field rationale.
model Partner {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @unique @db.Uuid
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   PartnerType
  status PartnerStatus @default(PENDING)

  displayName  String              @db.VarChar(120)
  contactEmail String              @db.VarChar(191)
  payoutMethod PartnerPayoutMethod @default(MANUAL)
  /// Provider-agnostic payout details (e.g. `{ "iban": "..." }`) — see
  /// PartnerPayoutDetails' own doc comment in partner-repository.ts for why
  /// this is JSON rather than dedicated columns.
  payoutDetails Json? @db.JsonB

  /// Minimum accumulated APPROVED commission total before a payout can be
  /// created for this partner — see
  /// domain/services/partner-payout-rules.ts. Per-partner (not a single
  /// platform-wide constant) so a negotiated threshold never requires a
  /// schema change.
  minimumPayoutThreshold Decimal @default(50) @db.Decimal(10, 2)
  /// Admin-only free-text notes — never shown to the partner.
  notes String? @db.Text

  approvedAt       DateTime?
  approvedByUserId String?   @db.Uuid
  rejectedAt       DateTime?
  rejectedReason   String?   @db.Text
  suspendedAt      DateTime?
  suspendedReason  String?   @db.Text
  bannedAt         DateTime?
  bannedReason     String?   @db.Text

  affiliateCommissions AffiliateCommission[]
  payouts              PartnerPayout[]
  fraudFlags           PartnerFraudFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@map("partners")
}

/// The states an AffiliateCommission ledger row moves through. See
/// domain/repositories/affiliate-commission-repository.ts's own doc
/// comment for the full lifecycle (PENDING -> APPROVED -> PAID, or ->
/// CANCELLED / -> EXPIRED from PENDING).
enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
  EXPIRED
}

/// One ledger row per booking whose MaestroYa platform commission (Module
/// 22's `Commission`) generated an affiliate payout obligation. Read-only
/// with respect to Module 22 — `platformCommissionRefId`/
/// `platformCommissionAmount` snapshot an existing `Commission` row via a
/// plain string id, the same "reference another bounded context without a
/// cross-module FK" convention `ConversionEvent.referenceId` already
/// establishes. `conversionEventId` is unique — at most one
/// AffiliateCommission per Module 60 ConversionEvent, the idempotency
/// anchor RecordAffiliateCommissionUseCase relies on.
model AffiliateCommission {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  /// Denormalized copy of the ReferralCode.code that drove this
  /// commission — never a relation (a code can be deleted/reassigned
  /// without ever invalidating this historical ledger row).
  referralCode String @db.VarChar(40)

  /// Module 60 ConversionEvent.id (type COMMISSION_GENERATED) this
  /// commission was derived from.
  conversionEventId String @unique @db.Uuid

  /// Module 22 Commission.id — plain string reference, no FK (see model
  /// doc comment).
  platformCommissionRefId String  @db.VarChar(191)
  platformCommissionAmount Decimal @db.Decimal(10, 2)

  affiliateRateBps Int
  affiliateAmount  Decimal @db.Decimal(10, 2)

  status AffiliateCommissionStatus @default(PENDING)

  approvedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.Text
  expiresAt    DateTime
  expiredAt    DateTime?
  paidAt       DateTime?
  payoutId     String?   @db.Uuid
  payout       PartnerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([expiresAt])
  @@index([payoutId])
  @@map("affiliate_commissions")
}

/// The states a PartnerPayout moves through. See
/// domain/repositories/partner-payout-repository.ts.
enum PartnerPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

/// One row per batch of AffiliateCommissions settled together for a
/// partner. `method` mirrors Partner.payoutMethod at creation time; when
/// STRIPE, this row is still only ever a record — no Stripe transfer is
/// ever initiated by this module (see PartnerPayoutMethod's own doc
/// comment).
model PartnerPayout {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  amount   Decimal             @db.Decimal(10, 2)
  currency String              @default("EUR")
  method   PartnerPayoutMethod
  status   PartnerPayoutStatus @default(PENDING)
  /// Opaque external reference (a bank transfer reference today, a future
  /// Stripe transfer id) — never parsed by this module.
  reference String? @db.VarChar(191)

  periodStart   DateTime
  periodEnd     DateTime
  processedAt   DateTime?
  failureReason String?   @db.Text

  affiliateCommissions AffiliateCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@index([status])
  @@map("partner_payouts")
}

/// The kind of fraud signal PartnerFraudFlag records — every category the
/// module spec's "Fraud Protection" section lists. See
/// domain/services/affiliate-fraud-rules.ts for the pure detection rules
/// that produce these.
enum PartnerFraudFlagType {
  SELF_REFERRAL
  DUPLICATE_ACCOUNT
  SUSPICIOUS_CONVERSION
  REPEATED_IP
  REPEATED_DEVICE
  FAKE_REGISTRATION
}

/// The review state of a raised fraud flag. Flagging is always advisory —
/// see domain/repositories/partner-fraud-flag-repository.ts's own doc
/// comment for why nothing in this module auto-suspends/bans a partner or
/// cancels a commission purely because a flag exists.
enum PartnerFraudFlagStatus {
  OPEN
  REVIEWED
  DISMISSED
  CONFIRMED
}

/// A flagged suspicious-activity signal against a partner, raised by
/// DetectPartnerFraudSignalsUseCase and reviewed by an admin.
model PartnerFraudFlag {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  type   PartnerFraudFlagType
  status PartnerFraudFlagStatus @default(OPEN)
  /// Human-readable explanation — always safe to show an admin verbatim
  /// (never a raw IP, only ever a truncated/hashed value if relevant).
  detail String @db.Text

  relatedReferralCode String? @db.VarChar(40)
  relatedVisitorId    String? @db.VarChar(100)
  relatedUserId       String? @db.Uuid

  resolvedAt       DateTime?
  resolvedByUserId String?   @db.Uuid
  resolution       String?   @db.Text

  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([status])
  @@map("partner_fraud_flags")
}

// ============================================================================
// Module 62 — Professional Onboarding
// ============================================================================
//
// Orchestrates existing modules (Consent/Module 38 for terms & privacy,
// ProfessionalVerification/Module 17+59 for identity, ProfessionalProfile
// for profile completeness) plus exactly two new tables this module needs
// that nothing else already owns: the onboarding progress/activation
// record itself, and the professional's payout destination. See
// docs/MODULE_62_PROFESSIONAL_ONBOARDING.md.

enum OnboardingStatus {
  IN_PROGRESS
  ACTIVATED
}

enum PayoutMethod {
  IBAN
  STRIPE_EXPRESS
}

enum PayoutAccountStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Module 71 — Stripe Connect / Stripe Express. `NOT_STARTED`
/// (default) / `PENDING` (professional chose Stripe Express, or a real
/// account exists but has not finished Stripe's hosted onboarding yet)
/// / `READY` (`GetStripeAccountStatusUseCase` — Module 71 — has confirmed
/// the account has `details_submitted`/`charges_enabled`/`payouts_enabled`
/// all true). Module 62 (this section) never calls the Stripe SDK — see
/// StripeExpressPayoutProvider's
/// own doc comment.
enum StripeExpressReadiness {
  NOT_STARTED
  PENDING
  READY
}

/// One row per professional profile — progress/activation state for the
/// Professional Onboarding flow. Distinct from `ProfessionalProfile.status`
/// (ProfessionalStatus: ACTIVE/INACTIVE/SUSPENDED, the account-lifecycle
/// column set at profile creation) the same way `AccountRestriction` is
/// distinct from `UserStatus` — this models a *gate* layered on top of an
/// already-ACTIVE profile, not a replacement for that column. See
/// ProfessionalOnboardingActivated's own doc comment for how a future
/// consumer (booking/payout eligibility) is expected to read this.
model ProfessionalOnboarding {
  id                     String           @id @default(uuid()) @db.Uuid
  professionalProfileId  String           @unique @db.Uuid
  professionalProfile    ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  status      OnboardingStatus @default(IN_PROGRESS)
  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("professional_onboardings")
}

/// The professional's single active payout destination. Insert-or-replace
/// (`@unique` on professionalProfileId), not a history table — switching
/// payout method/details replaces the current destination, mirroring
/// `ProfessionalProfile.stripeConnectAccountId`'s own "single current
/// value" shape rather than `Payout`'s append-only transaction history
/// (which this is not — this table never records money movement, only
/// where it would go). A raw IBAN is never stored: only the last 4 digits
/// (`ibanLast4`, display only) and a keyed hash (`ibanHash`, duplicate
/// detection only) — see IbanPayoutProvider's own doc comment.
model ProfessionalPayoutAccount {
  id                     String           @id @default(uuid()) @db.Uuid
  professionalProfileId  String           @unique @db.Uuid
  professionalProfile    ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  method            PayoutMethod
  status            PayoutAccountStatus @default(PENDING)
  accountHolderName String

  ibanLast4 String? @db.VarChar(4)
  ibanHash  String? @unique

  /// Module 71 — Stripe Connect: the real Stripe Express connected
  /// account id, written by `CreateStripeConnectedAccountUseCase` once
  /// the account actually exists. `null` until then — this module's own
  /// onboarding-selection step (Step 6) never populates it (see
  /// StripeExpressPayoutProvider's own doc comment).
  stripeExpressAccountId String?                 @unique
  stripeExpressStatus    StripeExpressReadiness  @default(NOT_STARTED)

  /// Module 71 — Stripe Connect: Stripe's own account capability/
  /// onboarding flags, mirrored by `GetStripeAccountStatusUseCase`
  /// (and, in a future Module 72, a webhook handler reconciling
  /// `account.updated` events). Deliberately separate from
  /// `stripeExpressStatus` — see `domain/services/stripe-connect-account-
  /// rules.ts`'s own doc comment for why MaestroYa professional status,
  /// Stripe account status, and payout eligibility are three distinct
  /// concepts that never collapse into one field.
  ///
  /// POST-AUDIT CORRECTION: `stripeChargesEnabled` stores Stripe's
  /// `transfers` capability-active status, NOT the literal account-level
  /// `charges_enabled` field — MaestroYa's connected accounts only ever
  /// request the `transfers` capability, under which `charges_enabled`
  /// would never meaningfully become true. See
  /// `ProfessionalPayoutAccountRecord.stripeChargesEnabled`'s own doc
  /// comment (domain/repositories/professional-onboarding-repository.ts)
  /// for the full rationale. Kept under this column name deliberately —
  /// no migration needed, the existing Boolean shape already fits.
  stripeChargesEnabled           Boolean   @default(false)
  stripePayoutsEnabled           Boolean   @default(false)
  stripeDetailsSubmitted         Boolean   @default(false)
  stripeRequirementsCurrentlyDue Boolean   @default(false)
  stripeConnectSyncedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([method])
  @@index([status])
  @@map("professional_payout_accounts")
}

/// Module 75 — Company Payout Eligibility: the company-owned mirror of
/// `ProfessionalPayoutAccount` (see that model's own doc comment for the
/// full shape rationale — this model deliberately repeats it exactly,
/// keyed on `companyProfileId` instead of `professionalProfileId`,
/// reusing the same `PayoutMethod`/`PayoutAccountStatus`/
/// `StripeExpressReadiness` enums rather than introducing parallel ones).
/// The company's single active payout destination — insert-or-replace
/// (`@unique` on companyProfileId), not a history table. A raw IBAN is
/// never stored: only the last 4 digits (display only) and a keyed hash
/// (duplicate detection only) — same convention as
/// `ProfessionalPayoutAccount.ibanHash`.
model CompanyPayoutAccount {
  id               String         @id @default(uuid()) @db.Uuid
  companyProfileId String         @unique @db.Uuid
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  method            PayoutMethod
  status            PayoutAccountStatus @default(PENDING)
  accountHolderName String

  ibanLast4 String? @db.VarChar(4)
  ibanHash  String? @unique

  /// Module 75 — Company Payout Eligibility: mirrors
  /// `ProfessionalPayoutAccount.stripeExpressAccountId` — the real Stripe
  /// Express connected account id once one exists for this company. This
  /// module never calls the Stripe SDK to create it (see this module's
  /// own doc comment) — the field exists so the schema/architecture is
  /// complete for a future module to populate it exactly the way Module
  /// 71 populates the professional equivalent.
  stripeExpressAccountId String?                @unique
  stripeExpressStatus    StripeExpressReadiness @default(NOT_STARTED)

  stripeChargesEnabled           Boolean   @default(false)
  stripePayoutsEnabled           Boolean   @default(false)
  stripeDetailsSubmitted         Boolean   @default(false)
  stripeRequirementsCurrentlyDue Boolean   @default(false)
  stripeConnectSyncedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([method])
  @@index([status])
  @@map("company_payout_accounts")
}

// ============================================================================
// Module 65 — Trust & Integrity System
// ============================================================================
//
// The centralized Risk Management layer for the marketplace. Deliberately
// additive-only against every model it references (User, AccountRestriction,
// ProfessionalVerification, ProfessionalPayoutAccount, Quote): this module
// never rewrites Module 24's AccountRestriction contract or Module 59's
// verification tables, it only reads from / links to them (see
// docs/MODULE_65_TRUST_AND_INTEGRITY_SYSTEM.md). Every automated
// consequence this module can take is recorded in its own
// TrustAutomatedAction ledger rather than folded into AccountRestriction's
// existing THROTTLED/TEMPORARILY_BLOCKED/FLAGGED vocabulary, which models a
// narrower Module-24 concern (login/registration/messaging throttling) that
// this module does not own.

/// A `TrustScoreEvent`/`RiskScoreEvent`'s cause — the closed set of business
/// reasons that may move a score. Deliberately one shared enum for both
/// score types (rather than two near-duplicate enums) since most reasons
/// affect both scores in opposite directions (e.g. `FRAUD_SIGNAL_DETECTED`
/// lowers trust and raises risk in the same call) — see
/// `trust-score-policy.ts`/`risk-score-policy.ts`.
enum TrustRiskEventReason {
  ACCOUNT_VERIFIED
  POSITIVE_REVIEW_RECEIVED
  JOB_COMPLETED_SUCCESSFULLY
  CLEAN_HISTORY_DECAY
  OFF_PLATFORM_SIGNAL_DETECTED
  FRAUD_SIGNAL_DETECTED
  FAKE_REVIEW_PATTERN_DETECTED
  SPAM_ACTIVITY_DETECTED
  SUSPICIOUS_PRICING_DETECTED
  BOOKING_ABUSE_DETECTED
  PAYMENT_ABUSE_DETECTED
  IDENTITY_RISK_DETECTED
  MANUAL_REVIEW_CONFIRMED
  APPEAL_APPROVED
  ADMIN_ADJUSTMENT
  /// Module 66 — Job Completion & Payment Release Protection: see
  /// TrustRiskEventReasonValue's own doc comment.
  JOB_COMPLETION_CONFIRMATION_TIMEOUT
  /// Module 67 — Trust & Integrity Completion Risk Detection: see
  /// TrustRiskEventReasonValue's own doc comment.
  PREMATURE_JOB_COMPLETION_DETECTED
  JOB_COMPLETION_DISPUTE_CONFLICT_DETECTED
  COMPLETION_DURING_ACTIVE_DISPUTE_DETECTED
}

enum TrustRiskScoreType {
  TRUST
  RISK
}

/// Current Trust Score (0-100, higher = more trustworthy) and Risk Score
/// (0-100, higher = more dangerous) for one user — the two independent
/// numbers every other Module 65 rule and every future module reads. One
/// row per user, insert-or-replace on recalculation (same "single current
/// value" shape as `ProfessionalPayoutAccount`); the append-only history of
/// *how* the score got here lives in `TrustScoreEvent`/`RiskScoreEvent`,
/// never on this row.
model TrustProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trustScore Int @default(70) /// 0-100, see trust-score-policy.ts DEFAULT_TRUST_SCORE
  riskScore  Int @default(0) /// 0-100, see risk-score-policy.ts DEFAULT_RISK_SCORE

  lastRecalculatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scoreEvents ScoreEvent[]

  @@index([trustScore])
  @@index([riskScore])
  @@map("trust_profiles")
}

/// Append-only audit trail of every change to a user's Trust Score OR Risk
/// Score — a single shared table for both, distinguished by `scoreType`.
/// Replaces the former separate `TrustScoreEvent`/`RiskScoreEvent` tables:
/// those two models were structurally identical (same columns, same
/// indexes, same relation to `TrustProfile`), so keeping them as two
/// tables was pure duplication rather than a deliberate scaling choice —
/// `scoreType` plus `@@index([scoreType])` gives the same "query Trust
/// events independently of Risk events" access pattern a dedicated table
/// would, without maintaining two copies of the same schema/repository/
/// migration logic. Same "single source of truth" convention as
/// `AuditLog`/`OffPlatformDetectionEvent`, whose polymorphic
/// `referenceType`/`sourceType` columns already do this for other concerns.
model ScoreEvent {
  id             String               @id @default(uuid()) @db.Uuid
  trustProfileId String               @db.Uuid
  trustProfile   TrustProfile         @relation(fields: [trustProfileId], references: [id], onDelete: Cascade)

  /// Which of TrustProfile's two independent scores this event applies to.
  scoreType      TrustRiskScoreType
  reason         TrustRiskEventReason
  delta          Int /// signed; positive raises the given scoreType's score
  scoreBefore    Int
  scoreAfter     Int
  /// Free-text, admin-safe detail (e.g. "Job #.. completed with a 5-star review").
  detail         String               @db.Text
  /// Polymorphic pointer to whatever produced this event (a FraudSignal id,
  /// an OffPlatformDetectionEvent id, a ManualReviewCase id, ...) — no FK,
  /// same "reference id, no referential integrity" convention
  /// `AuditLog.entityId` already uses, since the referenced table varies.
  referenceType  String?
  referenceId    String?

  createdAt DateTime @default(now())

  @@index([trustProfileId])
  @@index([scoreType])
  @@index([reason])
  @@map("score_events")
}

/// One channel the off-platform-communication rule engine
/// (`domain/services/off-platform-detection-rules.ts`) knows how to
/// recognize. `OTHER` covers a future channel added to the rule engine
/// before this enum is migrated to include it by name.
enum OffPlatformChannel {
  WHATSAPP
  TELEGRAM
  SIGNAL
  PHONE_NUMBER
  EMAIL_ADDRESS
  INSTAGRAM
  FACEBOOK
  TIKTOK
  DISCORD
  SKYPE
  EXTERNAL_PAYMENT_REQUEST
  CONTACT_EXCHANGE_PHRASE
  OTHER
}

/// A single detected attempt at off-platform contact/payment, raised by
/// `DetectOffPlatformCommunicationUseCase` against a Message/Quote/Review
/// text body. Always advisory at detection time — see `channel`/`riskScore
/// contribution documented on the rule engine — a human or the automated
/// action policy decides the consequence, this table only records what was
/// seen.
model OffPlatformDetectionEvent {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel    OffPlatformChannel
  /// The exact matched excerpt, truncated at the application boundary —
  /// never the full message body, to keep this table lean and to avoid
  /// duplicating content that already lives on Message/Quote/Review.
  matchedText String @db.VarChar(500)
  confidence  Int /// 0-100, see off-platform-detection-rules.ts

  /// Where the flagged text came from — "MESSAGE" | "QUOTE" | "REVIEW" |
  /// "SERVICE_REQUEST", plus the id of that row. No FK for the same
  /// polymorphic reason `TrustScoreEvent.referenceId` has none.
  sourceType String
  sourceId   String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([channel])
  @@index([createdAt])
  @@map("off_platform_detection_events")
}

/// The kind of fraud pattern `domain/services/fraud-detection-rules.ts`
/// raised. `MULTIPLE_ACCOUNTS`/`SAME_PHONE`/`SAME_IBAN`/`SAME_STRIPE_ACCOUNT`/
/// `DUPLICATE_IDENTITY` model the "one real person/entity behind several
/// User rows" family this module's brief calls out by name;
/// `SUSPICIOUS_REGISTRATION_PATTERN`/`REPEATED_FAILED_VERIFICATION` cover
/// the two remaining named signals.
enum FraudSignalType {
  MULTIPLE_ACCOUNTS
  SAME_PHONE
  SAME_IBAN
  SAME_STRIPE_ACCOUNT
  SAME_DEVICE
  DUPLICATE_IDENTITY
  SUSPICIOUS_REGISTRATION_PATTERN
  REPEATED_FAILED_VERIFICATION
  FAKE_REVIEW_PATTERN
  SPAM_ACTIVITY
  SUSPICIOUS_PRICING
  BOOKING_ABUSE
  PAYMENT_ABUSE
  /// Module 67 — Trust & Integrity Completion Risk Detection: see
  /// FraudSignalType's own doc comment (domain/repositories/fraud-signal-repository.ts).
  PREMATURE_JOB_COMPLETION
  COMPLETION_DURING_ACTIVE_DISPUTE
}

/// Mirrors `PartnerFraudFlagStatus` (Module 61) exactly — same "advisory
/// until a human confirms" review lifecycle, generalized from partners to
/// any user.
enum FraudSignalStatus {
  OPEN
  REVIEWED
  DISMISSED
  CONFIRMED
}

/// A flagged suspicious-activity signal against any user (customer,
/// professional, or company member) — the general-purpose counterpart to
/// `PartnerFraudFlag` (which stays scoped to affiliate/partner fraud only;
/// this module does not replace it). Raised by the various
/// `Detect*UseCase`s in `application/use-cases/trust-integrity/`.
model FraudSignal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("FraudSignalSubject", fields: [userId], references: [id], onDelete: Cascade)

  type   FraudSignalType
  status FraudSignalStatus @default(OPEN)
  /// Human-readable, admin-safe explanation — never a raw IBAN/phone/IP,
  /// only ever a hash or last-4, matching every other module's own
  /// "never persist raw PII in a free-text detail column" convention.
  detail String            @db.Text
  /// Other users implicated by the same signal (e.g. every account sharing
  /// the flagged IBAN hash) — stored as a plain array, no join table, same
  /// convention `AuditLog`/`PartnerFraudFlag` use for loosely-related ids.
  relatedUserIds String[]

  resolvedAt       DateTime?
  resolvedByUserId String?   @db.Uuid
  resolvedBy       User?     @relation("FraudSignalResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolution       String?   @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("fraud_signals")
}

enum TrustAutomatedActionType {
  WARNING
  TEMPORARY_RESTRICTION
  BOOKING_RESTRICTION
  MESSAGING_RESTRICTION
  PAYOUT_HOLD
  MANUAL_REVIEW
  TEMPORARY_SUSPENSION
  PERMANENT_SUSPENSION
}

enum TrustAutomatedActionStatus {
  ACTIVE
  EXPIRED
  REVERSED
}

/// One automated (or admin-confirmed) consequence applied to a user by the
/// Trust & Integrity Engine — the ledger `apply-automated-action.use-case.ts`
/// writes to and every future module (booking, messaging, payouts) should
/// consult before allowing the corresponding action, via
/// `TrustAutomatedActionRepository.hasActiveAction`. Distinct from
/// `AccountRestriction` (Module 24) — see this section's own header comment
/// for why the two are not merged.
model TrustAutomatedAction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("TrustAutomatedActionSubject", fields: [userId], references: [id], onDelete: Cascade)

  type   TrustAutomatedActionType
  status TrustAutomatedActionStatus @default(ACTIVE)

  reason           TrustRiskEventReason
  /// Score that triggered this action, for audit purposes only.
  triggeringRiskScore Int
  detail           String               @db.Text

  /// null = fully automated (the trust-integrity-action-policy decided on
  /// its own); set = an admin confirmed/escalated it manually — same
  /// `createdByUserId` convention `AccountRestriction` already uses.
  createdByUserId String? @db.Uuid
  createdBy       User?   @relation("TrustAutomatedActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// null = indefinite (PERMANENT_SUSPENSION, or a MANUAL_REVIEW awaiting
  /// resolution). Automated non-permanent actions always carry one — same
  /// "no permanent auto-action without an explicit admin decision" rule
  /// `AccountRestriction.expiresAt` documents.
  expiresAt  DateTime?
  reversedAt DateTime?
  reversedByUserId String? @db.Uuid
  reversedBy       User?   @relation("TrustAutomatedActionReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  appeals TrustAppeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([type])
  @@index([expiresAt])
  @@map("trust_automated_actions")
}

enum ManualReviewCaseState {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  REJECTED
}

/// The manual investigation queue — one case per opened investigation.
/// A `TrustAutomatedAction` of type `MANUAL_REVIEW` and a `ManualReviewCase`
/// are usually created together (see `open-manual-review-case.use-case.ts`)
/// but are kept as two rows: the action is the (reversible) consequence
/// applied to the user right now, the case is the workflow an admin walks
/// through to resolve it — mirrors how `Dispute` and its resulting
/// `FinancialAdjustment` are two separate rows for the same reason.
model ManualReviewCase {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("ManualReviewCaseSubject", fields: [userId], references: [id], onDelete: Cascade)

  state  ManualReviewCaseState @default(OPEN)
  reason TrustRiskEventReason
  /// Admin-facing summary of why this case was opened.
  summary String @db.Text

  assignedAdminId String? @db.Uuid
  assignedAdmin   User?   @relation("ManualReviewCaseAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  resolvedByUserId String? @db.Uuid
  resolvedBy   User?     @relation("ManualReviewCaseResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolutionNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Module 66 — Job Completion & Payment Release Protection: the
  /// JobCompletionConfirmation row(s) (normally exactly one) that opened
  /// this case via a confirmation-window timeout.
  jobCompletionConfirmations JobCompletionConfirmation[]

  @@index([userId])
  @@index([state])
  @@map("trust_manual_review_cases")
}

enum AppealState {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACCOUNT_RESTORED
}

/// A user's appeal against a `TrustAutomatedAction` (or a resolved
/// `ManualReviewCase`) taken against their account. One appeal always
/// targets exactly one `TrustAutomatedAction` — see `AppealRepository`'s
/// own doc comment for why a second appeal against the same action is
/// rejected rather than silently allowed.
model TrustAppeal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("TrustAppealSubject", fields: [userId], references: [id], onDelete: Cascade)

  automatedActionId String                @db.Uuid
  automatedAction   TrustAutomatedAction  @relation(fields: [automatedActionId], references: [id], onDelete: Cascade)

  state       AppealState @default(SUBMITTED)
  /// The user's own explanation, submitted verbatim.
  userStatement String @db.Text

  reviewedAt       DateTime?
  reviewedByUserId String?   @db.Uuid
  reviewedBy       User?     @relation("TrustAppealReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNotes      String?   @db.Text

  restoredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([automatedActionId])
  @@index([state])
  @@map("trust_appeals")
}

// ============================================================================
// Module 70.1 — Pre-Stripe Security & Integration Hardening
// ============================================================================

enum ExternalWebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

/// The single, provider-independent external-event idempotency ledger —
/// see `ExternalWebhookEventRepository`'s own doc comment
/// (src/core/domain/repositories/external-webhook-event-repository.ts) for
/// the full concurrency/retry design. `(provider, externalEventId)` is
/// the DB-enforced uniqueness invariant: the same webhook delivery,
/// retried by the provider or replayed by an attacker who captured a
/// valid request, can never be processed twice. No provider-specific
/// column exists here on purpose — `provider` is free text ("PERSONA"
/// today, "STRIPE" later), so a future payment-provider webhook needs no
/// schema change, only a new row shape for the same table.
model ExternalWebhookEvent {
  id              String                      @id @default(uuid()) @db.Uuid
  provider        String                      @db.VarChar(40)
  externalEventId String                      @db.VarChar(191)
  /// The provider's own event-type/name string, kept only for
  /// observability — never part of the uniqueness invariant and never
  /// branched on for a security decision.
  eventType       String?                     @db.VarChar(100)
  status          ExternalWebhookEventStatus  @default(PROCESSING)
  processedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([provider, externalEventId])
  @@index([provider, status])
  @@map("external_webhook_events")
}

// ============================================================================
// Module 79 — Invoicing & Credit Notes
// ============================================================================

/// The professional's (or company's) explicit self-billing (facturación
/// por el destinatario) authorization — see
/// domain/repositories/self-billing-authorization-repository.ts's own doc
/// comment for the full rationale. At most one ACTIVE row per
/// professional/company at a time (enforced by a partial unique index in
/// this module's migration, not representable directly in this schema
/// language); history is preserved across grant/revoke/re-grant cycles.
model SelfBillingAuthorization {
  id                    String                         @id @default(uuid()) @db.Uuid
  professionalProfileId String?                        @db.Uuid
  companyProfileId      String?                        @db.Uuid
  status                SelfBillingAuthorizationStatus @default(ACTIVE)
  agreementVersion      String
  acceptedByUserId      String                         @db.Uuid
  acceptedAt            DateTime
  acceptanceIpAddress   String?
  acceptanceUserAgent   String?
  revokedAt             DateTime?
  revokedByUserId       String?                        @db.Uuid

  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  acceptedBy          User                 @relation("SelfBillingAuthorizationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  revokedBy           User?                @relation("SelfBillingAuthorizationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalProfileId, status])
  @@index([companyProfileId, status])
  @@map("self_billing_authorizations")
}

/// A professional's self-billed invoice to MaestroYa for a completed Job —
/// see domain/repositories/invoice-repository.ts's own doc comment for
/// the full field-by-field rationale and the immutability guarantee once
/// `status` reaches ISSUED.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String?       @unique
  type          InvoiceType   @default(PROFESSIONAL_SELF_BILLED)
  status        InvoiceStatus @default(DRAFT)

  jobId     String  @db.Uuid
  quoteId   String  @db.Uuid
  paymentId String? @db.Uuid

  professionalProfileId String? @db.Uuid
  companyProfileId      String? @db.Uuid
  customerId            String  @db.Uuid

  issuerLegalName    String
  issuerTaxId        String
  recipientLegalName String
  recipientTaxId     String?

  selfBillingAuthorizationId String @db.Uuid

  issueDate                  DateTime?
  invoiceDate                DateTime
  acceptedAt                 DateTime?
  acceptedByUserId           String?   @db.Uuid
  acceptanceAgreementVersion String?

  currency String @default("EUR")

  taxableBase            Decimal @db.Decimal(10, 2)
  vatRateBps             Int
  vatAmount              Decimal @db.Decimal(10, 2)
  commissionBase         Decimal @db.Decimal(10, 2)
  commissionRateBps      Int
  commissionAmount       Decimal @db.Decimal(10, 2)
  irpfWithholdingRateBps Int     @default(0)
  irpfWithholdingAmount  Decimal @default(0) @db.Decimal(10, 2)
  totalAmount            Decimal @db.Decimal(10, 2)

  /// Tamper-evidence checksum only — see domain/services/invoice-document.ts's
  /// own doc comment. Never a legal electronic signature.
  documentHash String?
  version      Int     @default(1)

  cancelledAt        DateTime?
  cancelledByUserId  String?   @db.Uuid
  cancellationReason String?

  job                      Job                      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  quote                    Quote                    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  payment                  Payment?                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  professionalProfile      ProfessionalProfile?     @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile           CompanyProfile?          @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  customer                 CustomerProfile          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  selfBillingAuthorization SelfBillingAuthorization @relation(fields: [selfBillingAuthorizationId], references: [id], onDelete: Restrict)
  acceptedBy               User?                    @relation("InvoiceAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  cancelledBy              User?                    @relation("InvoiceCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  lineItems   InvoiceLineItem[]
  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([professionalProfileId, status])
  @@index([companyProfileId, status])
  @@index([status])
  @@map("invoices")
}

/// Immutable financial-snapshot line items making up an Invoice's total —
/// same "stored, not computed live" reasoning as QuoteItem's own doc
/// comment, doubly so here since an Invoice must never re-derive its
/// figures from a (possibly since-changed) Quote once created.
model InvoiceLineItem {
  id          String                  @id @default(uuid()) @db.Uuid
  invoiceId   String                  @db.Uuid
  description String
  quantity    Decimal                 @db.Decimal(10, 2)
  unitPrice   Decimal                 @db.Decimal(10, 2)
  amount      Decimal                 @db.Decimal(10, 2)
  sortOrder   Int                     @default(0)
  category    InvoiceLineItemCategory @default(LABOR)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A financial correction document referencing an already-ISSUED Invoice —
/// see domain/repositories/credit-note-repository.ts's own doc comment.
/// Never mutates the original Invoice row.
model CreditNote {
  id               String           @id @default(uuid()) @db.Uuid
  creditNoteNumber String?          @unique
  status           CreditNoteStatus @default(DRAFT)

  originalInvoiceId     String  @db.Uuid
  professionalProfileId String? @db.Uuid
  companyProfileId      String? @db.Uuid

  reason         String  @db.Text
  /// Idempotency key supplied by the caller — unique per original
  /// invoice's correction request, the DB-level backstop for
  /// CreditNoteRepository.createOrGetExisting.
  idempotencyKey String  @unique

  issueDate DateTime?
  currency  String    @default("EUR")

  reversedTaxableBase           Decimal @db.Decimal(10, 2)
  reversedVatRateBps            Int
  reversedVatAmount             Decimal @db.Decimal(10, 2)
  reversedCommissionAmount      Decimal @db.Decimal(10, 2)
  reversedIrpfWithholdingAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount                   Decimal @db.Decimal(10, 2)

  documentHash String?

  cancelledAt       DateTime?
  cancelledByUserId String?   @db.Uuid

  originalInvoice     Invoice              @relation(fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  companyProfile      CompanyProfile?      @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  cancelledBy         User?                @relation("CreditNoteCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  lineItems CreditNoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originalInvoiceId])
  @@index([professionalProfileId])
  @@index([companyProfileId])
  @@map("credit_notes")
}

model CreditNoteLineItem {
  id           String  @id @default(uuid()) @db.Uuid
  creditNoteId String  @db.Uuid
  description  String
  amount       Decimal @db.Decimal(10, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([creditNoteId])
  @@map("credit_note_line_items")
}

/// Module 79 — Invoicing & Credit Notes: the concurrency-safe, per-year
/// counter `PrismaInvoiceNumberAllocator` atomically increments to
/// produce sequential invoice/credit-note numbers — see
/// domain/repositories/invoice-repository.ts's `InvoiceNumberAllocator`
/// port for why numbering is never derived from a timestamp or a row's
/// own database id. `series` distinguishes the Invoice series ("INV")
/// from the CreditNote series ("CN") so the two document types never
/// share (or collide on) the same sequence.
model InvoiceNumberCounter {
  series      String
  year        Int
  lastValue   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([series, year])
  @@map("invoice_number_counters")
}

// ============================================================================
// Module 80 — Financial Reconciliation & Observability
// ============================================================================
//
// Additive-only: no existing table, column, or business-logic code path is
// touched by this section. Every discrepancy-entity-reference column below
// (jobId/paymentId/invoiceId/payoutId/refundId/creditNoteId/entityId) is
// DELIBERATELY a plain scalar UUID column, never a Prisma relation with a
// foreign-key constraint to the referenced table. A foreign key would make
// it impossible to ever record the exact class of problem this module must
// be able to record — "this Payment references a nonexistent Job" — since
// the referenced row may legitimately not exist, or no longer exist in the
// state the discrepancy describes. This mirrors the precedent already set
// by Payout.paymentId (Module 76 — "deliberately not a Prisma relation
// object... read-only correlation for reconciliation/observability").

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationScope {
  FULL
  PAYMENT
  COMMISSION
  TAX
  INVOICE
  PAYOUT
  REFUND
  CREDIT_NOTE
  PROVIDER
}

enum DiscrepancyEntityType {
  PAYMENT
  COMMISSION
  TAX_BREAKDOWN
  INVOICE
  PAYOUT
  REFUND
  CREDIT_NOTE
  PROVIDER_EVENT
}

enum DiscrepancyCategory {
  PAYMENT_MISSING_JOB_OR_QUOTE
  PAYMENT_AMOUNT_MISMATCH
  PAYMENT_SUCCESSFUL_WITHOUT_RELATIONSHIP
  DUPLICATE_PAYMENT
  PAYMENT_CURRENCY_MISMATCH
  COMMISSION_RATE_MISMATCH
  COMMISSION_AMOUNT_MISMATCH
  COMMISSION_PROFESSIONAL_NET_MISMATCH
  COMMISSION_ALLOCATION_MISMATCH
  COMMISSION_LEDGER_INCONSISTENT
  TAX_TAXABLE_BASE_MISMATCH
  TAX_RATE_MISMATCH
  TAX_AMOUNT_MISMATCH
  TAX_PROFESSIONAL_SIDE_MISMATCH
  TAX_CUSTOMER_SIDE_MISMATCH
  TAX_IRPF_MISMATCH
  TAX_INVOICE_TOTAL_MISMATCH
  INVOICE_INVALID_JOB_REFERENCE
  INVOICE_WRONG_PARTY
  INVOICE_AMOUNT_INCONSISTENT_WITH_TAX_BREAKDOWN
  INVOICE_TAX_AMOUNT_INCONSISTENT
  INVOICE_COMMISSION_AMOUNT_INCONSISTENT
  INVOICE_ISSUED_WITHOUT_PREREQUISITES
  INVOICE_PAID_WITHOUT_PAYOUT
  DUPLICATE_ACTIVE_INVOICE
  INVOICE_NUMBERING_ANOMALY
  INVOICE_MISSING_IMMUTABLE_METADATA
  INVOICE_CREDIT_NOTE_INCONSISTENT
  PAYOUT_MISSING_ELIGIBLE_RELATIONSHIP
  PAYOUT_AMOUNT_MISMATCH
  PAYOUT_EXCEEDS_PAYABLE_AMOUNT
  PAYOUT_MISSING_REQUIRED_INVOICE_STATE
  DUPLICATE_PAYOUT
  PAYOUT_CURRENCY_MISMATCH
  PAYOUT_PROVIDER_REFERENCE_MISMATCH
  REFUND_EXCEEDS_REFUNDABLE_AMOUNT
  DUPLICATE_REFUND
  REFUND_AMOUNT_OR_CURRENCY_MISMATCH
  REFUND_MISSING_PAYMENT_RELATIONSHIP
  REFUND_STATE_INCONSISTENT_WITH_PAYMENT
  REFUND_CREDIT_NOTE_INCONSISTENT
  CREDIT_NOTE_INVALID_INVOICE_REFERENCE
  CREDIT_NOTE_WRONG_PARTY
  CREDIT_NOTE_EXCEEDS_REMAINING_CREDITABLE_AMOUNT
  CREDIT_NOTE_TAX_REVERSAL_MISMATCH
  CREDIT_NOTE_ISSUED_WITHOUT_REQUIRED_STATE
  DUPLICATE_CREDIT_NOTE
  CREDIT_NOTE_NUMBERING_ANOMALY
  CREDIT_NOTE_AMOUNT_OR_CURRENCY_MISMATCH
  PROVIDER_STATE_UNKNOWN
  PROVIDER_LOCAL_STATE_MISMATCH
  PROVIDER_AMOUNT_MISMATCH
}

enum DiscrepancySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum DiscrepancyResolutionStatus {
  OPEN
  RESOLVED
}

/// One execution of the Module 80 reconciliation engine. RUNNING ->
/// COMPLETED or RUNNING -> FAILED (see domain/services/reconciliation/lifecycle.ts) —
/// both terminal; a re-run always creates a new row, never resumes one.
model ReconciliationRun {
  id                String                  @id @default(uuid()) @db.Uuid
  scope             ReconciliationScope
  status            ReconciliationRunStatus @default(RUNNING)
  startedAt         DateTime
  completedAt       DateTime?
  durationMs        Int?
  recordsInspected  Int                     @default(0)
  discrepancyCount  Int                     @default(0)
  errorMessage      String?                 @db.Text
  /// Deterministic hash of (scope, since, limit) this run was executed
  /// with — see ReconciliationRunRecord's own doc comment. Not a
  /// uniqueness key: repeated runs with identical parameters are expected
  /// and always create a new row.
  parametersHash    String
  /// Null for a system/scheduled trigger — set only when a human admin
  /// explicitly started this run via the admin Server Action.
  triggeredByUserId String?                 @db.Uuid

  triggeredByUser User?                       @relation("ReconciliationRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: Restrict)
  discrepanciesDetected   ReconciliationDiscrepancy[] @relation("DiscrepancyDetectedByRun")
  discrepanciesLastSeen   ReconciliationDiscrepancy[] @relation("DiscrepancyLastSeenByRun")

  createdAt DateTime @default(now())

  @@index([status])
  @@index([startedAt])
  @@index([scope])
  @@map("reconciliation_runs")
}

/// One detected financial inconsistency. Never deleted, never overwritten
/// except for its resolutionStatus/resolution* fields (see
/// domain/repositories/reconciliation-repository.ts's own doc comment on
/// why history is preserved forever). `fingerprint` plus the partial
/// unique index below is what makes repeated reconciliation of the same
/// unchanged condition produce at most one OPEN row rather than unlimited
/// duplicates.
model ReconciliationDiscrepancy {
  id                 String                       @id @default(uuid()) @db.Uuid
  detectedByRunId    String                       @db.Uuid
  lastSeenRunId      String                       @db.Uuid
  entityType         DiscrepancyEntityType
  /// See this section's own top-of-file doc comment: deliberately a plain
  /// scalar, never a Prisma relation/foreign key.
  entityId           String?                      @db.Uuid
  jobId              String?                      @db.Uuid
  paymentId          String?                      @db.Uuid
  invoiceId          String?                      @db.Uuid
  payoutId           String?                      @db.Uuid
  refundId           String?                      @db.Uuid
  creditNoteId       String?                      @db.Uuid
  category           DiscrepancyCategory
  severity           DiscrepancySeverity
  expectedValue      Decimal?                     @db.Decimal(14, 2)
  actualValue        Decimal?                     @db.Decimal(14, 2)
  differenceValue    Decimal?                     @db.Decimal(14, 2)
  currency           String?
  explanation        String                       @db.Text
  fingerprint        String
  resolutionStatus   DiscrepancyResolutionStatus  @default(OPEN)
  resolvedByUserId   String?                      @db.Uuid
  resolvedAt         DateTime?
  resolutionReason   String?                      @db.Text
  resolutionMetadata Json?

  detectedByRun    ReconciliationRun @relation("DiscrepancyDetectedByRun", fields: [detectedByRunId], references: [id], onDelete: Restrict)
  lastSeenByRun    ReconciliationRun @relation("DiscrepancyLastSeenByRun", fields: [lastSeenRunId], references: [id], onDelete: Restrict)
  resolvedByUser   User?             @relation("ReconciliationDiscrepancyResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([detectedByRunId])
  @@index([severity])
  @@index([resolutionStatus])
  @@index([category])
  @@index([jobId])
  @@index([fingerprint])
  @@map("reconciliation_discrepancies")
}
