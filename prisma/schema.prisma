// ============================================================================
// MaestroYa — Marketplace Domain Model
// ============================================================================
//
// Scope note (Phase 1): this file defines the complete data model only.
// No API, UI, pages, or business logic live here or were added elsewhere.
// See docs/DOMAIN_MODEL.md for a full explanation of every model and the
// reasoning behind each cascading/indexing decision.
//
// Two reference tables — Language and Role — were added beyond the
// requested 26 models. They aren't marketplace entities in their own
// right, but the task explicitly asks to seed "Languages" and "Roles",
// and seeding requires a table to seed into. Flagged here for visibility.
//
// Four more reference tables — Country, Province, City, PlatformSetting —
// were added in a later pass for the same reason: a task explicitly asked
// to seed Spain/Valencia/Gandia and platform settings, and Address stores
// geography as free-text with nothing to seed a lookup table into. See
// docs/DOMAIN_MODEL.md for details on why these stay independent of
// Address rather than replacing its free-text fields.
//
// A handful of CHECK constraints (e.g. "exactly one of professionalProfileId
// / companyProfileId must be set") can't be expressed in Prisma's schema
// language and are instead added via raw SQL in the migration — see
// prisma/migrations/20260717000000_init_domain_model/migration.sql.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth.js (next-auth) required models
// https://authjs.dev/getting-started/adapters/prisma
//
// Field names/shapes are fixed by the adapter and must not change. The one
// modification made here is switching User/Account/Session ids from cuid()
// to uuid() so every primary key in the schema is a UUID, per Phase 1's
// requirements — Auth.js does not care which id-generation strategy is used.
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // --- Marketplace fields (added in Phase 1) ---
  phone            String?    @unique
  phoneVerifiedAt  DateTime?
  status           UserStatus @default(PENDING_VERIFICATION)
  /// Professional Onboarding: see SignupIntent's own doc comment. Null for
  /// every user who never went through the "Soy profesional" CTA (i.e.
  /// every user before this feature existed, and every ordinary customer
  /// signup) — absence carries no meaning beyond "not currently mid-way
  /// through professional onboarding."
  signupIntent     SignupIntent?
  preferredLanguageId String? @db.Uuid
  /// Module 29 — Internationalization: the user's chosen **interface**
  /// language, stored as a plain ISO 639-1 locale code ("es", "en", "uk",
  /// "cs", "de", "fr", "it", "pt", "ro", "pl").
  ///
  /// Deliberately a new code column rather than a reuse of the
  /// `preferredLanguageId` FK above. Those are two different concepts that
  /// happen to share a word:
  ///  - `preferredLanguageId` -> `Language` reference table: a *seeded
  ///    marketplace lookup* ("which languages does this person speak/prefer
  ///    to be contacted in"), rows of which are administrator-managed data
  ///    and may include languages the UI has no translations for at all
  ///    (e.g. "ca").
  ///  - `preferredLocale`: a *product/UI capability* — it may only ever
  ///    hold a code that the app actually ships translation files for (see
  ///    `SUPPORTED_LOCALES` in src/shared/i18n/locales.ts). Adding a new
  ///    interface language must be a "drop in translation files" change,
  ///    never "insert a row and hope the UI has messages for it".
  /// Coupling the two would make every new interface language depend on a
  /// data migration and would let an admin break the UI by deactivating a
  /// `Language` row. See docs/MODULE_29_INTERNATIONALIZATION.md §4.
  ///
  /// Null means "never chosen explicitly" — resolution then falls through
  /// to the cookie/`Accept-Language`/Spanish chain, it does NOT mean
  /// Spanish. Validation of the value lives at the application edge
  /// (`languagePreferenceSchema`), not in a Postgres enum, precisely so
  /// adding a locale stays code-only with no migration.
  preferredLocale  String?    @db.VarChar(10)
  timezone         String?
  notificationPreferences Json? @db.JsonB
  lastLoginAt      DateTime?
  deletedAt        DateTime? // soft delete — see docs/DOMAIN_MODEL.md "Why soft-delete users"

  // --- Authentication fields (added in Authentication module) ---
  // Nullable: users who only ever sign in via OAuth (Google/Apple/Facebook)
  // never get one. Never store or return this field outside the auth
  // module's own password-verification code path.
  passwordHash String?

  accounts Account[]
  sessions Session[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]

  preferredLanguage Language? @relation(fields: [preferredLanguageId], references: [id], onDelete: SetNull)
  roles             UserRole[]
  customerProfile     CustomerProfile?
  professionalProfile ProfessionalProfile?
  companyMemberships  CompanyMember[]
  addresses           Address[]

  ownedCompanies         CompanyProfile[]      @relation("CompanyOwner")
  /// Module 18 — Company Professional.
  reviewedCompanyVerifications CompanyVerification[] @relation("CompanyVerificationReviewer")
  companyInvitationsReceived   CompanyInvitation[]   @relation("CompanyInvitationInvitedUser")
  companyInvitationsSent       CompanyInvitation[]   @relation("CompanyInvitationInvitedBy")
  submittedQuotes        Quote[]               @relation("QuoteSubmittedBy")
  conversationMembers    ConversationMember[]
  sentMessages           Message[]             @relation("MessageSender")
  writtenReviews         Review[]              @relation("ReviewAuthor")
  payments               Payment[]             @relation("PaymentPayer")
  requestedRefunds       Refund[]              @relation("RefundRequestedBy")
  notifications          Notification[]
  reviewedDocuments      VerificationDocument[] @relation("DocumentReviewer")
  /// Professional Verification module (Module 17): verification cases this
  /// admin has reviewed. SetNull on delete — losing the reviewer pointer is
  /// acceptable; the case and its outcome remain intact.
  reviewedVerifications  ProfessionalVerification[] @relation("VerificationReviewer")
  raisedDisputes         Dispute[]              @relation("DisputeRaisedBy")
  resolvedDisputes       Dispute[]              @relation("DisputeResolvedBy")
  closedDisputes         Dispute[]              @relation("DisputeClosedBy")
  assignedDisputes       Dispute[]              @relation("DisputeAssignedAdmin")
  submittedDisputeEvidence DisputeEvidence[]    @relation("EvidenceSubmittedBy")
  disputeMessages        DisputeMessage[]       @relation("DisputeMessageAuthor")
  /// Module 21 — Disputes & Support: general (non-order-tied) support tickets.
  openedSupportTickets    SupportTicket[]        @relation("SupportTicketOpenedBy")
  assignedSupportTickets  SupportTicket[]        @relation("SupportTicketAssignedAdmin")
  /// Module 22 — Commission & Financial: financial adjustments (refunds,
  /// commission reversals, etc.) requested by this user — almost always an
  /// admin/support agent acting on a resolved Dispute, occasionally a
  /// customer-initiated refund request. See FinancialAdjustment's doc
  /// comment.
  requestedFinancialAdjustments FinancialAdjustment[] @relation("FinancialAdjustmentRequestedBy")
  /// Module 68 — Dispute Resolution & Financial Protection: Dispute
  /// resolution decisions this admin/support user has made. See
  /// DisputeResolutionDecision's own doc comment.
  disputeResolutionDecisions DisputeResolutionDecision[] @relation("DisputeResolutionDecisionDecidedBy")
  resolvedSupportTickets  SupportTicket[]        @relation("SupportTicketResolvedBy")
  closedSupportTickets    SupportTicket[]        @relation("SupportTicketClosedBy")
  auditLogEntries        AuditLog[]
  /// Module 24 — Security & Anti-Abuse.
  securityEvents             SecurityEvent[]
  accountRestrictions        AccountRestriction[]   @relation("AccountRestrictionSubject")
  accountRestrictionsCreated AccountRestriction[]   @relation("AccountRestrictionCreatedBy")
  proposedAppointments   Appointment[]          @relation("AppointmentProposedBy")
  cancelledAppointments  Appointment[]          @relation("AppointmentCancelledBy")
  /// Order / Job Lifecycle module (Module 11).
  startedJobs            Job[]                  @relation("JobStartedBy")
  completedJobs          Job[]                  @relation("JobCompletedBy")
  cancelledJobs          Job[]                  @relation("JobCancelledBy")
  /// Module 66 — Job Completion & Payment Release Protection.
  confirmedJobCompletions JobCompletionConfirmation[] @relation("JobCompletionConfirmedBy")
  /// Module 38 — GDPR Compliance.
  consents               Consent[]
  /// Module 60 — Referral & Marketing Attribution Platform: at most one row
  /// per user in practice (a user registers exactly once, through exactly
  /// one visitorId) but modeled as a list — see
  /// MarketingAttribution.userId's own doc comment for why it is not a
  /// unique constraint.
  marketingAttributions   MarketingAttribution[]
  /// Module 60 — Referral & Marketing Attribution Platform: referral codes
  /// this user owns (e.g. a professional's own shareable link).
  referralCodes           ReferralCode[]
  /// Module 61 — Affiliate & Partner System: the affiliate/partner account
  /// this user operates, if any. One per user (Partner.userId unique) —
  /// see Partner's own doc comment.
  partner                 Partner?
  /// Module 65 — Trust & Integrity System.
  trustProfile                    TrustProfile?
  fraudSignalsAsSubject            FraudSignal[]            @relation("FraudSignalSubject")
  fraudSignalsResolved             FraudSignal[]            @relation("FraudSignalResolvedBy")
  offPlatformDetectionEvents       OffPlatformDetectionEvent[]
  trustAutomatedActionsAsSubject   TrustAutomatedAction[]   @relation("TrustAutomatedActionSubject")
  trustAutomatedActionsCreated     TrustAutomatedAction[]   @relation("TrustAutomatedActionCreatedBy")
  trustAutomatedActionsReversed    TrustAutomatedAction[]   @relation("TrustAutomatedActionReversedBy")
  manualReviewCasesAsSubject       ManualReviewCase[]       @relation("ManualReviewCaseSubject")
  manualReviewCasesAssigned        ManualReviewCase[]       @relation("ManualReviewCaseAssignedAdmin")
  manualReviewCasesResolved        ManualReviewCase[]       @relation("ManualReviewCaseResolvedBy")
  trustAppealsAsSubject            TrustAppeal[]            @relation("TrustAppealSubject")
  trustAppealsReviewed             TrustAppeal[]            @relation("TrustAppealReviewedBy")
  /// Module 79 — Invoicing & Credit Notes.
  selfBillingAuthorizationsAccepted SelfBillingAuthorization[] @relation("SelfBillingAuthorizationAcceptedBy")
  selfBillingAuthorizationsRevoked  SelfBillingAuthorization[] @relation("SelfBillingAuthorizationRevokedBy")
  invoicesAccepted                  Invoice[]                  @relation("InvoiceAcceptedBy")
  invoicesCancelled                 Invoice[]                  @relation("InvoiceCancelledBy")
  creditNotesCancelled              CreditNote[]               @relation("CreditNoteCancelledBy")
  /// Module 80 — Financial Reconciliation & Observability: reconciliation
  /// runs a human admin explicitly triggered (null on the row itself for a
  /// system/scheduled trigger — see ReconciliationRun.triggeredByUserId's
  /// own doc comment) and discrepancies this admin has manually resolved.
  reconciliationRunsTriggered       ReconciliationRun[]         @relation("ReconciliationRunTriggeredBy")
  reconciliationDiscrepanciesResolved ReconciliationDiscrepancy[] @relation("ReconciliationDiscrepancyResolvedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([preferredLanguageId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Authentication module — Credentials auth support
//
// VerificationToken above is Auth.js-managed (reserved for its own
// Email/magic-link provider if one is ever added). The three models below
// are deliberately separate and owned entirely by this module's own code,
// to avoid two different systems writing to the same table for different
// purposes.
// ============================================================================

/// Single-use token proving control of an email address at registration
/// time (Credentials/email-password signup, distinct from Auth.js's own
/// magic-link VerificationToken). Consumed (deleted) on successful
/// verification; expired rows are safe to garbage-collect periodically.
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique /// SHA-256 of the token — the raw token is never stored
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Single-use token for the forgot-password → reset-password flow. Same
/// hash-at-rest treatment as EmailVerificationToken.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Long-lived, revocable refresh token backing the "Remember me" /
/// refresh-token requirement. Auth.js's own session JWT (short-lived,
/// stateless) stays the primary web-session mechanism — this table exists
/// so that mechanism can be *revoked* server-side (sign out everywhere,
/// ban a user mid-session) despite JWTs otherwise being stateless, and so
/// non-browser clients (a future mobile app) have a real refresh flow.
/// Rotated on every use (old row deleted, new row issued) so a stolen,
/// already-used refresh token is detectably invalid.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// Reference / lookup data (seeded — not marketplace entities per se)
// ============================================================================

/// Platform/interface language reference data — used for the platform
/// language picker (see User.preferredLanguageId), NOT a professional
/// "languages I speak with customers" feature. ProfessionalProfile
/// deliberately has no relation to this model; see migration
/// 20260807000000_remove_professional_languages, which dropped the
/// short-lived `_ProfessionalLanguages` join table.
model Language {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique /// ISO 639-1, e.g. "es", "en", "ca"
  name       String  /// English name, e.g. "Spanish"
  nativeName String  /// Native name, e.g. "Español"
  isActive   Boolean @default(true)
  /// Platform-language display priority (lower sorts first) — the picker
  /// orders by this, then by `name`, rather than relying on alphabetical
  /// order alone. See migration 20260806000000_add_language_sort_order.
  sortOrder  Int     @default(0)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

/// Platform roles for RBAC. Kept as seeded data (not a hardcoded enum) so
/// new roles (e.g. "SUPPORT") can be added without a schema migration.
/// A user can hold multiple roles at once — e.g. someone can be both a
/// CUSTOMER and a PROFESSIONAL on the same account.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique /// e.g. "CUSTOMER", "PROFESSIONAL", "ADMIN"
  name        String
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Join table: which roles a user holds.
model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Normalized geographic reference data (country → province → city), used
/// for structured location pickers/filtering. Deliberately independent of
/// Address, which keeps storing free-text city/province/country — linking
/// Address to this hierarchy (e.g. replacing Address.city with a FK) is a
/// bigger structural change than "add a seed script" and is left for a
/// deliberate future decision rather than made silently here.
model Country {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique /// ISO 3166-1 alpha-2, e.g. "ES"
  name String

  provinces Province[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model Province {
  id        String @id @default(uuid()) @db.Uuid
  countryId String @db.Uuid
  name      String

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([countryId])
  @@map("provinces")
}

model City {
  id         String @id @default(uuid()) @db.Uuid
  provinceId String @db.Uuid
  name       String

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

/// Platform-wide configuration as key/value rows (commission rate,
/// support email, feature flags, etc.) rather than hardcoded constants —
/// lets ops change these without a deploy. `value` is Json so a single
/// table can hold settings of any shape (a number, a string, an object).
model PlatformSetting {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  value       Json    @db.JsonB
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ============================================================================
// Enums
// ============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

/// Professional Onboarding: a *temporary routing flag* only, set when a
/// user registers via the "Soy profesional" CTA. It never replaces or
/// duplicates the role system (see UserRole/Role) — it exists purely so
/// middleware.ts can resume an interrupted onboarding (redirect back to
/// /dashboard/professional/onboarding on next login) for a user who
/// intended to become a professional but hasn't been granted the
/// PROVIDER role yet. Cleared (set back to null) the moment onboarding
/// completes; from then on PROVIDER role membership alone is the single
/// source of truth for "is this user a professional."
enum SignupIntent {
  CUSTOMER
  PROFESSIONAL
}

/// Module 18 — Company Professional: MANAGER added between ADMIN and MEMBER
/// (additive enum value — safe, non-breaking for existing OWNER/ADMIN/MEMBER
/// rows). See docs/MODULE_18_COMPANY_PROFESSIONAL.md for the full permission
/// matrix.
enum CompanyMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

/// Module 18 — Company Professional: lifecycle status of a CompanyProfile,
/// mirroring ProfessionalStatus's role for individual professionals but with
/// an explicit PENDING state (a company profile can exist — created by its
/// owner — before it is accepting public work, e.g. while verification is
/// still in progress).
enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Module 18 — Company Professional: lifecycle of a single company
/// membership invitation. Deliberately its own enum, not reusing
/// CompanyMemberRole or CompanyStatus — an invitation has its own state
/// machine (see company-invitation-rules.ts).
enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Module 18 — Company Professional: state machine for a CompanyVerification
/// case. Intentionally a separate enum from ProfessionalVerificationStatus
/// (Module 17) even though the values are identical — avoids coupling a
/// company-verification schema change to renaming/touching Module 17's enum,
/// which stays untouched. See company-verification-rules.ts (mirrors
/// professional-verification-rules.ts's transition map).
enum VerificationCaseStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  EXPIRED
}

enum AddressType {
  HOME
  WORK
  BILLING
  SERVICE_LOCATION
  OTHER
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Professional Module: lifecycle status of an individual professional's
/// profile, distinct from `verificationStatus` (trust/identity checks).
enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Professional Module: identity/trust verification state. Admin-only
/// future workflow moves a profile through PENDING -> VERIFIED/REJECTED;
/// professionals themselves can never set this field.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

/// Order / Job Lifecycle module (Module 11) note: IN_PROGRESS/COMPLETED
/// remain reserved-but-unused here by deliberate decision — Module 11
/// introduces Job.status as the authoritative execution-lifecycle field
/// instead (see JobStatus and domain/services/job-state.ts). This module
/// never writes ServiceRequest to IN_PROGRESS or COMPLETED as a side effect
/// of any Job/Appointment transition.
enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum QuoteStatus {
  PENDING
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

/// Module 22 — Commission & Financial: see QuoteItem.category's doc
/// comment. Deliberately just these two values — the business model only
/// ever needs "is this commissionable labor or excluded materials," not a
/// richer taxonomy (call-out fees, etc. are treated as LABOR unless a
/// future product decision says otherwise).
enum QuoteItemCategory {
  LABOR
  MATERIALS
}

/// Module 63 — Materials Procurement Workflow: who is responsible for
/// sourcing the materials a Quote's work requires. PROFESSIONAL_SUPPLIED
/// (the default) is today's existing behavior — the professional's quoted
/// price already includes materials, exactly as before this module
/// existed. CUSTOMER_PURCHASED is additive: the professional instead
/// hands the customer a required shopping list (QuoteMaterial rows) that
/// the customer must buy themselves and then explicitly confirm before
/// the booked work can begin — see Quote.materialsConfirmedAt and
/// domain/services/materials-procurement-rules.ts for the gating rule
/// (enforced by StartJobUseCase, never assumed client-side).
enum MaterialsStrategy {
  PROFESSIONAL_SUPPLIED
  CUSTOMER_PURCHASED
}

enum AppointmentStatus {
  /// Booking/Appointments module (MVP): the Appointment row created the
  /// moment a Quote is accepted, before any actual scheduling has happened.
  /// Added because the original enum had no state representing "exists but
  /// unscheduled" — see prisma/migrations/20260723000000_add_appointment_pending_schedule
  /// for why this was unavoidable. A future scheduling module transitions
  /// this to SCHEDULED once `scheduledStart` is actually set.
  PENDING_SCHEDULE
  /// Deprecated/unused: superseded by the PROPOSED/CONFIRMED distinction
  /// added by the Booking & Scheduling module (Module 10) — see
  /// domain/services/appointment-state.ts. Kept on the enum only for
  /// backward compatibility with the value already shipped in the initial
  /// migration; no code writes it.
  SCHEDULED
  /// Booking & Scheduling module (Module 10): one party (customer or
  /// professional) has put forward a `[proposedStart, proposedEnd)` window
  /// that the other party has not yet confirmed. See
  /// domain/services/appointment-state.ts for the full transition rules.
  PROPOSED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

/// Booking & Scheduling module (Module 10): typed reason recorded when an
/// Appointment is cancelled — kept as a closed enum (rather than free text)
/// so a future Payment/Stripe Connect module can automate refund-eligibility
/// decisions from it without parsing prose. `cancellationNote` on
/// Appointment still carries optional free-text detail alongside this.
enum AppointmentCancellationReason {
  CUSTOMER_REQUEST
  PROFESSIONAL_UNAVAILABLE
  SCHEDULING_CONFLICT
  OTHER
}

/// Order / Job Lifecycle module (Module 11): the execution-lifecycle status
/// of a Job. Deliberately smaller than the full hypothetical lifecycle
/// (no separate SCHEDULED — that remains Appointment's job, see Module 10)
/// and deliberately does not reuse ServiceRequestStatus.IN_PROGRESS/
/// COMPLETED (see ServiceRequestStatus's own doc note) — Job.status is the
/// single authoritative execution-lifecycle field. COMPLETED and CANCELLED
/// are terminal; see domain/services/job-state.ts for the full transition
/// rules.
enum JobStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Order / Job Lifecycle module (Module 11): typed reason recorded when a
/// Job is cancelled — same "closed enum, not free text" pattern as
/// AppointmentCancellationReason, so a future Payment/Stripe Connect module
/// can automate refund-eligibility decisions from it without parsing
/// prose. `cancellationNote` on Job still carries optional free-text detail
/// alongside this.
enum JobCancellationReason {
  CUSTOMER_REQUEST
  PROFESSIONAL_UNABLE_TO_COMPLETE
  SERVICE_REQUEST_ISSUE
  OTHER
}

/// Module 66 — Job Completion & Payment Release Protection: tracks the
/// customer-confirmation step that sits between "professional marked the
/// Job COMPLETED" and "payment may actually be released to the
/// professional." Deliberately a separate table rather than new JobStatus
/// values (see JobCompletionConfirmation's own doc comment) — Job.status
/// keeps meaning exactly what it means today (the *work* lifecycle);
/// this table is the *money-release* lifecycle layered on top of it.
///
///   WAITING_FOR_CUSTOMER   — professional completed; clock is running.
